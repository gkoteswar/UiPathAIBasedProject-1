.&#xD;&#xA;        Dim supportedExtensions As String() = {&#xD;&#xA;            &quot;.pdf&quot;,&#xD;&#xA;            &quot;.png&quot;,&#xD;&#xA;            &quot;.jpg&quot;,&#xD;&#xA;            &quot;.jpeg&quot;,&#xD;&#xA;            &quot;.tif&quot;,&#xD;&#xA;            &quot;.tiff&quot;,&#xD;&#xA;            &quot;.bmp&quot;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        '===================================================&#xD;&#xA;        ' FIRST PASS - DISCOVERY&#xD;&#xA;        '&#xD;&#xA;        ' Check what exists for DocumentNumber and for&#xD;&#xA;        ' InvoiceNumber (BL flag is tracked per key).&#xD;&#xA;        '===================================================&#xD;&#xA;&#xD;&#xA;        For Each attachment As Microsoft.Office.Interop.Outlook.Attachment _&#xD;&#xA;            In mainMailItem.Attachments&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;            Try&#xD;&#xA;&#xD;&#xA;                Dim originalFileName As String =&#xD;&#xA;                    If(&#xD;&#xA;                        attachment.FileName,&#xD;&#xA;                        &quot;&quot;&#xD;&#xA;                    )&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;                If String.IsNullOrWhiteSpace(originalFileName) Then&#xD;&#xA;&#xD;&#xA;                    Continue For&#xD;&#xA;&#xD;&#xA;                End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;                ' ONLY SUPPORTED ATTACHMENT TYPES&#xD;&#xA;                Dim extension As String =&#xD;&#xA;                    System.IO.Path.GetExtension(&#xD;&#xA;                        originalFileName&#xD;&#xA;                    ).ToLowerInvariant()&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;                If System.Array.IndexOf(supportedExtensions, extension) &lt; 0 Then&#xD;&#xA;&#xD;&#xA;                     Continue For&#xD;&#xA;&#xD;&#xA;                 End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;                Dim fileNameForComparison As String =&#xD;&#xA;                    originalFileName.ToLowerInvariant()&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;                Dim has