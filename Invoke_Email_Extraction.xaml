 System.IO.Directory.Exists(OutputFolder) Then&#xD;&#xA;&#xD;&#xA;        System.IO.Directory.CreateDirectory(&#xD;&#xA;            OutputFolder&#xD;&#xA;        )&#xD;&#xA;&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    '=======================================================&#xD;&#xA;    ' 3. VALIDATE SEARCH KEYS&#xD;&#xA;    '&#xD;&#xA;    ' At least ONE of DocumentNumber / InvoiceNumber&#xD;&#xA;    ' must be supplied.&#xD;&#xA;    '=======================================================&#xD;&#xA;&#xD;&#xA;    Dim documentKey As String =&#xD;&#xA;        If(DocumentNumber, &quot;&quot;).Trim().ToLowerInvariant()&#xD;&#xA;&#xD;&#xA;    Dim invoiceKey As String =&#xD;&#xA;        If(InvoiceNumber, &quot;&quot;).Trim().ToLowerInvariant()&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    If documentKey = &quot;&quot; AndAlso invoiceKey = &quot;&quot; Then&#xD;&#xA;&#xD;&#xA;        Throw New Exception(&#xD;&#xA;            &quot;Both DocumentNumber and InvoiceNumber are empty.&quot;&#xD;&#xA;        )&#xD;&#xA;&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    '=======================================================&#xD;&#xA;    ' 4. WAIT FOR MSG FILE&#xD;&#xA;    '=======================================================&#xD;&#xA;&#xD;&#xA;    If Not WaitForFileReady(msgPath) Then&#xD;&#xA;&#xD;&#xA;        Throw New Exception(&#xD;&#xA;            &quot;MSG file is locked or unavailable after &quot; &amp;&#xD;&#xA;            &quot;20 seconds.&quot; &amp;&#xD;&#xA;            Environment.NewLine &amp;&#xD;&#xA;            &quot;Path: &quot; &amp;&#xD;&#xA;            msgPath&#xD;&#xA;        )&#xD;&#xA;&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    '=======================================================&#xD;&#xA;    ' 5. START OUTLOOK&#xD;&#xA;    '=======================================================&#xD;&#xA;&#xD;&#xA;    outlookApp =&#xD;&#xA;        New Microsoft.Office.Interop.Outlook.Application()&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    '=======================================================&#xD;&#xA;    ' 6. MAIN MAIL ITEM&#xD;&#xA;    '=======================================================&#xD;&#xA;&#xD;&#xA;    Dim mainMailItem As Microsoft.Office.Interop.Outlook.MailItem = Nothing&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    Try&#xD;&#xA;&#xD;&#xA;        mainMailItem =&#xD;&#xA;            CType(&#xD;&#xA;                outlookApp.Session.OpenSharedItem(&#xD;&#xA;                    msgPath&#xD;&#xA;                ),&#xD;&#xA;                Microsoft.Office.Interop.Outlook.MailItem&#xD;&#xA;            )&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        If mainMailItem Is Nothing Then&#xD;&#xA;&#xD;&#xA;            Throw New Exception(&#xD;&#xA;                &quot;Outlook could not open the MSG as a MailItem.&quot; &amp;&#xD;&#xA;                Environment.NewLine &amp;&#xD;&#xA;                &quot;Path: &quot; &amp;&#xD;&#xA;                msgPath&#xD;&#xA;            )&#xD;&#xA;&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        '===================================================&#xD;&#xA;        ' 7. EXTRACT SUBJECT&#xD;&#xA;        '===================================================&#xD;&#xA;&#xD;&#xA;        Try&#xD;&#xA;&#xD;&#xA;            Subject =&#xD;&#xA;                If(&#xD;&#xA;                    mainMailItem.Subject,&#xD;&#xA;                    &quot;&quot;&#xD;&#xA;                )&#xD;&#xA;&#xD;&#xA;        Catch&#xD;&#xA;&#xD;&#xA;            Subject = &quot;&quot;&#xD;&#xA;&#xD;&#xA;        End Try&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;        '===================================================&#xD;&#xA;        ' 8. EXTRACT BODY&#xD;&#xA;        '===================================================&#xD;&#xA;&#xD;&#xA;        Try&#xD;&#xA;&#xD;&#xA;            Body =&#xD;&#xA;                If(&#xD;&#xA;                    mainMailItem.Body,&#xD;&#xA;                    &quot;&quot;&#xD;&#xA;                )&#xD;&#xA;&#xD;&#xA;        Catch&#xD;&#xA;&#xD;&#xA;            Body = &quot;&quot;&#xD;&#xA;&#xD;&