                          <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Email Extraction: Only matched .pdfs with Document Number, if already present in attachments folder don't download." Code="'===========================================================&#xA;' OUTLOOK MSG PDF EXTRACTION - UIPATH INVOKE CODE&#xA;'&#xA;' FEATURES:&#xA;'   - Extract Subject&#xA;'   - Extract Body&#xA;'   - Extract Sender Name&#xA;'   - Extract REAL SMTP Sender Email&#xA;'   - Handles Exchange / X500 sender addresses&#xA;'   - ONLY processes PDF attachments from MAIN MSG&#xA;'   - Does NOT download/process nested MSG attachments&#xA;'&#xA;' PDF SELECTION LOGIC:&#xA;'&#xA;'   Condition 1:&#xA;'       PDF filename contains DocumentNumber&#xA;'&#xA;'   Condition 2:&#xA;'       PDF filename contains DocumentNumber&#xA;'       AND contains BL keyword&#xA;'&#xA;'   If BL PDF exists:&#xA;'       Download BOTH:&#xA;'           1. DocumentNumber PDF&#xA;'           2. DocumentNumber + BL PDF&#xA;'&#xA;'   If BL PDF does NOT exist:&#xA;'       Download only:&#xA;'           DocumentNumber PDF&#xA;'&#xA;'   Existing files:&#xA;'       If same filename already exists in OutputFolder,&#xA;'       DO NOT download again.&#xA;'&#xA;'   Only PDF attachments are considered.&#xA;'&#xA;'   Option Strict On compatible.&#xA;'===========================================================&#xA;&#xA;&#xA;'===========================================================&#xA;' OUTLOOK APPLICATION&#xA;'===========================================================&#xA;&#xA;Dim outlookApp As Microsoft.Office.Interop.Outlook.Application = Nothing&#xA;&#xA;&#xA;'===========================================================&#xA;' INITIALIZE OUTPUT VARIABLES&#xA;'===========================================================&#xA;&#xA;Subject = &quot;&quot;&#xA;Body = &quot;&quot;&#xA;SenderName = &quot;&quot;&#xA;SenderEmail = &quot;&quot;&#xA;&#xA;&#xA;'===========================================================&#xA;' FUNCTION: MakeSafeFileName&#xA;'&#xA;' Removes invalid Windows filename characters&#xA;'===========================================================&#xA;&#xA;Dim MakeSafeFileName As Func(Of String, String) = _&#xA;    Function(inputName As String) As String&#xA;&#xA;        If String.IsNullOrWhiteSpace(inputName) Then&#xA;&#xA;            Return &quot;Unnamed&quot;&#xA;&#xA;        End If&#xA;&#xA;&#xA;        Dim result As String =&#xA;            inputName.Trim()&#xA;&#xA;&#xA;        For Each invalidChar As Char In&#xA;            System.IO.Path.GetInvalidFileNameChars()&#xA;&#xA;            result =&#xA;                result.Replace(&#xA;                    invalidChar.ToString(),&#xA;                    &quot;_&quot;&#xA;                )&#xA;&#xA;        Next&#xA;&#xA;&#xA;        result =&#xA;            result.TrimEnd(&#xA;                &quot; &quot;c,&#xA;                &quot;.&quot;c&#xA;            )&#xA;&#xA;&#xA;        If String.IsNullOrWhiteSpace(result) Then&#xA;&#xA;            result = &quot;Unnamed&quot;&#xA;&#xA;        End If&#xA;&#xA;&#xA;        Return result&#xA;&#xA;    End Function&#xA;&#xA;&#xA;'===========================================================&#xA;' FUNCTION: WaitForFileReady&#xA;'&#xA;' Waits until the MSG file can be opened exclusively&#xA;'===========================================================&#xA;&#xA;Dim WaitForFileReady As Func(Of String, Boolean) = _&#xA;    Function(filePath As String) As Boolean&#xA;&#xA;        Dim attempts As Integer = 0&#xA;&#xA;        Dim maxAttempts As Integer = 20&#xA;&#xA;&#xA;        While attempts &lt; maxAttempts&#xA;&#xA;            Try&#xA;&#xA;                Using fs As New System.IO.FileStream(&#xA;                    filePath,&#xA;                    System.IO.FileMode.Open,&#xA;                    System.IO.FileAccess.Read,&#xA;                    System.IO.FileShare.None)&#xA;&#xA;                    Return True&#xA;&#xA;                End Using&#xA;&#xA;&#xA;            Catch&#xA;&#xA;                attempts += 1&#xA;&#xA;                System.Threading.Thread.Sleep(1000)&#xA;&#xA;            End Try&#xA;&#xA;        End While&#xA;&#xA;&#xA;        Return False&#xA;&#xA;    End Function&#xA;&#xA;&#xA;'===========================================================&#xA;' FUNCTION: GetSenderSmtpAddress&#xA;'&#xA;' Handles Exchange/X500 sender addresses.&#xA;'===========================================================&#xA;&#xA;Dim GetSenderSmtpAddress As Func(Of Microsoft.Office.Interop.Outlook.MailItem, String) = _&#xA;    Function(mail As Microsoft.Office.Interop.Outlook.MailItem) As String&#xA;&#xA;        If mail Is Nothing Then&#xA;&#xA;            Return &quot;&quot;&#xA;&#xA;        End If&#xA;&#xA;&#xA;        Const PR_SMTP_ADDRESS As String =&#xA;            &quot;http://schemas.microsoft.com/mapi/proptag/0x39FE001E&quot;&#xA;&#xA;&#xA;        Dim senderEntry As Microsoft.Office.Interop.Outlook.AddressEntry = Nothing&#xA;&#xA;        Dim propertyAccessor As Microsoft.Office.Interop.Outlook.PropertyAccessor = Nothing&#xA;&#xA;        Dim exchangeUser As Microsoft.Office.Interop.Outlook.ExchangeUser = Nothing&#xA;&#xA;&#xA;        Try&#xA;&#xA;            senderEntry =&#xA;                mail.Sender&#xA;&#xA;&#xA;            If senderEntry Is Nothing Then&#xA;&#xA;                Return If(&#xA;                    mail.SenderEmailAddress,&#xA;                    &quot;&quot;&#xA;                )&#xA;&#xA;            End If&#xA;&#xA;&#xA;            '================================================&#xA;            ' METHOD 1&#xA;            ' MAPI SMTP ADDRESS&#xA;            '================================================&#xA;&#xA;            Try&#xA;&#xA;                propertyAccessor =&#xA;                    senderEntry.PropertyAccessor&#xA;&#xA;&#xA;                If propertyAccessor IsNot Nothing Then&#xA;&#xA;                    Dim smtpObject As Object =&#xA;                        propertyAccessor.GetProperty(&#xA;                            PR_SMTP_ADDRESS&#xA;                        )&#xA;&#xA;&#xA;                    If smtpObject IsNot Nothing Then&#xA;&#xA;                        Dim smtpAddress As String =&#xA;                            Convert.ToString(&#xA;                                smtpObject&#xA;                            )&#xA;&#xA;&#xA;                        If Not String.IsNullOrWhiteSpace(&#xA;                            smtpAddress) Then&#xA;&#xA;                            If smtpAddress.Contains(&quot;@&quot;) Then&#xA;&#xA;                                Return smtpAddress.Trim()&#xA;&#xA;                            End If&#xA;&#xA;                        End If&#xA;&#xA;                    End If&#xA;&#xA;                End If&#xA;&#xA;&#xA;            Catch&#xA;&#xA;                ' Continue&#xA;&#xA;            End Try&#xA;&#xA;&#xA;            '================================================&#xA;            ' METHOD 2&#xA;            ' EXCHANGE USER&#xA;            '================================================&#xA;&#xA;            Try&#xA;&#xA;                Dim addressType As String =&#xA;                    If(&#xA;                        senderEntry.Type,&#xA;                        &quot;&quot;&#xA;                    )&#xA;&#xA;&#xA;                If String.Equals(&#xA;                    addressType,&#xA;                    &quot;EX&quot;,&#xA;                    StringComparison.OrdinalIgnoreCase) Then&#xA;&#xA;&#xA;                    exchangeUser =&#xA;                        senderEntry.GetExchangeUser()&#xA;&#xA;&#xA;                    If exchangeUser IsNot Nothing Then&#xA;&#xA;                        Dim smtpAddress As String =&#xA;                            If(&#xA;                                exchangeUser.PrimarySmtpAddress,&#xA;                                &quot;&quot;&#xA;                            )&#xA;&#xA;&#xA;                        If Not String.IsNullOrWhiteSpace(&#xA;                            smtpAddress) Then&#xA;&#xA;                            If smtpAddress.Contains(&quot;@&quot;) Then&#xA;&#xA;                                Return smtpAddress.Trim()&#xA;&#xA;                            End If&#xA;&#xA;                        End If&#xA;&#xA;                    End If&#xA;&#xA;                End If&#xA;&#xA;&#xA;            Catch&#xA;&#xA;                ' Continue&#xA;&#xA;            End Try&#xA;&#xA;&#xA;            '================================================&#xA;            ' METHOD 3&#xA;            ' ADDRESS ENTRY ADDRESS&#xA;            '================================================&#xA;&#xA;            Try&#xA;&#xA;                Dim senderAddress As String =&#xA;                    If(&#xA;                        senderEntry.Address,&#xA;                        &quot;&quot;&#xA;                    )&#xA;&#xA;&#xA;                If Not String.IsNullOrWhiteSpace(&#xA;                    senderAddress) Then&#xA;&#xA;                    If senderAddress.Contains(&quot;@&quot;) Then&#xA;&#xA;                        Return senderAddress.Trim()&#xA;&#xA;                    End If&#xA;&#xA;                End If&#xA;&#xA;&#xA;            Catch&#xA;&#xA;                ' Continue&#xA;&#xA;            End Try&#xA;&#xA;&#xA;            '================================================&#xA;            ' METHOD 4&#xA;            ' ORIGINAL SENDER EMAIL&#xA;            '================================================&#xA;&#xA;            Return If(&#xA;                mail.SenderEmailAddress,&#xA;                &quot;&quot;&#xA;            )&#xA;&#xA;&#xA;        Catch&#xA;&#xA;            Try&#xA;&#xA;                Return If(&#xA;                    mail.SenderEmailAddress,&#xA;                    &quot;&quot;&#xA;                )&#xA;&#xA;            Catch&#xA;&#xA;                Return &quot;&quot;&#xA;&#xA;            End Try&#xA;&#xA;        Finally&#xA;&#xA;            If exchangeUser IsNot Nothing Then&#xA;&#xA;                Try&#xA;&#xA;                    System.Runtime.InteropServices.Marshal.FinalReleaseComObject(&#xA;                        exchangeUser&#xA;                    )&#xA;&#xA;                Catch&#xA;&#xA;                End Try&#xA;&#xA;                exchangeUser = Nothing&#xA;&#xA;            End If&#xA;&#xA;&#xA;            If propertyAccessor IsNot Nothing Then&#xA;&#xA;                Try&#xA;&#xA;                    System.Runtime.InteropServices.Marshal.FinalReleaseComObject(&#xA;                        propertyAccessor&#xA;                    )&#xA;&#xA;                Catch&#xA;&#xA;                End Try&#xA;&#xA;                propertyAccessor = Nothing&#xA;&#xA;            End If&#xA;&#xA;&#xA;            If senderEntry IsNot Nothing Then&#xA;&#xA;                Try&#xA;&#xA;                    System.Runtime.InteropServices.Marshal.FinalReleaseComObject(&#xA;                        senderEntry&#xA;                    )&#xA;&#xA;                Catch&#xA;&#xA;                End Try&#xA;&#xA;                senderEntry = Nothing&#xA;&#xA;            End If&#xA;&#xA;        End Try&#xA;&#xA;    End Function&#xA;&#xA;&#xA;'===========================================================&#xA;' MAIN CODE&#xA;'===========================================================&#xA;&#xA;Try&#xA;&#xA;    '=======================================================&#xA;    ' 1. VALIDATE MSG PATH&#xA;    '=======================================================&#xA;&#xA;    If String.IsNullOrWhiteSpace(msgPath) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;msgPath is empty.&quot;&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    If Not System.IO.File.Exists(msgPath) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;MSG file does not exist:&quot; &amp;&#xA;            Environment.NewLine &amp;&#xA;            msgPath&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    If Not msgPath.ToLowerInvariant().EndsWith(&quot;.msg&quot;) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;The supplied file is not an MSG file:&quot; &amp;&#xA;            Environment.NewLine &amp;&#xA;            msgPath&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    '=======================================================&#xA;    ' 2. VALIDATE OUTPUT FOLDER&#xA;    '=======================================================&#xA;&#xA;    If String.IsNullOrWhiteSpace(&#xA;        OutputFolder) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;OutputFolder is empty.&quot;&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    If Not System.IO.Directory.Exists(&#xA;        OutputFolder) Then&#xA;&#xA;        System.IO.Directory.CreateDirectory(&#xA;            OutputFolder&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    '=======================================================&#xA;    ' 3. VALIDATE DOCUMENT NUMBER&#xA;    '=======================================================&#xA;&#xA;    If String.IsNullOrWhiteSpace(&#xA;        DocumentNumber) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;DocumentNumber is empty.&quot;&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    '=======================================================&#xA;    ' 4. WAIT FOR MSG FILE&#xA;    '=======================================================&#xA;&#xA;    If Not WaitForFileReady(&#xA;        msgPath) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;MSG file is locked or unavailable after &quot; &amp;&#xA;            &quot;20 seconds.&quot; &amp;&#xA;            Environment.NewLine &amp;&#xA;            &quot;Path: &quot; &amp;&#xA;            msgPath&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    '=======================================================&#xA;    ' 5. START OUTLOOK&#xA;    '=======================================================&#xA;&#xA;    outlookApp =&#xA;        New Microsoft.Office.Interop.Outlook.Application()&#xA;&#xA;&#xA;    '=======================================================&#xA;    ' 6. MAIN MAIL ITEM&#xA;    '=======================================================&#xA;&#xA;    Dim mainMailItem As Microsoft.Office.Interop.Outlook.MailItem = Nothing&#xA;&#xA;&#xA;    Try&#xA;&#xA;        '===================================================&#xA;        ' OPEN MAIN MSG&#xA;        '===================================================&#xA;&#xA;        mainMailItem =&#xA;            CType(&#xA;                outlookApp.Session.OpenSharedItem(&#xA;                    msgPath&#xA;                ),&#xA;                Microsoft.Office.Interop.Outlook.MailItem&#xA;            )&#xA;&#xA;&#xA;        If mainMailItem Is Nothing Then&#xA;&#xA;            Throw New Exception(&#xA;                &quot;Outlook could not open the MSG as a MailItem.&quot; &amp;&#xA;                Environment.NewLine &amp;&#xA;                &quot;Path: &quot; &amp;&#xA;                msgPath&#xA;            )&#xA;&#xA;        End If&#xA;&#xA;&#xA;        '===================================================&#xA;        ' 7. EXTRACT SUBJECT&#xA;        '===================================================&#xA;&#xA;        Try&#xA;&#xA;            Subject =&#xA;                If(&#xA;                    mainMailItem.Subject,&#xA;                    &quot;&quot;&#xA;                )&#xA;&#xA;        Catch&#xA;&#xA;            Subject = &quot;&quot;&#xA;&#xA;        End Try&#xA;&#xA;&#xA;        '===================================================&#xA;        ' 8. EXTRACT BODY&#xA;        '===================================================&#xA;&#xA;        Try&#xA;&#xA;            Body =&#xA;                If(&#xA;                    mainMailItem.Body,&#xA;                    &quot;&quot;&#xA;                )&#xA;&#xA;        Catch&#xA;&#xA;            Body = &quot;&quot;&#xA;&#xA;        End Try&#xA;&#xA;&#xA;        '===================================================&#xA;        ' 9. EXTRACT SENDER NAME&#xA;        '===================================================&#xA;&#xA;        Try&#xA;&#xA;            SenderName =&#xA;                If(&#xA;                    mainMailItem.SenderName,&#xA;                    &quot;&quot;&#xA;                )&#xA;&#xA;        Catch&#xA;&#xA;            SenderName = &quot;&quot;&#xA;&#xA;        End Try&#xA;&#xA;&#xA;        '===================================================&#xA;        ' 10. EXTRACT SMTP SENDER EMAIL&#xA;        '===================================================&#xA;&#xA;        Try&#xA;&#xA;            SenderEmail =&#xA;                GetSenderSmtpAddress(&#xA;                    mainMailItem&#xA;                )&#xA;&#xA;        Catch&#xA;&#xA;            Try&#xA;&#xA;                SenderEmail =&#xA;                    If(&#xA;                        mainMailItem.SenderEmailAddress,&#xA;                        &quot;&quot;&#xA;                    )&#xA;&#xA;            Catch&#xA;&#xA;                SenderEmail = &quot;&quot;&#xA;&#xA;            End Try&#xA;&#xA;        End Try&#xA;&#xA;&#xA;        '===================================================&#xA;        ' 11. PDF ATTACHMENT EXTRACTION&#xA;        '&#xA;        ' IMPORTANT:&#xA;        '&#xA;        ' NO nested MSG processing.&#xA;        '&#xA;        ' Only PDF attachments from MAIN MSG are checked.&#xA;        '===================================================&#xA;&#xA;        Dim documentNumberText As String =&#xA;            DocumentNumber.Trim()&#xA;&#xA;&#xA;        Dim foundDocumentPdf As Boolean = False&#xA;&#xA;        Dim foundBLPdf As Boolean = False&#xA;&#xA;&#xA;        '===================================================&#xA;        ' FIRST PASS&#xA;        '&#xA;        ' Determine which PDFs exist.&#xA;        '&#xA;        ' This is important because if a BL PDF exists,&#xA;        ' both PDFs must be downloaded.&#xA;        '===================================================&#xA;&#xA;        For Each attachment As Microsoft.Office.Interop.Outlook.Attachment _&#xA;            In mainMailItem.Attachments&#xA;&#xA;&#xA;            Try&#xA;&#xA;                Dim originalFileName As String =&#xA;                    If(&#xA;                        attachment.FileName,&#xA;                        &quot;&quot;&#xA;                    )&#xA;&#xA;&#xA;                If String.IsNullOrWhiteSpace(&#xA;                    originalFileName) Then&#xA;&#xA;                    Continue For&#xA;&#xA;                End If&#xA;&#xA;&#xA;                '--------------------------------------------&#xA;                ' ONLY PDF FILES&#xA;                '--------------------------------------------&#xA;&#xA;                Dim extension As String =&#xA;                    System.IO.Path.GetExtension(&#xA;                        originalFileName&#xA;                    ).ToLowerInvariant()&#xA;&#xA;&#xA;                If extension &lt;&gt; &quot;.pdf&quot; Then&#xA;&#xA;                    Continue For&#xA;&#xA;                End If&#xA;&#xA;&#xA;                '--------------------------------------------&#xA;                ' Filename comparison&#xA;                '&#xA;                ' Case-insensitive&#xA;                '--------------------------------------------&#xA;&#xA;                Dim fileNameForComparison As String =&#xA;                    originalFileName.ToLowerInvariant()&#xA;&#xA;&#xA;                Dim documentNumberForComparison As String =&#xA;                    documentNumberText.ToLowerInvariant()&#xA;&#xA;&#xA;                '--------------------------------------------&#xA;                ' Condition 1:&#xA;                '&#xA;                ' PDF contains DocumentNumber&#xA;                '--------------------------------------------&#xA;&#xA;                If fileNameForComparison.Contains(&#xA;                    documentNumberForComparison) Then&#xA;&#xA;&#xA;                    foundDocumentPdf = True&#xA;&#xA;&#xA;                    '----------------------------------------&#xA;                    ' Condition 2:&#xA;                    '&#xA;                    ' DocumentNumber + BL&#xA;                    '----------------------------------------&#xA;&#xA;                    If fileNameForComparison.Contains(&quot;bl&quot;) Then&#xA;&#xA;                        foundBLPdf = True&#xA;&#xA;                    End If&#xA;&#xA;                End If&#xA;&#xA;&#xA;            Catch&#xA;&#xA;                ' Continue checking next attachment&#xA;&#xA;            End Try&#xA;&#xA;&#xA;        Next&#xA;&#xA;&#xA;        '===================================================&#xA;        ' SECOND PASS&#xA;        '&#xA;        ' Download only the required PDFs.&#xA;        '===================================================&#xA;&#xA;        For Each attachment As Microsoft.Office.Interop.Outlook.Attachment _&#xA;            In mainMailItem.Attachments&#xA;&#xA;&#xA;            Dim attachmentPath As String = &quot;&quot;&#xA;&#xA;&#xA;            Try&#xA;&#xA;                Dim originalFileName As String =&#xA;                    If(&#xA;                        attachment.FileName,&#xA;                        &quot;&quot;&#xA;                    )&#xA;&#xA;&#xA;                If String.IsNullOrWhiteSpace(&#xA;                    originalFileName) Then&#xA;&#xA;                    Continue For&#xA;&#xA;                End If&#xA;&#xA;&#xA;                '--------------------------------------------&#xA;                ' ONLY PDF&#xA;                '--------------------------------------------&#xA;&#xA;                Dim extension As String =&#xA;                    System.IO.Path.GetExtension(&#xA;                        originalFileName&#xA;                    ).ToLowerInvariant()&#xA;&#xA;&#xA;                If extension &lt;&gt; &quot;.pdf&quot; Then&#xA;&#xA;                    Continue For&#xA;&#xA;                End If&#xA;&#xA;&#xA;                '--------------------------------------------&#xA;                ' Filename comparison&#xA;                '--------------------------------------------&#xA;&#xA;                Dim fileNameForComparison As String =&#xA;                    originalFileName.ToLowerInvariant()&#xA;&#xA;&#xA;                Dim documentNumberForComparison As String =&#xA;                    documentNumberText.ToLowerInvariant()&#xA;&#xA;&#xA;                '--------------------------------------------&#xA;                ' Must contain DocumentNumber&#xA;                '--------------------------------------------&#xA;&#xA;                If Not fileNameForComparison.Contains(&#xA;                    documentNumberForComparison) Then&#xA;&#xA;                    Continue For&#xA;&#xA;                End If&#xA;&#xA;&#xA;                Dim isBLPdf As Boolean =&#xA;                    fileNameForComparison.Contains(&quot;bl&quot;)&#xA;&#xA;&#xA;                '================================================&#xA;                ' DOWNLOAD RULE&#xA;                '&#xA;                ' If BL exists:&#xA;                '&#xA;                '   Download DocumentNumber PDF&#xA;                '   Download DocumentNumber + BL PDF&#xA;                '&#xA;                ' If BL does not exist:&#xA;                '&#xA;                '   Download only DocumentNumber PDF&#xA;                '================================================&#xA;&#xA;                Dim shouldDownload As Boolean = False&#xA;&#xA;&#xA;                If foundBLPdf Then&#xA;&#xA;                    '--------------------------------------------&#xA;                    ' BL exists.&#xA;                    '&#xA;                    ' Download both required documents.&#xA;                    '--------------------------------------------&#xA;&#xA;                    shouldDownload = True&#xA;&#xA;                Else&#xA;&#xA;                    '--------------------------------------------&#xA;                    ' No BL exists.&#xA;                    '&#xA;                    ' Download only normal DocumentNumber PDF.&#xA;                    '&#xA;                    ' Since foundBLPdf = False, this attachment&#xA;                    ' cannot be considered a BL document.&#xA;                    '--------------------------------------------&#xA;&#xA;                    If Not isBLPdf Then&#xA;&#xA;                        shouldDownload = True&#xA;&#xA;                    End If&#xA;&#xA;                End If&#xA;&#xA;&#xA;                If Not shouldDownload Then&#xA;&#xA;                    Continue For&#xA;&#xA;                End If&#xA;&#xA;&#xA;                '================================================&#xA;                ' SAFE OUTPUT FILE NAME&#xA;                '================================================&#xA;&#xA;                Dim safeFileName As String =&#xA;                    MakeSafeFileName(&#xA;                        originalFileName&#xA;                    )&#xA;&#xA;&#xA;                attachmentPath =&#xA;                    System.IO.Path.Combine(&#xA;                        OutputFolder,&#xA;                        safeFileName&#xA;                    )&#xA;&#xA;&#xA;                '================================================&#xA;                ' EXISTING FILE CHECK&#xA;                '&#xA;                ' If same filename already exists:&#xA;                '&#xA;                ' DO NOT download again.&#xA;                '&#xA;                ' No replacement.&#xA;                '================================================&#xA;&#xA;                If System.IO.File.Exists(&#xA;                    attachmentPath) Then&#xA;&#xA;&#xA;                    System.Diagnostics.Debug.WriteLine(&#xA;                        &quot;PDF already exists. Skipping download:&quot; &amp;&#xA;                        Environment.NewLine &amp;&#xA;                        attachmentPath&#xA;                    )&#xA;&#xA;&#xA;                    Continue For&#xA;&#xA;                End If&#xA;&#xA;&#xA;                '================================================&#xA;                ' SAVE PDF&#xA;                '================================================&#xA;&#xA;                attachment.SaveAsFile(&#xA;                    attachmentPath&#xA;                )&#xA;&#xA;&#xA;                '================================================&#xA;                ' VERIFY FILE WAS CREATED&#xA;                '================================================&#xA;&#xA;                If Not System.IO.File.Exists(&#xA;                    attachmentPath) Then&#xA;&#xA;                    Throw New Exception(&#xA;                        &quot;PDF attachment was not created:&quot; &amp;&#xA;                        Environment.NewLine &amp;&#xA;                        attachmentPath&#xA;                    )&#xA;&#xA;                End If&#xA;&#xA;&#xA;                System.Diagnostics.Debug.WriteLine(&#xA;                    &quot;PDF downloaded successfully:&quot; &amp;&#xA;                    Environment.NewLine &amp;&#xA;                    attachmentPath&#xA;                )&#xA;&#xA;&#xA;            Catch attachmentEx As Exception&#xA;&#xA;                '--------------------------------------------&#xA;                ' Continue with next attachment&#xA;                '--------------------------------------------&#xA;&#xA;                System.Diagnostics.Debug.WriteLine(&#xA;                    &quot;PDF attachment extraction failed.&quot; &amp;&#xA;                    Environment.NewLine &amp;&#xA;                    &quot;Attachment: &quot; &amp;&#xA;                    attachmentPath &amp;&#xA;                    Environment.NewLine &amp;&#xA;                    &quot;Error: &quot; &amp;&#xA;                    attachmentEx.ToString()&#xA;                )&#xA;&#xA;            End Try&#xA;&#xA;&#xA;        Next&#xA;&#xA;&#xA;    Finally&#xA;&#xA;        '===================================================&#xA;        ' CLOSE MAIN MSG&#xA;        '===================================================&#xA;&#xA;        If mainMailItem IsNot Nothing Then&#xA;&#xA;            Try&#xA;&#xA;                mainMailItem.Close(&#xA;                    Microsoft.Office.Interop.Outlook.OlInspectorClose.olDiscard&#xA;                )&#xA;&#xA;            Catch&#xA;&#xA;            End Try&#xA;&#xA;        End If&#xA;&#xA;&#xA;        '===================================================&#xA;        ' RELEASE MAIN MAIL ITEM&#xA;        '===================================================&#xA;&#xA;        If mainMailItem IsNot Nothing Then&#xA;&#xA;            Try&#xA;&#xA;                System.Runtime.InteropServices.Marshal.FinalReleaseComObject(&#xA;                    mainMailItem&#xA;                )&#xA;&#xA;            Catch&#xA;&#xA;            End Try&#xA;&#xA;            mainMailItem = Nothing&#xA;&#xA;        End If&#xA;&#xA;    End Try&#xA;&#xA;&#xA;Catch ex As Exception&#xA;&#xA;    '=======================================================&#xA;    ' MAIN ERROR&#xA;    '=======================================================&#xA;&#xA;    Throw New Exception(&#xA;        &quot;Outlook Email Extraction failed.&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        Environment.NewLine &amp;&#xA;        &quot;MSG Path:&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        msgPath &amp;&#xA;        Environment.NewLine &amp;&#xA;        Environment.NewLine &amp;&#xA;        &quot;Output Folder:&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        OutputFolder &amp;&#xA;        Environment.NewLine &amp;&#xA;        Environment.NewLine &amp;&#xA;        &quot;Document Number:&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        DocumentNumber &amp;&#xA;        Environment.NewLine &amp;&#xA;        Environment.NewLine &amp;&#xA;        &quot;Error:&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        ex.ToString(),&#xA;        ex&#xA;    )&#xA;&#xA;&#xA;Finally&#xA;&#xA;    '=======================================================&#xA;    ' RELEASE OUTLOOK APPLICATION&#xA;    '=======================================================&#xA;&#xA;    If outlookApp IsNot Nothing Then&#xA;&#xA;        Try&#xA;&#xA;            System.Runtime.InteropServices.Marshal.FinalReleaseComObject(&#xA;                outlookApp&#xA;            )&#xA;&#xA;        Catch&#xA;&#xA;        End Try&#xA;&#xA;        outlookApp = Nothing&#xA;&#xA;    End If&#xA;&#xA;End Try&#xA;" DisplayName="Invoke Code - Email Extraction Latest" sap:VirtualizedContainerService.HintSize="416,258" sap2010:WorkflowViewState.IdRef="InvokeCode_11">
                            <ui:InvokeCode.Arguments>
                              <InArgument x:TypeArguments="x:String" x:Key="msgPath">[in_MsgPath]</InArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="OutputFolder">[in_AttachmentsFolderPath]</InArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="Subject">[out_Subject]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="Body">[out_Body]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="SenderName">[out_SenderName]</OutArgument>
                              <OutArgument x:TypeArguments="x:String" x:Key="SenderEmail">[out_SenderEmail]</OutArgument>
                              <InArgument x:TypeArguments="x:String" x:Key="DocumentNumber">[in_DocumentNumber]</InArgument>
                            </ui:InvokeCode.Arguments>
                            <sap:WorkflowViewStateService.ViewState>
                              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                                <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
                              </scg:Dictionary>
                            </sap:WorkflowViewStateService.ViewState>
                          </ui:InvokeCode>
                          <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Email Extraction: Only matched .pdfs with Document Number, if already present in attachments folder don't download. (LATEST)" Code="'===========================================================&#xA;' OUTLOOK MSG PDF EXTRACTION - UIPATH INVOKE CODE&#xA;'&#xA;' ARGUMENTS&#xA;'   In  : msgPath        (String)&#xA;'   In  : OutputFolder   (String)&#xA;'   In  : DocumentNumber (String)&#xA;'   In  : InvoiceNumber  (String)   &lt;-- NEW (fallback search key)&#xA;'   Out : Subject        (String)&#xA;'   Out : Body           (String)&#xA;'   Out : SenderName     (String)&#xA;'   Out : SenderEmail    (String)&#xA;'   Out : PdfDownloaded  (Boolean)  &lt;-- NEW (status)&#xA;'&#xA;' PDF SELECTION LOGIC&#xA;'   1. Look for PDFs whose filename contains DocumentNumber.&#xA;'   2. If NONE found, look for PDFs whose filename contains&#xA;'      InvoiceNumber.&#xA;'   3. The key that matched (Document or Invoice) is then used&#xA;'      for the BL rule:&#xA;'         - BL PDF exists  -&gt; download BOTH (normal + BL)&#xA;'         - No BL PDF      -&gt; download only the normal PDF&#xA;'   4. If the same filename already exists in OutputFolder,&#xA;'      it is NOT downloaded again.&#xA;'&#xA;' PdfDownloaded&#xA;'   True  = at least one matching PDF was saved now,&#xA;'           or already exists in OutputFolder&#xA;'   False = no matching PDF found / nothing saved&#xA;'&#xA;' Only PDF attachments of the MAIN MSG are processed.&#xA;' Option Strict On compatible.&#xA;'===========================================================&#xA;&#xA;&#xA;Dim outlookApp As Microsoft.Office.Interop.Outlook.Application = Nothing&#xA;&#xA;Subject = &quot;&quot;&#xA;Body = &quot;&quot;&#xA;SenderName = &quot;&quot;&#xA;SenderEmail = &quot;&quot;&#xA;PdfDownloaded = False&#xA;&#xA;&#xA;'===========================================================&#xA;' FUNCTION: MakeSafeFileName&#xA;'===========================================================&#xA;&#xA;Dim MakeSafeFileName As Func(Of String, String) = _&#xA;    Function(inputName As String) As String&#xA;&#xA;        If String.IsNullOrWhiteSpace(inputName) Then&#xA;&#xA;            Return &quot;Unnamed&quot;&#xA;&#xA;        End If&#xA;&#xA;&#xA;        Dim result As String =&#xA;            inputName.Trim()&#xA;&#xA;&#xA;        For Each invalidChar As Char In&#xA;            System.IO.Path.GetInvalidFileNameChars()&#xA;&#xA;            result =&#xA;                result.Replace(&#xA;                    invalidChar.ToString(),&#xA;                    &quot;_&quot;&#xA;                )&#xA;&#xA;        Next&#xA;&#xA;&#xA;        result =&#xA;            result.TrimEnd(&#xA;                &quot; &quot;c,&#xA;                &quot;.&quot;c&#xA;            )&#xA;&#xA;&#xA;        If String.IsNullOrWhiteSpace(result) Then&#xA;&#xA;            result = &quot;Unnamed&quot;&#xA;&#xA;        End If&#xA;&#xA;&#xA;        Return result&#xA;&#xA;    End Function&#xA;&#xA;&#xA;'===========================================================&#xA;' FUNCTION: WaitForFileReady&#xA;'===========================================================&#xA;&#xA;Dim WaitForFileReady As Func(Of String, Boolean) = _&#xA;    Function(filePath As String) As Boolean&#xA;&#xA;        Dim attempts As Integer = 0&#xA;&#xA;        Dim maxAttempts As Integer = 20&#xA;&#xA;&#xA;        While attempts &lt; maxAttempts&#xA;&#xA;            Try&#xA;&#xA;                Using fs As New System.IO.FileStream(&#xA;                    filePath,&#xA;                    System.IO.FileMode.Open,&#xA;                    System.IO.FileAccess.Read,&#xA;                    System.IO.FileShare.None)&#xA;&#xA;                    Return True&#xA;&#xA;                End Using&#xA;&#xA;&#xA;            Catch&#xA;&#xA;                attempts += 1&#xA;&#xA;                System.Threading.Thread.Sleep(1000)&#xA;&#xA;            End Try&#xA;&#xA;        End While&#xA;&#xA;&#xA;        Return False&#xA;&#xA;    End Function&#xA;&#xA;&#xA;'===========================================================&#xA;' FUNCTION: GetSenderSmtpAddress&#xA;'===========================================================&#xA;&#xA;Dim GetSenderSmtpAddress As Func(Of Microsoft.Office.Interop.Outlook.MailItem, String) = _&#xA;    Function(mail As Microsoft.Office.Interop.Outlook.MailItem) As String&#xA;&#xA;        If mail Is Nothing Then&#xA;&#xA;            Return &quot;&quot;&#xA;&#xA;        End If&#xA;&#xA;&#xA;        Const PR_SMTP_ADDRESS As String =&#xA;            &quot;http://schemas.microsoft.com/mapi/proptag/0x39FE001E&quot;&#xA;&#xA;&#xA;        Dim senderEntry As Microsoft.Office.Interop.Outlook.AddressEntry = Nothing&#xA;&#xA;        Dim propertyAccessor As Microsoft.Office.Interop.Outlook.PropertyAccessor = Nothing&#xA;&#xA;        Dim exchangeUser As Microsoft.Office.Interop.Outlook.ExchangeUser = Nothing&#xA;&#xA;&#xA;        Try&#xA;&#xA;            senderEntry =&#xA;                mail.Sender&#xA;&#xA;&#xA;            If senderEntry Is Nothing Then&#xA;&#xA;                Return If(&#xA;                    mail.SenderEmailAddress,&#xA;                    &quot;&quot;&#xA;                )&#xA;&#xA;            End If&#xA;&#xA;&#xA;            ' METHOD 1 - MAPI SMTP ADDRESS&#xA;            Try&#xA;&#xA;                propertyAccessor =&#xA;                    senderEntry.PropertyAccessor&#xA;&#xA;&#xA;                If propertyAccessor IsNot Nothing Then&#xA;&#xA;                    Dim smtpObject As Object =&#xA;                        propertyAccessor.GetProperty(&#xA;                            PR_SMTP_ADDRESS&#xA;                        )&#xA;&#xA;&#xA;                    If smtpObject IsNot Nothing Then&#xA;&#xA;                        Dim smtpAddress As String =&#xA;                            Convert.ToString(&#xA;                                smtpObject&#xA;                            )&#xA;&#xA;&#xA;                        If Not String.IsNullOrWhiteSpace(&#xA;                            smtpAddress) Then&#xA;&#xA;                            If smtpAddress.Contains(&quot;@&quot;) Then&#xA;&#xA;                                Return smtpAddress.Trim()&#xA;&#xA;                            End If&#xA;&#xA;                        End If&#xA;&#xA;                    End If&#xA;&#xA;                End If&#xA;&#xA;&#xA;            Catch&#xA;&#xA;                ' Continue&#xA;&#xA;            End Try&#xA;&#xA;&#xA;            ' METHOD 2 - EXCHANGE USER&#xA;            Try&#xA;&#xA;                Dim addressType As String =&#xA;                    If(&#xA;                        senderEntry.Type,&#xA;                        &quot;&quot;&#xA;                    )&#xA;&#xA;&#xA;                If String.Equals(&#xA;                    addressType,&#xA;                    &quot;EX&quot;,&#xA;                    StringComparison.OrdinalIgnoreCase) Then&#xA;&#xA;&#xA;                    exchangeUser =&#xA;                        senderEntry.GetExchangeUser()&#xA;&#xA;&#xA;                    If exchangeUser IsNot Nothing Then&#xA;&#xA;                        Dim smtpAddress As String =&#xA;                            If(&#xA;                                exchangeUser.PrimarySmtpAddress,&#xA;                                &quot;&quot;&#xA;                            )&#xA;&#xA;&#xA;                        If Not String.IsNullOrWhiteSpace(&#xA;                            smtpAddress) Then&#xA;&#xA;                            If smtpAddress.Contains(&quot;@&quot;) Then&#xA;&#xA;                                Return smtpAddress.Trim()&#xA;&#xA;                            End If&#xA;&#xA;                        End If&#xA;&#xA;                    End If&#xA;&#xA;                End If&#xA;&#xA;&#xA;            Catch&#xA;&#xA;                ' Continue&#xA;&#xA;            End Try&#xA;&#xA;&#xA;            ' METHOD 3 - ADDRESS ENTRY ADDRESS&#xA;            Try&#xA;&#xA;                Dim senderAddress As String =&#xA;                    If(&#xA;                        senderEntry.Address,&#xA;                        &quot;&quot;&#xA;                    )&#xA;&#xA;&#xA;                If Not String.IsNullOrWhiteSpace(&#xA;                    senderAddress) Then&#xA;&#xA;                    If senderAddress.Contains(&quot;@&quot;) Then&#xA;&#xA;                        Return senderAddress.Trim()&#xA;&#xA;                    End If&#xA;&#xA;                End If&#xA;&#xA;&#xA;            Catch&#xA;&#xA;                ' Continue&#xA;&#xA;            End Try&#xA;&#xA;&#xA;            ' METHOD 4 - ORIGINAL SENDER EMAIL&#xA;            Return If(&#xA;                mail.SenderEmailAddress,&#xA;                &quot;&quot;&#xA;            )&#xA;&#xA;&#xA;        Catch&#xA;&#xA;            Try&#xA;&#xA;                Return If(&#xA;                    mail.SenderEmailAddress,&#xA;                    &quot;&quot;&#xA;                )&#xA;&#xA;            Catch&#xA;&#xA;                Return &quot;&quot;&#xA;&#xA;            End Try&#xA;&#xA;        Finally&#xA;&#xA;            If exchangeUser IsNot Nothing Then&#xA;&#xA;                Try&#xA;&#xA;                    System.Runtime.InteropServices.Marshal.FinalReleaseComObject(&#xA;                        exchangeUser&#xA;                    )&#xA;&#xA;                Catch&#xA;&#xA;                End Try&#xA;&#xA;                exchangeUser = Nothing&#xA;&#xA;            End If&#xA;&#xA;&#xA;            If propertyAccessor IsNot Nothing Then&#xA;&#xA;                Try&#xA;&#xA;                    System.Runtime.InteropServices.Marshal.FinalReleaseComObject(&#xA;                        propertyAccessor&#xA;                    )&#xA;&#xA;                Catch&#xA;&#xA;                End Try&#xA;&#xA;                propertyAccessor = Nothing&#xA;&#xA;            End If&#xA;&#xA;&#xA;            If senderEntry IsNot Nothing Then&#xA;&#xA;                Try&#xA;&#xA;                    System.Runtime.InteropServices.Marshal.FinalReleaseComObject(&#xA;                        senderEntry&#xA;                    )&#xA;&#xA;                Catch&#xA;&#xA;                End Try&#xA;&#xA;                senderEntry = Nothing&#xA;&#xA;            End If&#xA;&#xA;        End Try&#xA;&#xA;    End Function&#xA;&#xA;&#xA;'===========================================================&#xA;' MAIN CODE&#xA;'===========================================================&#xA;&#xA;Try&#xA;&#xA;    '=======================================================&#xA;    ' 1. VALIDATE MSG PATH&#xA;    '=======================================================&#xA;&#xA;    If String.IsNullOrWhiteSpace(msgPath) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;msgPath is empty.&quot;&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    If Not System.IO.File.Exists(msgPath) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;MSG file does not exist:&quot; &amp;&#xA;            Environment.NewLine &amp;&#xA;            msgPath&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    If Not msgPath.ToLowerInvariant().EndsWith(&quot;.msg&quot;) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;The supplied file is not an MSG file:&quot; &amp;&#xA;            Environment.NewLine &amp;&#xA;            msgPath&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    '=======================================================&#xA;    ' 2. VALIDATE OUTPUT FOLDER&#xA;    '=======================================================&#xA;&#xA;    If String.IsNullOrWhiteSpace(OutputFolder) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;OutputFolder is empty.&quot;&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    If Not System.IO.Directory.Exists(OutputFolder) Then&#xA;&#xA;        System.IO.Directory.CreateDirectory(&#xA;            OutputFolder&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    '=======================================================&#xA;    ' 3. VALIDATE SEARCH KEYS&#xA;    '&#xA;    ' At least ONE of DocumentNumber / InvoiceNumber&#xA;    ' must be supplied.&#xA;    '=======================================================&#xA;&#xA;    Dim documentKey As String =&#xA;        If(DocumentNumber, &quot;&quot;).Trim().ToLowerInvariant()&#xA;&#xA;    Dim invoiceKey As String =&#xA;        If(InvoiceNumber, &quot;&quot;).Trim().ToLowerInvariant()&#xA;&#xA;&#xA;    If documentKey = &quot;&quot; AndAlso invoiceKey = &quot;&quot; Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;Both DocumentNumber and InvoiceNumber are empty.&quot;&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    '=======================================================&#xA;    ' 4. WAIT FOR MSG FILE&#xA;    '=======================================================&#xA;&#xA;    If Not WaitForFileReady(msgPath) Then&#xA;&#xA;        Throw New Exception(&#xA;            &quot;MSG file is locked or unavailable after &quot; &amp;&#xA;            &quot;20 seconds.&quot; &amp;&#xA;            Environment.NewLine &amp;&#xA;            &quot;Path: &quot; &amp;&#xA;            msgPath&#xA;        )&#xA;&#xA;    End If&#xA;&#xA;&#xA;    '=======================================================&#xA;    ' 5. START OUTLOOK&#xA;    '=======================================================&#xA;&#xA;    outlookApp =&#xA;        New Microsoft.Office.Interop.Outlook.Application()&#xA;&#xA;&#xA;    '=======================================================&#xA;    ' 6. MAIN MAIL ITEM&#xA;    '=======================================================&#xA;&#xA;    Dim mainMailItem As Microsoft.Office.Interop.Outlook.MailItem = Nothing&#xA;&#xA;&#xA;    Try&#xA;&#xA;        mainMailItem =&#xA;            CType(&#xA;                outlookApp.Session.OpenSharedItem(&#xA;                    msgPath&#xA;                ),&#xA;                Microsoft.Office.Interop.Outlook.MailItem&#xA;            )&#xA;&#xA;&#xA;        If mainMailItem Is Nothing Then&#xA;&#xA;            Throw New Exception(&#xA;                &quot;Outlook could not open the MSG as a MailItem.&quot; &amp;&#xA;                Environment.NewLine &amp;&#xA;                &quot;Path: &quot; &amp;&#xA;                msgPath&#xA;            )&#xA;&#xA;        End If&#xA;&#xA;&#xA;        '===================================================&#xA;        ' 7. EXTRACT SUBJECT&#xA;        '===================================================&#xA;&#xA;        Try&#xA;&#xA;            Subject =&#xA;                If(&#xA;                    mainMailItem.Subject,&#xA;                    &quot;&quot;&#xA;                )&#xA;&#xA;        Catch&#xA;&#xA;            Subject = &quot;&quot;&#xA;&#xA;        End Try&#xA;&#xA;&#xA;        '===================================================&#xA;        ' 8. EXTRACT BODY&#xA;        '===================================================&#xA;&#xA;        Try&#xA;&#xA;            Body =&#xA;                If(&#xA;                    mainMailItem.Body,&#xA;                    &quot;&quot;&#xA;                )&#xA;&#xA;        Catch&#xA;&#xA;            Body = &quot;&quot;&#xA;&#xA;        End Try&#xA;&#xA;&#xA;        '===================================================&#xA;        ' 9. EXTRACT SENDER NAME&#xA;        '===================================================&#xA;&#xA;        Try&#xA;&#xA;            SenderName =&#xA;                If(&#xA;                    mainMailItem.SenderName,&#xA;                    &quot;&quot;&#xA;                )&#xA;&#xA;        Catch&#xA;&#xA;            SenderName = &quot;&quot;&#xA;&#xA;        End Try&#xA;&#xA;&#xA;        '===================================================&#xA;        ' 10. EXTRACT SMTP SENDER EMAIL&#xA;        '===================================================&#xA;&#xA;        Try&#xA;&#xA;            SenderEmail =&#xA;                GetSenderSmtpAddress(&#xA;                    mainMailItem&#xA;                )&#xA;&#xA;        Catch&#xA;&#xA;            Try&#xA;&#xA;                SenderEmail =&#xA;                    If(&#xA;                        mainMailItem.SenderEmailAddress,&#xA;                        &quot;&quot;&#xA;                    )&#xA;&#xA;            Catch&#xA;&#xA;                SenderEmail = &quot;&quot;&#xA;&#xA;            End Try&#xA;&#xA;        End Try&#xA;&#xA;&#xA;        '===================================================&#xA;        ' 11. PDF ATTACHMENT EXTRACTION&#xA;        '===================================================&#xA;&#xA;        Dim foundDocumentPdf As Boolean = False&#xA;        Dim foundDocumentBLPdf As Boolean = False&#xA;&#xA;        Dim foundInvoicePdf As Boolean = False&#xA;        Dim foundInvoiceBLPdf As Boolean = False&#xA;&#xA;&#xA;        '===================================================&#xA;        ' FIRST PASS - DISCOVERY&#xA;        '&#xA;        ' Check what exists for DocumentNumber and for&#xA;        ' InvoiceNumber (BL flag is tracked per key).&#xA;        '===================================================&#xA;&#xA;        For Each attachment As Microsoft.Office.Interop.Outlook.Attachment _&#xA;            In mainMailItem.Attachments&#xA;&#xA;&#xA;            Try&#xA;&#xA;                Dim originalFileName As String =&#xA;                    If(&#xA;                        attachment.FileName,&#xA;                        &quot;&quot;&#xA;                    )&#xA;&#xA;&#xA;                If String.IsNullOrWhiteSpace(originalFileName) Then&#xA;&#xA;                    Continue For&#xA;&#xA;                End If&#xA;&#xA;&#xA;                ' ONLY PDF FILES&#xA;                Dim extension As String =&#xA;                    System.IO.Path.GetExtension(&#xA;                        originalFileName&#xA;                    ).ToLowerInvariant()&#xA;&#xA;&#xA;                If extension &lt;&gt; &quot;.pdf&quot; Then&#xA;&#xA;                    Continue For&#xA;&#xA;                End If&#xA;&#xA;&#xA;                Dim fileNameForComparison As String =&#xA;                    originalFileName.ToLowerInvariant()&#xA;&#xA;&#xA;                Dim hasBL As Boolean =&#xA;                    fileNameForComparison.Contains(&quot;bl&quot;)&#xA;&#xA;&#xA;                ' DocumentNumber match&#xA;                If documentKey &lt;&gt; &quot;&quot; AndAlso&#xA;                   fileNameForComparison.Contains(documentKey) Then&#xA;&#xA;                    foundDocumentPdf = True&#xA;&#xA;                    If hasBL Then&#xA;&#xA;                        foundDocumentBLPdf = True&#xA;&#xA;                    End If&#xA;&#xA;                End If&#xA;&#xA;&#xA;                ' InvoiceNumber match&#xA;                If invoiceKey &lt;&gt; &quot;&quot; AndAlso&#xA;                   fileNameForComparison.Contains(invoiceKey) Then&#xA;&#xA;                    foundInvoicePdf = True&#xA;&#xA;                    If hasBL Then&#xA;&#xA;                        foundInvoiceBLPdf = True&#xA;&#xA;                    End If&#xA;&#xA;                End If&#xA;&#xA;&#xA;            Catch&#xA;&#xA;                ' Continue checking next attachment&#xA;&#xA;            End Try&#xA;&#xA;&#xA;        Next&#xA;&#xA;&#xA;        '===================================================&#xA;        ' DECIDE WHICH KEY TO USE&#xA;        '&#xA;        ' 1. DocumentNumber PDF found -&gt; use DocumentNumber&#xA;        ' 2. Otherwise, InvoiceNumber PDF found -&gt; use&#xA;        '    InvoiceNumber&#xA;        ' 3. Otherwise -&gt; nothing to download&#xA;        '===================================================&#xA;&#xA;        Dim activeKey As String = &quot;&quot;&#xA;&#xA;        Dim foundBLPdf As Boolean = False&#xA;&#xA;&#xA;        If foundDocumentPdf Then&#xA;&#xA;            activeKey = documentKey&#xA;&#xA;            foundBLPdf = foundDocumentBLPdf&#xA;&#xA;            System.Diagnostics.Debug.WriteLine(&#xA;                &quot;Using DocumentNumber to select PDFs.&quot;&#xA;            )&#xA;&#xA;        ElseIf foundInvoicePdf Then&#xA;&#xA;            activeKey = invoiceKey&#xA;&#xA;            foundBLPdf = foundInvoiceBLPdf&#xA;&#xA;            System.Diagnostics.Debug.WriteLine(&#xA;                &quot;No DocumentNumber PDF found. &quot; &amp;&#xA;                &quot;Using InvoiceNumber to select PDFs.&quot;&#xA;            )&#xA;&#xA;        Else&#xA;&#xA;            System.Diagnostics.Debug.WriteLine(&#xA;                &quot;No PDF found for DocumentNumber or InvoiceNumber.&quot;&#xA;            )&#xA;&#xA;        End If&#xA;&#xA;&#xA;        '===================================================&#xA;        ' SECOND PASS - DOWNLOAD&#xA;        '===================================================&#xA;&#xA;        If activeKey &lt;&gt; &quot;&quot; Then&#xA;&#xA;            For Each attachment As Microsoft.Office.Interop.Outlook.Attachment _&#xA;                In mainMailItem.Attachments&#xA;&#xA;&#xA;                Dim attachmentPath As String = &quot;&quot;&#xA;&#xA;&#xA;                Try&#xA;&#xA;                    Dim originalFileName As String =&#xA;                        If(&#xA;                            attachment.FileName,&#xA;                            &quot;&quot;&#xA;                        )&#xA;&#xA;&#xA;                    If String.IsNullOrWhiteSpace(originalFileName) Then&#xA;&#xA;                        Continue For&#xA;&#xA;                    End If&#xA;&#xA;&#xA;                    ' ONLY PDF&#xA;                    Dim extension As String =&#xA;                        System.IO.Path.GetExtension(&#xA;                            originalFileName&#xA;                        ).ToLowerInvariant()&#xA;&#xA;&#xA;                    If extension &lt;&gt; &quot;.pdf&quot; Then&#xA;&#xA;                        Continue For&#xA;&#xA;                    End If&#xA;&#xA;&#xA;                    Dim fileNameForComparison As String =&#xA;                        originalFileName.ToLowerInvariant()&#xA;&#xA;&#xA;                    ' Must contain the ACTIVE key&#xA;                    If Not fileNameForComparison.Contains(activeKey) Then&#xA;&#xA;                        Continue For&#xA;&#xA;                    End If&#xA;&#xA;&#xA;                    Dim isBLPdf As Boolean =&#xA;                        fileNameForComparison.Contains(&quot;bl&quot;)&#xA;&#xA;&#xA;                    '----------------------------------------&#xA;                    ' DOWNLOAD RULE&#xA;                    '   BL exists    -&gt; download normal + BL&#xA;                    '   No BL exists -&gt; download normal only&#xA;                    '----------------------------------------&#xA;&#xA;                    Dim shouldDownload As Boolean = False&#xA;&#xA;&#xA;                    If foundBLPdf Then&#xA;&#xA;                        shouldDownload = True&#xA;&#xA;                    Else&#xA;&#xA;                        If Not isBLPdf Then&#xA;&#xA;                            shouldDownload = True&#xA;&#xA;                        End If&#xA;&#xA;                    End If&#xA;&#xA;&#xA;                    If Not shouldDownload Then&#xA;&#xA;                        Continue For&#xA;&#xA;                    End If&#xA;&#xA;&#xA;                    '----------------------------------------&#xA;                    ' SAFE OUTPUT FILE NAME&#xA;                    '----------------------------------------&#xA;&#xA;                    Dim safeFileName As String =&#xA;                        MakeSafeFileName(&#xA;                            originalFileName&#xA;                        )&#xA;&#xA;&#xA;                    attachmentPath =&#xA;                        System.IO.Path.Combine(&#xA;                            OutputFolder,&#xA;                            safeFileName&#xA;                        )&#xA;&#xA;&#xA;                    '----------------------------------------&#xA;                    ' EXISTING FILE CHECK&#xA;                    ' Already exists -&gt; do not download again,&#xA;                    ' but the PDF is available, so status True.&#xA;                    '----------------------------------------&#xA;&#xA;                    If System.IO.File.Exists(attachmentPath) Then&#xA;&#xA;                        PdfDownloaded = True&#xA;&#xA;                        System.Diagnostics.Debug.WriteLine(&#xA;                            &quot;PDF already exists. Skipping download:&quot; &amp;&#xA;                            Environment.NewLine &amp;&#xA;                            attachmentPath&#xA;                        )&#xA;&#xA;                        Continue For&#xA;&#xA;                    End If&#xA;&#xA;&#xA;                    '----------------------------------------&#xA;                    ' SAVE PDF&#xA;                    '----------------------------------------&#xA;&#xA;                    attachment.SaveAsFile(&#xA;                        attachmentPath&#xA;                    )&#xA;&#xA;&#xA;                    If Not System.IO.File.Exists(attachmentPath) Then&#xA;&#xA;                        Throw New Exception(&#xA;                            &quot;PDF attachment was not created:&quot; &amp;&#xA;                            Environment.NewLine &amp;&#xA;                            attachmentPath&#xA;                        )&#xA;&#xA;                    End If&#xA;&#xA;&#xA;                    PdfDownloaded = True&#xA;&#xA;&#xA;                    System.Diagnostics.Debug.WriteLine(&#xA;                        &quot;PDF downloaded successfully:&quot; &amp;&#xA;                        Environment.NewLine &amp;&#xA;                        attachmentPath&#xA;                    )&#xA;&#xA;&#xA;                Catch attachmentEx As Exception&#xA;&#xA;                    System.Diagnostics.Debug.WriteLine(&#xA;                        &quot;PDF attachment extraction failed.&quot; &amp;&#xA;                        Environment.NewLine &amp;&#xA;                        &quot;Attachment: &quot; &amp;&#xA;                        attachmentPath &amp;&#xA;                        Environment.NewLine &amp;&#xA;                        &quot;Error: &quot; &amp;&#xA;                        attachmentEx.ToString()&#xA;                    )&#xA;&#xA;                End Try&#xA;&#xA;&#xA;            Next&#xA;&#xA;        End If&#xA;&#xA;&#xA;    Finally&#xA;&#xA;        '===================================================&#xA;        ' CLOSE + RELEASE MAIN MSG&#xA;        '===================================================&#xA;&#xA;        If mainMailItem IsNot Nothing Then&#xA;&#xA;            Try&#xA;&#xA;                mainMailItem.Close(&#xA;                    Microsoft.Office.Interop.Outlook.OlInspectorClose.olDiscard&#xA;                )&#xA;&#xA;            Catch&#xA;&#xA;            End Try&#xA;&#xA;&#xA;            Try&#xA;&#xA;                System.Runtime.InteropServices.Marshal.FinalReleaseComObject(&#xA;                    mainMailItem&#xA;                )&#xA;&#xA;            Catch&#xA;&#xA;            End Try&#xA;&#xA;            mainMailItem = Nothing&#xA;&#xA;        End If&#xA;&#xA;    End Try&#xA;&#xA;&#xA;Catch ex As Exception&#xA;&#xA;    PdfDownloaded = False&#xA;&#xA;    Throw New Exception(&#xA;        &quot;Outlook Email Extraction failed.&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        Environment.NewLine &amp;&#xA;        &quot;MSG Path:&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        msgPath &amp;&#xA;        Environment.NewLine &amp;&#xA;        Environment.NewLine &amp;&#xA;        &quot;Output Folder:&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        OutputFolder &amp;&#xA;        Environment.NewLine &amp;&#xA;        Environment.NewLine &amp;&#xA;        &quot;Document Number:&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        DocumentNumber &amp;&#xA;        Environment.NewLine &amp;&#xA;        Environment.NewLine &amp;&#xA;        &quot;Invoice Number:&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        InvoiceNumber &amp;&#xA;        Environment.NewLine &amp;&#xA;        Environment.NewLine &amp;&#xA;        &quot;Error:&quot; &amp;&#xA;        Environment.NewLine &amp;&#xA;        ex.ToString(),&#xA;        ex&#xA;    )&#xA;&#xA;&#xA;Finally&#xA;&#xA;    '=======================================================&#xA;    ' RELEASE OUTLOOK APPLICATION&#xA;    '=======================================================&#xA;&#xA;    If outlookApp IsNot Nothing Then&#xA;&#xA;        Try&#xA;&#xA;            System.Runtime.InteropServices.Marshal.FinalReleaseComObject(&#xA;                outlookApp&#xA;            )&#xA;&#xA;        Catch&#xA;&#xA;        End Try&#xA;&#xA;        outlookApp = Nothing&#xA;&#xA;    End If&#xA;&#xA;End Try" DisplayName="Invoke Code - Email Extraction" sap:VirtualizedContainerService.HintSize="416,249" sap2010:WorkflowViewState.IdRef="InvokeCode_12">
                            <ui:InvokeCode.Arguments>
