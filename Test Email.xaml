    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Action&lt;string&gt; Log = (msg) =&gt;&#xA;{&#xA;    string line = DateTime.Now.ToString(&quot;HH:mm:ss&quot;) + &quot; - &quot; + msg;&#xA;    Console.WriteLine(line);&#xA;};&#xA;&#xA;Log(&quot;Process started.&quot;);&#xA;&#xA;// =====================================================================&#xA;// ---- CONFIG: which columns belong to &quot;SAP Data&quot;? ----&#xA;// ---- Columns 1..SapLastCol  -&gt; &quot;SAP Data&quot; (light blue)           ----&#xA;// ---- All columns after that -&gt; &quot;Validation Status&quot; (incl. Remark) ----&#xA;// ---- Column numbers: A=1, B=2, C=3 ... L=12 ... X=24             ----&#xA;// ---- &gt;&gt;&gt; CHANGE THIS NUMBER to match your sheet &lt;&lt;&lt;              ----&#xA;// =====================================================================&#xA;const int SapLastCol = 24;   // 24 = column X&#xA;&#xA;// =====================================================================&#xA;// ---- CONFIG: the 3 title rows added above the table at the end ----&#xA;// ---- (added on EVERY sheet of the workbook, all 3 lines BOLD)  ----&#xA;// =====================================================================&#xA;const string TitleLine1 = &quot;Ajanta Pharma Ltd&quot;;&#xA;const string TitleLine2 = &quot;Andheri&quot;;&#xA;const string TitleLine3Prefix = &quot;FB-60 Manual Parked Document Verified as on Date:  &quot;;   // + today's date dd-MM-yyyy&#xA;&#xA;// =====================================================================&#xA;// ---- CONFIG: data type conversion + sorting (done BEFORE all formatting) ----&#xA;// =====================================================================&#xA;// Columns converted to NUMBER  (header name -&gt; Excel number format)&#xA;Dictionary&lt;string, string&gt; numberColumns = new Dictionary&lt;string, string&gt;(StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    { &quot;Document Number&quot;, &quot;0&quot; },&#xA;    { &quot;Profit Center&quot;,   &quot;0&quot; },&#xA;    { &quot;Account&quot;,         &quot;0&quot; },&#xA;    { &quot;Amount&quot;,          &quot;0.00&quot; },&#xA;    { &quot;G/L Account&quot;,     &quot;0&quot; },&#xA;    { &quot;Pending of Days&quot;, &quot;0&quot; },&#xA;    { &quot;Days&quot;,            &quot;0&quot; },&#xA;};&#xA;&#xA;// Columns converted to SHORT DATE&#xA;string[] dateColumns = new string[] { &quot;Document Date&quot;, &quot;Posting Date&quot; };&#xA;const string ShortDateFormat = &quot;dd-mm-yyyy&quot;;&#xA;&#xA;// Sort order: 1st = Posting Date, 2nd = Amount  (1 = ascending, 2 = descending)&#xA;const string SortKey1Header = &quot;Posting Date&quot;;&#xA;const string SortKey2Header = &quot;Amount&quot;;&#xA;const int SortOrder1 = 1;&#xA;const int SortOrder2 = 1;&#xA;&#xA;// Name of the extra sheet that holds the two summary tables&#xA;const string SummarySheetName = &quot;Summary&quot;;&#xA;&#xA;// Text date patterns that are understood when a date column holds text&#xA;string[] dateFormats = new string[]&#xA;{&#xA;    &quot;d.M.yyyy&quot;, &quot;d-M-yyyy&quot;, &quot;d/M/yyyy&quot;, &quot;yyyy-M-d&quot;, &quot;yyyy/M/d&quot;, &quot;d-MMM-yyyy&quot;, &quot;d MMM yyyy&quot;,&#xA;    &quot;d.M.yyyy H:mm:ss&quot;, &quot;d-M-yyyy H:mm:ss&quot;, &quot;d/M/yyyy H:mm:ss&quot;, &quot;yyyy-M-d H:mm:ss&quot;&#xA;};&#xA;&#xA;// Text -&gt; number. Returns the original value when it is not a number.&#xA;// Handles thousand commas, spaces and SAP-style trailing minus (&quot;1,234.00-&quot;).&#xA;Func&lt;object, object&gt; ToNumber = (rawVal) =&gt;&#xA;{&#xA;    if (rawVal == null || rawVal is double) return rawVal;&#xA;&#xA;    string txt = rawVal.ToString().Replace(&quot;\u00A0&quot;, &quot; &quot;).Trim();&#xA;    if (txt.Length == 0) return rawVal;&#xA;&#xA;    bool isNeg = false;&#xA;    if (txt.EndsWith(&quot;-&quot;))&#xA;    {&#xA;        isNeg = true;&#xA;        txt = txt.Substring(0, txt.Length - 1).Trim();&#xA;    }&#xA;    txt = txt.Replace(&quot;,&quot;, &quot;&quot;);&#xA;&#xA;    double parsedNum;&#xA;    if (double.TryParse(txt, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out parsedNum)&#xA;        &amp;&amp; !double.IsNaN(parsedNum) &amp;&amp; !double.IsInfinity(parsedNum))&#xA;    {&#xA;        return isNeg ? -parsedNum : parsedNum;&#xA;    }&#xA;    return rawVal;&#xA;};&#xA;&#xA;// Text -&gt; date serial number (Excel date). Returns the original value when it is not a date.&#xA;Func&lt;object, object&gt; ToDate = (rawVal) =&gt;&#xA;{&#xA;    if (rawVal == null || rawVal is double) return rawVal;&#xA;&#xA;    string txt = rawVal.ToString().Replace(&quot;\u00A0&quot;, &quot; &quot;).Trim();&#xA;    if (txt.Length == 0) return rawVal;&#xA;&#xA;    DateTime parsedDate;&#xA;    if (DateTime.TryParseExact(txt, dateFormats, System.Globalization.CultureInfo.InvariantCulture,&#xA;                               System.Globalization.DateTimeStyles.None, out parsedDate))&#xA;    {&#xA;        return parsedDate.ToOADate();&#xA;    }&#xA;    return rawVal;&#xA;};&#xA;&#xA;// =====================================================================&#xA;// ---- Guard: does the file even exist? ----&#xA;// =====================================================================&#xA;Action&lt;string&gt; CheckFileExists = (path) =&gt;&#xA;{&#xA;    Log(&quot;Checking file path: &quot; + path);&#xA;&#xA;    if (!System.IO.File.Exists(path))&#xA;    {&#xA;        string dir = System.IO.Path.GetDirectoryName(path);&#xA;        string nameOnly = System.IO.Path.GetFileNameWithoutExtension(path);&#xA;&#xA;        Log(&quot;ERROR: File does not exist at exact path: &quot; + path);&#xA;&#xA;        if (System.IO.Directory.Exists(dir))&#xA;        {&#xA;            var matches = System.IO.Directory.GetFiles(dir, nameOnly + &quot;.*&quot;);&#xA;            if (matches.Length &gt; 0)&#xA;                Log(&quot;HINT: Found a file with the same name but different extension: &quot; + matches[0]);&#xA;            else&#xA;                Log(&quot;HINT: No file starting with '&quot; + nameOnly + &quot;' found in folder: &quot; + dir);&#xA;        }&#xA;        else&#xA;        {&#xA;            Log(&quot;HINT: The folder itself doesn't exist: &quot; + dir);&#xA;        }&#xA;&#xA;        throw new Exception(&quot;File not found: '&quot; + path + &quot;'. Check filename/extension — see log for hints.&quot;);&#xA;    }&#xA;};&#xA;&#xA;// ---- Guard: fail early if the file is already open elsewhere ----&#xA;Action&lt;string&gt; CheckFileLock = (path) =&gt;&#xA;{&#xA;    try&#xA;    {&#xA;        System.IO.FileStream fs = System.IO.File.Open(path, System.IO.FileMode.Open, System.IO.FileAccess.ReadWrite, System.IO.FileShare.None);&#xA;        fs.Close();&#xA;        Log(&quot;File is accessible and not locked by another process: &quot; + path);&#xA;    }&#xA;    catch (System.IO.IOException ex)&#xA;    {&#xA;        Log(&quot;ERROR (&quot; + ex.GetType().Name + &quot;): &quot; + ex.Message + &quot; | Path checked: &quot; + path);&#xA;        throw new Exception(&quot;File '&quot; + path + &quot;' is locked: &quot; + ex.Message);&#xA;    }&#xA;    catch (UnauthorizedAccessException ex)&#xA;    {&#xA;        Log(&quot;ERROR (UnauthorizedAccessException): &quot; + ex.Message + &quot; | Path checked: &quot; + path);&#xA;        throw new Exception(&quot;Access denied to file '&quot; + path + &quot;': &quot; + ex.Message);&#xA;    }&#xA;};&#xA;&#xA;CheckFileExists(in_FilePath);&#xA;CheckFileLock(in_FilePath);&#xA;&#xA;// =====================================================================&#xA;// ---- Launch Excel ----&#xA;// =====================================================================&#xA;dynamic excelApp = Activator.CreateInstance(Type.GetTypeFromProgID(&quot;Excel.Application&quot;));&#xA;excelApp.Visible = false;&#xA;excelApp.DisplayAlerts = false;&#xA;Log(&quot;Excel application launched.&quot;);&#xA;&#xA;dynamic wb = excelApp.Workbooks.Open(in_FilePath);&#xA;Log(&quot;Opened file: &quot; + in_FilePath);&#xA;&#xA;dynamic sheet = wb.Sheets[1];&#xA;Log(&quot;Using sheet: &quot; + sheet.Name);&#xA;&#xA;// =====================================================================&#xA;// ---- Detect the layout (fresh file vs. re-run) ----&#xA;// ---- Re-run: the 3 title rows from a previous run are removed first, ----&#xA;// ---- so everything below sees the same layout as before.          ----&#xA;// =====================================================================&#xA;string topCellText = (sheet.Cells[1, 1].Value2 != null) ? sheet.Cells[1, 1].Value2.ToString().Trim() : &quot;&quot;;&#xA;if (string.Equals(topCellText, TitleLine1, StringComparison.OrdinalIgnoreCase))&#xA;{&#xA;    sheet.Range[&quot;A1:A3&quot;].EntireRow.Delete();&#xA;    Log(&quot;Existing title rows found at the top - removed (they are added again at the end).&quot;);&#xA;}&#xA;&#xA;string a1Text = (sheet.Cells[1, 1].Value2 != null) ? sheet.Cells[1, 1].Value2.ToString().Trim() : &quot;&quot;;&#xA;bool bandRowExists = string.Equals(a1Text, &quot;SAP Data&quot;, StringComparison.OrdinalIgnoreCase)&#xA;                  || string.Equals(a1Text, &quot;Validation Status&quot;, StringComparison.OrdinalIgnoreCase);&#xA;&#xA;// =====================================================================&#xA;// ---- STEP 0: change data types, sort, build Summary sheet (BEFORE any formatting) ----&#xA;// ---- Fresh file : header is in row 1                               ----&#xA;// ---- Re-run     : band row exists, header is in row 2              ----&#xA;// =====================================================================&#xA;int preHeaderRow = bandRowExists ? 2 : 1;&#xA;&#xA;dynamic preLastRowCell = sheet.Cells[sheet.Rows.Count, 1];&#xA;int preLastRow = (int)preLastRowCell.End(-4162).Row; // xlUp&#xA;&#xA;dynamic preLastColCell = sheet.Cells[preHeaderRow, sheet.Columns.Count];&#xA;int preLastCol = (int)preLastColCell.End(-4159).Column; // xlToLeft&#xA;&#xA;if (preLastRow &gt; preHeaderRow &amp;&amp; preLastCol &gt;= 1)&#xA;{&#xA;    // header name -&gt; column number&#xA;    Dictionary&lt;string, int&gt; preHeaderMap = new Dictionary&lt;string, int&gt;(StringComparer.OrdinalIgnoreCase);&#xA;    for (int hc = 1; hc &lt;= preLastCol; hc++)&#xA;    {&#xA;        object hv = sheet.Cells[preHeaderRow, hc].Value2;&#xA;        string ht = (hv != null) ? hv.ToString().Trim() : &quot;&quot;;&#xA;        if (ht.Length &gt; 0 &amp;&amp; !preHeaderMap.ContainsKey(ht))&#xA;            preHeaderMap[ht] = hc;&#xA;    }&#xA;&#xA;    // ---- 0a. Number columns ----&#xA;    foreach (KeyValuePair&lt;string, string&gt; nc in numberColumns)&#xA;    {&#xA;        int ncCol;&#xA;        if (!preHeaderMap.TryGetValue(nc.Key, out ncCol))&#xA;        {&#xA;            Log(&quot;WARNING: column '&quot; + nc.Key + &quot;' not found - number conversion skipped.&quot;);&#xA;            continue;&#xA;        }&#xA;&#xA;        // Set the format FIRST (a text-formatted cell would keep a number as text)&#xA;        dynamic ncRange = sheet.Range[sheet.Cells[preHeaderRow + 1, ncCol], sheet.Cells[preLastRow, ncCol]];&#xA;        ncRange.NumberFormat = nc.Value;&#xA;&#xA;        int numConverted = 0;&#xA;        for (int pr = preHeaderRow + 1; pr &lt;= preLastRow; pr++)&#xA;        {&#xA;            dynamic ncCell = sheet.Cells[pr, ncCol];&#xA;            object raw = ncCell.Value2;&#xA;            object num = ToNumber(raw);&#xA;            if (!(raw is double) &amp;&amp; num is double)&#xA;            {&#xA;                ncCell.Value2 = num;&#xA;                numConverted++;&#xA;            }&#xA;        }&#xA;        Log(&quot;Number format applied to '&quot; + nc.Key + &quot;' (col &quot; + ncCol + &quot;). Text converted to number: &quot; + numConverted);&#xA;    }&#xA;&#xA;    // ---- 0b. Short date columns ----&#xA;    foreach (string dcName in dateColumns)&#xA;    {&#xA;        int dcCol;&#xA;        if (!preHeaderMap.TryGetValue(dcName, out dcCol))&#xA;        {&#xA;            Log(&quot;WARNING: column '&quot; + dcName + &quot;' not found - date conversion skipped.&quot;);&#xA;            continue;&#xA;        }&#xA;&#xA;        dynamic dcRange = sheet.Range[sheet.Cells[preHeaderRow + 1, dcCol], sheet.Cells[preLastRow, dcCol]];&#xA;        dcRange.NumberFormat = ShortDateFormat;&#xA;&#xA;        int dateConverted = 0;&#xA;        for (int dr = preHeaderRow + 1; dr &lt;= preLastRow; dr++)&#xA;        {&#xA;            dynamic dcCell = sheet.Cells[dr, dcCol];&#xA;            object rawDate = dcCell.Value2;&#xA;            object dateVal = ToDate(rawDate);&#xA;            if (!(rawDate is double) &amp;&amp; dateVal is double)&#xA;            {&#xA;                dcCell.Value2 = dateVal;&#xA;                dateConverted++;&#xA;            }&#xA;        }&#xA;        Log(&quot;Short date format applied to '&quot; + dcName + &quot;' (col &quot; + dcCol + &quot;). Text converted to date: &quot; + dateConverted);&#xA;    }&#xA;&#xA;    // ---- 0c. Sort: 1st Posting Date, 2nd Amount ----&#xA;    int sortCol1;&#xA;    int sortCol2;&#xA;    bool hasSort1 = preHeaderMap.TryGetValue(SortKey1Header, out sortCol1);&#xA;    bool hasSort2 = preHeaderMap.TryGetValue(SortKey2Header, out sortCol2);&#xA;&#xA;    if (!hasSort1) Log(&quot;WARNING: sort column '&quot; + SortKey1Header + &quot;' not found - it is skipped in the sort.&quot;);&#xA;    if (!hasSort2) Log(&quot;WARNING: sort column '&quot; + SortKey2Header + &quot;' not found - it is skipped in the sort.&quot;);&#xA;&#xA;    if ((hasSort1 || hasSort2) &amp;&amp; preLastRow &gt; preHeaderRow + 1)&#xA;    {&#xA;        dynamic sortRange = sheet.Range[sheet.Cells[preHeaderRow, 1], sheet.Cells[preLastRow, preLastCol]];&#xA;        dynamic sortObj = sheet.Sort;&#xA;        sortObj.SortFields.Clear();&#xA;&#xA;        // SortFields.Add(Key, SortOn: 0 = xlSortOnValues, Order: 1 = xlAscending / 2 = xlDescending)&#xA;        if (hasSort1)&#xA;            sortObj.SortFields.Add(sheet.Range[sheet.Cells[preHeaderRow + 1, sortCol1], sheet.Cells[preLastRow, sortCol1]], 0, SortOrder1);&#xA;        if (hasSort2)&#xA;            sortObj.SortFields.Add(sheet.Range[sheet.Cells[preHeaderRow + 1, sortCol2], sheet.Cells[preLastRow, sortCol2]], 0, SortOrder2);&#xA;&#xA;        sortObj.SetRange(sortRange);&#xA;        sortObj.Header = 1;          // xlYes - first row is the header&#xA;        sortObj.MatchCase = false;&#xA;        sortObj.Orientation = 1;     // xlTopToBottom&#xA;        sortObj.Apply();&#xA;&#xA;        Log(&quot;Sorted by '&quot; + (hasSort1 ? SortKey1Header : &quot;-&quot;) + &quot;' then '&quot; + (hasSort2 ? SortKey2Header : &quot;-&quot;) + &quot;'.&quot;);&#xA;    }&#xA;&#xA;    // =================================================================&#xA;    // ---- 0d. Build the &quot;Summary&quot; sheet                            ----&#xA;    // ---- (after type change + sort, BEFORE any formatting)        ----&#xA;    // ---- Table 1: Posting Status -&gt; Ready to Post (&quot;Posted&quot;) / Not Validate, with % ----&#xA;    // ---- Table 2: one row per unique Vendor Name                  ----&#xA;    // =================================================================&#xA;    int sumStatusCol;&#xA;    int sumVendorCol;&#xA;    int sumAmountCol;&#xA;    bool hasSumStatus = preHeaderMap.TryGetValue(&quot;Posting Status&quot;, out sumStatusCol);&#xA;    bool hasSumVendor = preHeaderMap.TryGetValue(&quot;Vendor Name&quot;, out sumVendorCol);&#xA;    bool hasSumAmount = preHeaderMap.TryGetValue(&quot;Amount&quot;, out sumAmountCol);&#xA;&#xA;    if (!hasSumStatus)&#xA;    {&#xA;        Log(&quot;WARNING: column 'Posting Status' not found - Summary sheet skipped.&quot;);&#xA;    }&#xA;    else&#xA;    {&#xA;        if (!hasSumVendor) Log(&quot;WARNING: column 'Vendor Name' not found - vendor table will be empty.&quot;);&#xA;        if (!hasSumAmount) Log(&quot;WARNING: column 'Amount' not found - vendor values will be 0.&quot;);&#xA;&#xA;        // ---------- read the data and count ----------&#xA;        int sumReady = 0;&#xA;        int sumNotValid = 0;&#xA;        int sumOther = 0;&#xA;&#xA;        List&lt;string&gt; sumVendors = new List&lt;string&gt;();   // unique vendors, in order of first appearance&#xA;        Dictionary&lt;string, int&gt; sumVendorIdx = new Dictionary&lt;string, int&gt;(StringComparer.OrdinalIgnoreCase);&#xA;        List&lt;int&gt; sumDocCnt = new List&lt;int&gt;();&#xA;        List&lt;double&gt; sumValue = new List&lt;double&gt;();&#xA;        List&lt;int&gt; sumMatched = new List&lt;int&gt;();&#xA;        List&lt;int&gt; sumUnmatched = new List&lt;int&gt;();&#xA;&#xA;        for (int sr = preHeaderRow + 1; sr &lt;= preLastRow; sr++)&#xA;        {&#xA;            object stRaw = sheet.Cells[sr, sumStatusCol].Value2;&#xA;            string stText = (stRaw != null) ? stRaw.ToString().Trim() : &quot;&quot;;&#xA;            bool isReady = stText.StartsWith(&quot;Ready to Post&quot;, StringComparison.OrdinalIgnoreCase);&#xA;            bool isNotValid = stText.StartsWith(&quot;Not Validate&quot;, StringComparison.OrdinalIgnoreCase);&#xA;&#xA;            if (isReady) sumReady++;&#xA;            else if (isNotValid) sumNotValid++;&#xA;            else sumOther++;&#xA;&#xA;            if (!hasSumVendor) continue;&#xA;&#xA;            object vnRaw = sheet.Cells[sr, sumVendorCol].Value2;&#xA;            string vnText = (vnRaw != null) ? vnRaw.ToString().Trim() : &quot;&quot;;&#xA;            if (vnText.Length == 0) continue;&#xA;&#xA;            int vi;&#xA;            if (!sumVendorIdx.TryGetValue(vnText, out vi))&#xA;            {&#xA;                vi = sumVendors.Count;&#xA;                sumVendorIdx[vnText] = vi;&#xA;                sumVendors.Add(vnText);&#xA;                sumDocCnt.Add(0);&#xA;                sumValue.Add(0.0);&#xA;                sumMatched.Add(0);&#xA;                sumUnmatched.Add(0);&#xA;            }&#xA;&#xA;            sumDocCnt[vi] = sumDocCnt[vi] + 1;&#xA;            if (isReady) sumMatched[vi] = sumMatched[vi] + 1;&#xA;            if (isNotValid) sumUnmatched[vi] = sumUnmatched[vi] + 1;&#xA;&#xA;            if (hasSumAmount)&#xA;            {&#xA;                object amRaw = sheet.Cells[sr, sumAmountCol].Value2;&#xA;                object amNum = ToNumber(amRaw);&#xA;                if (amNum is double) sumValue[vi] = sumValue[vi] + (double)amNum;&#xA;            }&#xA;        }&#xA;&#xA;        int sumTotal = sumReady + sumNotValid;   // Total = Ready to Post + Not Validate&#xA;        double readyPct = (sumTotal == 0) ? 0.0 : (double)sumReady / sumTotal;&#xA;        double notValidPct = (sumTotal == 0) ? 0.0 : (double)sumNotValid / sumTotal;&#xA;        double totalPct = (sumTotal == 0) ? 0.0 : 1.0;&#xA;&#xA;        Log(&quot;Summary counts - Ready to Post: &quot; + sumReady + &quot;, Not Validate: &quot; + sumNotValid&#xA;            + &quot;, other/blank status (not counted): &quot; + sumOther + &quot;, unique vendors: &quot; + sumVendors.Count);&#xA;&#xA;        // ---------- remove an old Summary sheet (re-run), then add a fresh one after the data sheet ----------&#xA;        int sheetCountNow = (int)wb.Sheets.Count;&#xA;        for (int si = sheetCountNow; si &gt;= 1; si--)&#xA;        {&#xA;            dynamic wsCheck = wb.Sheets[si];&#xA;            if (string.Equals((string)wsCheck.Name, SummarySheetName, StringComparison.OrdinalIgnoreCase))&#xA;            {&#xA;                wsCheck.Delete();&#xA;                Log(&quot;Old '&quot; + SummarySheetName + &quot;' sheet removed (it is rebuilt).&quot;);&#xA;            }&#xA;        }&#xA;&#xA;        dynamic sumSheet = wb.Sheets.Add(Type.Missing, wb.Sheets[wb.Sheets.Count]);&#xA;        sumSheet.Name = SummarySheetName;&#xA;&#xA;        // ---------- colors (Excel Color = R + G*256 + B*65536) ----------&#xA;        int sumNavy = 6567967;      // RGB(31, 56, 100)  - dark blue header fill / &quot;Checked By Vendor Report&quot; text&#xA;        int sumWhite = 16777215;    // RGB(255, 255, 255) - header text&#xA;        int sumGreenText = 5287936; // RGB(0, 176, 80)   - &quot;Ready to Post&quot;&#xA;        int sumRedText = 192;       // RGB(192, 0, 0)    - &quot;Not Validate&quot;&#xA;&#xA;        // header style: navy fill, white bold text, centered, wrapped&#xA;        Action&lt;dynamic&gt; StyleSummaryHeader = (hdr) =&gt;&#xA;        {&#xA;            hdr.Interior.Color = sumNavy;&#xA;            hdr.Font.Color = sumWhite;&#xA;            hdr.Font.Bold = true;&#xA;            hdr.HorizontalAlignment = -4108; // xlCenter&#xA;            hdr.VerticalAlignment = -4108;   // xlCenter&#xA;            hdr.WrapText = true;&#xA;        };&#xA;&#xA;        // thin borders on every edge and inside line of a range&#xA;        Action&lt;dynamic&gt; AddSummaryBorders = (brdRange) =&gt;&#xA;        {&#xA;            foreach (int bi in new int[] { 7, 8, 9, 10, 11, 12 })&#xA;            {&#xA;                dynamic brdEdge = brdRange.Borders[bi];&#xA;                brdEdge.LineStyle = 1;  // xlContinuous&#xA;                brdEdge.Weight = 2;     // xlThin&#xA;            }&#xA;        };&#xA;&#xA;        // column widths (Vendor / Verdict column is wide, like the template)&#xA;        sumSheet.Range[&quot;A1&quot;].EntireColumn.ColumnWidth = 60;&#xA;        sumSheet.Range[&quot;B1&quot;].EntireColumn.ColumnWidth = 20;&#xA;        sumSheet.Range[&quot;C1&quot;].EntireColumn.ColumnWidth = 16;&#xA;        sumSheet.Range[&quot;D1&quot;].EntireColumn.ColumnWidth = 16;&#xA;        sumSheet.Range[&quot;E1&quot;].EntireColumn.ColumnWidth = 16;&#xA;&#xA;        // ---------- title ----------&#xA;        sumSheet.Cells[1, 1].Value2 = &quot;Invoice Verification \u2013 Summary&quot;;&#xA;        sumSheet.Cells[1, 1].Font.Bold = true;&#xA;&#xA;        // ---------- TABLE 1 (rows 3-6): Verdict | Documents Count | % ----------&#xA;        sumSheet.Cells[3, 1].Value2 = &quot;Verdict&quot;;&#xA;        sumSheet.Cells[3, 2].Value2 = &quot;Documents Count&quot;;&#xA;        sumSheet.Cells[3, 3].Value2 = &quot;%&quot;;&#xA;&#xA;        sumSheet.Cells[4, 1].Value2 = &quot;Ready to Post&quot;;&#xA;        sumSheet.Cells[4, 2].Value2 = sumReady;&#xA;        sumSheet.Cells[4, 3].Value2 = readyPct;&#xA;&#xA;        sumSheet.Cells[5, 1].Value2 = &quot;Not Validate&quot;;&#xA;        sumSheet.Cells[5, 2].Value2 = sumNotValid;&#xA;        sumSheet.Cells[5, 3].Value2 = notValidPct;&#xA;&#xA;        sumSheet.Cells[6, 1].Value2 = &quot;Total&quot;;&#xA;        sumSheet.Cells[6, 2].Value2 = sumTotal;&#xA;        sumSheet.Cells[6, 3].Value2 = totalPct;&#xA;&#xA;        dynamic t1Header = sumSheet.Range[sumSheet.Cells[3, 1], sumSheet.Cells[3, 3]];&#xA;        StyleSummaryHeader(t1Header);&#xA;        t1Header.EntireRow.RowHeight = 30;&#xA;&#xA;        sumSheet.Cells[4, 1].Font.Color = sumGreenText;&#xA;        sumSheet.Cells[4, 1].Font.Bold = true;&#xA;        sumSheet.Cells[5, 1].Font.Color = sumRedText;&#xA;        sumSheet.Cells[5, 1].Font.Bold = true;&#xA;        dynamic t1TotalRow = sumSheet.Range[sumSheet.Cells[6, 1], sumSheet.Cells[6, 3]];&#xA;        t1TotalRow.Font.Bold = true;&#xA;&#xA;        sumSheet.Range[sumSheet.Cells[4, 2], sumSheet.Cells[6, 2]].NumberFormat = &quot;0&quot;;&#xA;        sumSheet.Range[sumSheet.Cells[4, 3], sumSheet.Cells[6, 3]].NumberFormat = &quot;0.0%;-0.0%;\&quot;-\&quot;&quot;;&#xA;&#xA;        dynamic t1All = sumSheet.Range[sumSheet.Cells[3, 1], sumSheet.Cells[6, 3]];&#xA;        AddSummaryBorders(t1All);&#xA;&#xA;        // ---------- TABLE 2 (header row 9, data from row 10) ----------&#xA;        const int T2Header = 9;&#xA;        const int T2First = 10;&#xA;&#xA;        sumSheet.Cells[8, 1].Value2 = &quot;Checked By Vendor Report&quot;;&#xA;        sumSheet.Cells[8, 1].Font.Bold = true;&#xA;        sumSheet.Cells[8, 1].Font.Color = sumNavy;&#xA;&#xA;        string[] t2Heads = new string[] { &quot;Vendor&quot;, &quot;Doc counts&quot;, &quot;Value (INR)&quot;, &quot;Matched doc count&quot;, &quot;Unmatched doc count&quot; };&#xA;        for (int hi = 0; hi &lt; t2Heads.Length; hi++)&#xA;            sumSheet.Cells[T2Header, hi + 1].Value2 = t2Heads[hi];&#xA;&#xA;        for (int vr = 0; vr &lt; sumVendors.Count; vr++)&#xA;        {&#xA;            int xr = T2First + vr;&#xA;            sumSheet.Cells[xr, 1].Value2 = sumVendors[vr];&#xA;            sumSheet.Cells[xr, 2].Value2 = sumDocCnt[vr];&#xA;            sumSheet.Cells[xr, 3].Value2 = Math.Round(sumValue[vr], 2);&#xA;            sumSheet.Cells[xr, 4].Value2 = sumMatched[vr];&#xA;            sumSheet.Cells[xr, 5].Value2 = sumUnmatched[vr];&#xA;        }&#xA;&#xA;        dynamic t2Header = sumSheet.Range[sumSheet.Cells[T2Header, 1], sumSheet.Cells[T2Header, 5]];&#xA;        StyleSummaryHeader(t2Header);&#xA;        t2Header.EntireRow.RowHeight = 32;&#xA;&#xA;        int t2Last = T2Header + sumVendors.Count;   // last row of table 2 (= header row when there are no vendors)&#xA;        if (sumVendors.Count &gt; 0)&#xA;        {&#xA;            sumSheet.Range[sumSheet.Cells[T2First, 2], sumSheet.Cells[t2Last, 2]].NumberFormat = &quot;0&quot;;&#xA;            sumSheet.Range[sumSheet.Cells[T2First, 3], sumSheet.Cells[t2Last, 3]].NumberFormat = &quot;0.00&quot;;&#xA;            sumSheet.Range[sumSheet.Cells[T2First, 4], sumSheet.Cells[t2Last, 5]].NumberFormat = &quot;0&quot;;&#xA;        }&#xA;&#xA;        dynamic t2All = sumSheet.Range[sumSheet.Cells[T2Header, 1], sumSheet.Cells[t2Last, 5]];&#xA;        AddSummaryBorders(t2All);&#xA;&#xA;        // hide gridlines on the Summary sheet (cosmetic - ignored if Excel refuses)&#xA;        try&#xA;        {&#xA;            sumSheet.Activate();&#xA;            excelApp.ActiveWindow.DisplayGridlines = false;&#xA;        }&#xA;        catch { /* not critical */ }&#xA;&#xA;        Log(&quot;'&quot; + SummarySheetName + &quot;' sheet created: 3 rows in table 1, &quot; + sumVendors.Count + &quot; vendor rows in table 2.&quot;);&#xA;&#xA;        System.Runtime.InteropServices.Marshal.ReleaseComObject(sumSheet);&#xA;&#xA;        // go back to the data sheet so the file opens on it&#xA;        sheet.Activate();&#xA;    }&#xA;}&#xA;else&#xA;{&#xA;    Log(&quot;Step 0 skipped: no data rows found for type conversion / sorting.&quot;);&#xA;}&#xA;&#xA;// =====================================================================&#xA;// ---- Make room for the &quot;SAP Data / Validation Status&quot; band row (row 1) ----&#xA;// ---- First run : insert a new row at the top, header moves to row 2 ----&#xA;// ---- Re-run    : band row already exists, just un-merge and reuse it ----&#xA;// =====================================================================&#xA;dynamic bandRowBeforeInsert = sheet.Range[sheet.Cells[1, 1], sheet.Cells[1, 1]].EntireRow;&#xA;&#xA;if (bandRowExists)&#xA;{&#xA;    bandRowBeforeInsert.UnMerge();&#xA;    Log(&quot;Existing band row found in row 1 - it will be rebuilt.&quot;);&#xA;}&#xA;else&#xA;{&#xA;    bandRowBeforeInsert.Insert(); // shifts everything down by one row&#xA;    Log(&quot;New band row inserted at row 1.&quot;);&#xA;}&#xA;// IMPORTANT: after Insert(), the old range object follows the moved cells (it now&#xA;// points at the header row, which is row 2). Take a FRESH reference to row 1&#xA;// before clearing, otherwise the header row would be wiped.&#xA;dynamic bandRowEntire = sheet.Range[sheet.Cells[1, 1], sheet.Cells[1, 1]].EntireRow;&#xA;bandRowEntire.ClearContents();&#xA;bandRowEntire.ClearFormats();&#xA;&#xA;const int BandRow   = 1;   // &quot;SAP Data&quot; / &quot;Validation Status&quot;  (moves to row 4 at the very end)&#xA;const int HeaderRow = 2;   // column headers                    (moves to row 5 at the very end)&#xA;const int FirstDataRow = 3;&#xA;&#xA;// =====================================================================&#xA;// ---- Find used range (last row / last column) ----&#xA;// =====================================================================&#xA;dynamic lastCellRow = sheet.Cells[sheet.Rows.Count, 1];&#xA;int lastRow = (int)lastCellRow.End(-4162).Row; // xlUp&#xA;&#xA;dynamic lastCellCol = sheet.Cells[HeaderRow, sheet.Columns.Count];&#xA;int lastCol = (int)lastCellCol.End(-4159).Column; // xlToLeft&#xA;&#xA;Log(&quot;Sheet has &quot; + lastRow + &quot; rows (incl. band + header) and &quot; + lastCol + &quot; columns.&quot;);&#xA;&#xA;if (lastRow &lt; FirstDataRow || lastCol &lt; 1)&#xA;    throw new Exception(&quot;Sheet has no data rows — nothing to format.&quot;);&#xA;&#xA;// =====================================================================&#xA;// ---- Decide where the &quot;Remark&quot; column goes ----&#xA;// ---- If the file was already processed (last header is &quot;Remark&quot;), ----&#xA;// ---- reuse that column instead of adding a second one.           ----&#xA;// =====================================================================&#xA;const string RemarkHeader = &quot;Remark&quot;;&#xA;&#xA;string lastHeaderText = (sheet.Cells[HeaderRow, lastCol].Value2 != null) ? sheet.Cells[HeaderRow, lastCol].Value2.ToString().Trim() : &quot;&quot;;&#xA;&#xA;int dataLastCol;   // last column that holds real data (excludes Remark)&#xA;int remarkCol;     // column where Remark is written&#xA;&#xA;if (string.Equals(lastHeaderText, RemarkHeader, StringComparison.OrdinalIgnoreCase))&#xA;{&#xA;    remarkCol = lastCol;&#xA;    dataLastCol = lastCol - 1;&#xA;    Log(&quot;Existing 'Remark' column found at col &quot; + remarkCol + &quot; - it will be overwritten.&quot;);&#xA;}&#xA;else&#xA;{&#xA;    dataLastCol = lastCol;&#xA;    remarkCol = lastCol + 1;&#xA;    Log(&quot;'Remark' column will be added at col &quot; + remarkCol + &quot;.&quot;);&#xA;}&#xA;&#xA;// =====================================================================&#xA;// ---- Red / Green status highlighting based on column header ----&#xA;// ---- (negative keyword -&gt; Red, everything else -&gt; Green)        ----&#xA;// =====================================================================&#xA;// Excel Color values are computed as R + (G*256) + (B*65536)&#xA;// Faint/pastel shades (Excel's standard &quot;Bad&quot;/&quot;Good&quot; conditional-format colors)&#xA;int ColorRed   = 13551615; // RGB(255, 199, 206) -- faint red&#xA;int ColorGreen = 13561798; // RGB(198, 239, 206) -- faint green&#xA;int ColorLightBlue = 15652797; // RGB(189, 215, 238) -- light blue for &quot;SAP Data&quot;&#xA;int ColorValidation = 10086143; // RGB(255, 230, 153) -- light gold for &quot;Validation Status&quot;&#xA;&#xA;// Negative keyword(s) per column header. A cell is treated as NEGATIVE (red)&#xA;// when its text STARTS WITH any listed keyword (case-insensitive), e.g.&#xA;//   &quot;Unmatched&quot;&#xA;//   &quot;UnmatchedTrinity Synergy 154, ...||Trinity Packaging Co Pvt Ltd.&quot;&#xA;// Anything else that is non-blank is treated as positive (green).&#xA;Dictionary&lt;string, string[]&gt; negativeValuesByHeader = new Dictionary&lt;string, string[]&gt;(StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    { &quot;Posting Status&quot;,                      new [] { &quot;Not Validate&quot; } },&#xA;    { &quot;Email attachment Status&quot;,             new [] { &quot;Email Not attached&quot; } },&#xA;    { &quot;Invoice attachment Status&quot;,           new [] { &quot;Invoice not attached&quot;, &quot;Unmatched&quot; } },&#xA;    { &quot;Vendor Name Status&quot;,                  new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Vendor Address&quot;,                      new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Ajanta GSTIN&quot;,                        new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Invoice Number/GSTN Bill No.&quot;,        new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Invoice Date&quot;,                        new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Currency&quot;,                            new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Bus Place/Sectn.&quot;,                    new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Bank Details&quot;,                        new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Invoice Basic Value&quot;,                 new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;GST Value&quot;,                           new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Tax Code Status&quot;,                     new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Gross Invoice Value&quot;,                 new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;TDS Code Status&quot;,                     new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Payment Block Status&quot;,                new [] { &quot;Block&quot; } },&#xA;    { &quot;Document Number Status&quot;,              new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Document Number Approval&quot;,            new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Delay Bill submission Status&quot;,        new [] { &quot;Delay&quot; } },&#xA;    { &quot;Text (Document Header)&quot;,              new [] { &quot;Text Not Available&quot; } },&#xA;    { &quot;Text GL&quot;,                             new [] { &quot;Text Not Available&quot; } },&#xA;    { &quot;Payment TDS (WHT) Status&quot;,            new [] { &quot;Not Selected&quot; } },&#xA;    { &quot;BL Copy Status&quot;,                      new [] { &quot;Not Attached&quot; } },&#xA;    { &quot;BL Number &amp; Shipper Name&quot;,            new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Vendor GSTIN&quot;,                        new [] { &quot;Not Attached&quot; } },&#xA;    { &quot;Ajanta Address&quot;,                      new [] { &quot;Unmatched&quot; } },&#xA;};&#xA;&#xA;// Columns that should simply be filled green for every populated cell,&#xA;// with no red/negative condition at all.&#xA;HashSet&lt;string&gt; alwaysGreenHeaders = new HashSet&lt;string&gt;(StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    &quot;Profit Center Status&quot;,&#xA;};&#xA;&#xA;// Columns that are still colored red/green (and shortened) but must NOT be&#xA;// written into the Remark column. Add more header names here if needed.&#xA;HashSet&lt;string&gt; excludeFromRemark = new HashSet&lt;string&gt;(StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    &quot;Posting Status&quot;,&#xA;};&#xA;&#xA;// One list per row: collects one entry per red cell in that row.&#xA;// Tuple = (column header, matched keyword e.g. &quot;Unmatched&quot;, detail text after the keyword)&#xA;List&lt;Tuple&lt;string, string, string&gt;&gt;[] rowRemarks = new List&lt;Tuple&lt;string, string, string&gt;&gt;[lastRow + 1];&#xA;for (int r = FirstDataRow; r &lt;= lastRow; r++)&#xA;    rowRemarks[r] = new List&lt;Tuple&lt;string, string, string&gt;&gt;();&#xA;&#xA;// Remembers every red cell so we can shorten its text AFTER the Remark column is written.&#xA;// Tuple = (row, col, shortText)&#xA;List&lt;Tuple&lt;int, int, string&gt;&gt; redCellsToShorten = new List&lt;Tuple&lt;int, int, string&gt;&gt;();&#xA;&#xA;for (int col = 1; col &lt;= dataLastCol; col++)&#xA;{&#xA;    dynamic headerCell = sheet.Cells[HeaderRow, col];&#xA;    string headerText = (headerCell.Value2 != null) ? headerCell.Value2.ToString().Trim() : &quot;&quot;;&#xA;&#xA;    string[] negativeValues;&#xA;    bool isKnownStatusColumn = negativeValuesByHeader.TryGetValue(headerText, out negativeValues);&#xA;    bool isAlwaysGreenColumn = alwaysGreenHeaders.Contains(headerText);&#xA;&#xA;    if (!isKnownStatusColumn &amp;&amp; !isAlwaysGreenColumn)&#xA;    {&#xA;        // Column header not in the known status list — skip coloring it.&#xA;        continue;&#xA;    }&#xA;&#xA;    for (int row = FirstDataRow; row &lt;= lastRow; row++)&#xA;    {&#xA;        dynamic dataCell = sheet.Cells[row, col];&#xA;        string cellText = (dataCell.Value2 != null) ? dataCell.Value2.ToString().Trim() : &quot;&quot;;&#xA;&#xA;        if (cellText.Length == 0)&#xA;            continue; // leave blanks unformatted&#xA;&#xA;        if (isAlwaysGreenColumn)&#xA;        {&#xA;            dataCell.Interior.Color = ColorGreen;&#xA;            continue;&#xA;        }&#xA;&#xA;        bool isNegative = false;&#xA;        string matchedKeyword = &quot;&quot;;&#xA;&#xA;        foreach (string negVal in negativeValues)&#xA;        {&#xA;            // StartsWith: catches &quot;Unmatched&quot; AND &quot;UnmatchedTrinity Synergy 154, ...&quot;&#xA;            if (cellText.StartsWith(negVal, StringComparison.OrdinalIgnoreCase))&#xA;            {&#xA;                isNegative = true;&#xA;                // keep the text exactly as it appears in the cell (original casing)&#xA;                matchedKeyword = cellText.Substring(0, negVal.Length);&#xA;                break;&#xA;            }&#xA;        }&#xA;&#xA;        dataCell.Interior.Color = isNegative ? ColorRed : ColorGreen;&#xA;&#xA;        if (isNegative)&#xA;        {&#xA;            // Everything after the keyword = the SAP vs IDP detail (may be empty)&#xA;            string detail = cellText.Substring(matchedKeyword.Length).Trim();&#xA;&#xA;            // Excluded columns (e.g. Posting Status) do not go into the Remark column&#xA;            if (!excludeFromRemark.Contains(headerText))&#xA;                rowRemarks[row].Add(Tuple.Create(headerText, matchedKeyword, detail));&#xA;&#xA;            // Short text will replace the cell value after Remark is written&#xA;            redCellsToShorten.Add(Tuple.Create(row, col, matchedKeyword));&#xA;        }&#xA;    }&#xA;&#xA;    Log(&quot;Applied highlighting to column '&quot; + headerText + &quot;' (col &quot; + col + &quot;).&quot;);&#xA;}&#xA;&#xA;// =====================================================================&#xA;// ---- Write the &quot;Remark&quot; column ----&#xA;// ---- One block per red cell, blank line between blocks:          ----&#xA;// ----                                                             ----&#xA;// ----   Vendor Name Mismatch:        (bold)                       ----&#xA;// ----   SAP: Trinity Synergy                                      ----&#xA;// ----   Invoice: Trinity Packaging Co Pvt Ltd.                    ----&#xA;// ----                                                             ----&#xA;// ---- Detail text is split at the first &quot;||&quot;, &quot;VSIDPData&quot; or &quot; VS &quot; ----&#xA;// ---- Left part = SAP value, right part = Invoice (IDP) value.    ----&#xA;// ---- If a red cell has no detail (e.g. &quot;Unmatched&quot; only) the block is: ----&#xA;// ----   Approved By status: Unmatched   (header part bold)        ----&#xA;// =====================================================================&#xA;System.Text.RegularExpressions.Regex sepRegex =&#xA;    new System.Text.RegularExpressions.Regex(@&quot;\|\||VS\s*IDP\s*Data\s*:?|\sVS\s&quot;);&#xA;&#xA;sheet.Cells[HeaderRow, remarkCol].Value2 = RemarkHeader;&#xA;&#xA;int rowsWithRemark = 0;&#xA;for (int row = FirstDataRow; row &lt;= lastRow; row++)&#xA;{&#xA;    dynamic remarkCell = sheet.Cells[row, remarkCol];&#xA;    remarkCell.Font.Bold = false; // reset any old bold from a previous run&#xA;    List&lt;Tuple&lt;string, string, string&gt;&gt; points = rowRemarks[row];&#xA;&#xA;    if (points.Count == 0)&#xA;    {&#xA;        remarkCell.Value2 = null; // clear any old remark (useful on re-runs)&#xA;        continue;&#xA;    }&#xA;&#xA;    System.Text.StringBuilder sb = new System.Text.StringBuilder();&#xA;    List&lt;int[]&gt; boldRanges = new List&lt;int[]&gt;(); // (start 1-based, length)&#xA;&#xA;    foreach (Tuple&lt;string, string, string&gt; p in points)&#xA;    {&#xA;        string header  = p.Item1;&#xA;        string keyword = p.Item2;&#xA;        string detail  = p.Item3;&#xA;&#xA;        if (sb.Length &gt; 0)&#xA;            sb.Append(&quot;\n\n&quot;);&#xA;&#xA;        if (detail.Length == 0)&#xA;        {&#xA;            // No SAP/IDP detail - just &quot;Header: Status&quot;&#xA;            string heading = header + &quot;:&quot;;&#xA;            boldRanges.Add(new int[] { sb.Length + 1, heading.Length });&#xA;            sb.Append(heading).Append(&quot; &quot;).Append(keyword);&#xA;            continue;&#xA;        }&#xA;&#xA;        // Heading name: drop a trailing &quot; Status&quot; so &quot;Vendor Name Status&quot; -&gt; &quot;Vendor Name Mismatch:&quot;&#xA;        string baseName = header;&#xA;        if (baseName.EndsWith(&quot; Status&quot;, StringComparison.OrdinalIgnoreCase))&#xA;            baseName = baseName.Substring(0, baseName.Length - 7).Trim();&#xA;&#xA;        string mismatchHeading = baseName + &quot; Mismatch:&quot;;&#xA;        boldRanges.Add(new int[] { sb.Length + 1, mismatchHeading.Length });&#xA;        sb.Append(mismatchHeading);&#xA;&#xA;        System.Text.RegularExpressions.Match m = sepRegex.Match(detail);&#xA;        if (m.Success)&#xA;        {&#xA;            string sapText = detail.Substring(0, m.Index);&#xA;            string idpText = detail.Substring(m.Index + m.Length);&#xA;&#xA;            // remove a leading &quot;SAPData:&quot; / &quot;IDPData:&quot; label if present&#xA;            sapText = System.Text.RegularExpressions.Regex.Replace(sapText, @&quot;^\s*SAP\s*Data\s*:?\s*&quot;, &quot;&quot;,&#xA;                          System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim().TrimEnd(',', ' ');&#xA;            idpText = System.Text.RegularExpressions.Regex.Replace(idpText, @&quot;^\s*IDP\s*Data\s*:?\s*&quot;, &quot;&quot;,&#xA;                          System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();&#xA;&#xA;            sb.Append(&quot;\nSAP: &quot;).Append(sapText);&#xA;            sb.Append(&quot;\nInvoice: &quot;).Append(idpText);&#xA;        }&#xA;        else&#xA;        {&#xA;            // detail exists but no separator found - show it as it is&#xA;            sb.Append(&quot;\nDetails: &quot;).Append(detail);&#xA;        }&#xA;    }&#xA;&#xA;    remarkCell.Value2 = sb.ToString();&#xA;&#xA;    // Bold the heading parts. Wrapped in try/catch because Excel can refuse&#xA;    // character-level formatting on very long cell text (beyond ~255 chars).&#xA;    foreach (int[] br in boldRanges)&#xA;    {&#xA;        try { remarkCell.Characters[br[0], br[1]].Font.Bold = true; }&#xA;        catch { /* skip bold for this heading, text is still correct */ }&#xA;    }&#xA;&#xA;    rowsWithRemark++;&#xA;}&#xA;Log(&quot;Remark column written. Rows with at least one remark: &quot; + rowsWithRemark);&#xA;&#xA;// =====================================================================&#xA;// ---- Remark is done. Now replace each red cell's long text with only ----&#xA;// ---- the reason keyword (e.g. &quot;Unmatched&quot;). Red color stays.        ----&#xA;// =====================================================================&#xA;foreach (Tuple&lt;int, int, string&gt; item in redCellsToShorten)&#xA;{&#xA;    sheet.Cells[item.Item1, item.Item2].Value2 = item.Item3;&#xA;}&#xA;Log(&quot;Red cells shortened to keyword only. Count: &quot; + redCellsToShorten.Count);&#xA;&#xA;// =====================================================================&#xA;// ---- Build the band row (ROW 1 ONLY): merged + centered           ----&#xA;// ---- A..X = &quot;SAP Data&quot; (light blue), rest = &quot;Validation Status&quot; (light gold) ----&#xA;// =====================================================================&#xA;int sapLast = Math.Min(SapLastCol, remarkCol);&#xA;&#xA;dynamic sapRange = sheet.Range[sheet.Cells[BandRow, 1], sheet.Cells[BandRow, sapLast]];&#xA;sapRange.Merge();&#xA;sapRange.Value2 = &quot;SAP Data&quot;;&#xA;sapRange.HorizontalAlignment = -4108; // xlCenter&#xA;sapRange.VerticalAlignment = -4108;   // xlCenter&#xA;sapRange.Interior.Color = ColorLightBlue;&#xA;Log(&quot;Band row: 'SAP Data' merged over columns 1 to &quot; + sapLast + &quot; (light blue).&quot;);&#xA;&#xA;dynamic validationRange = null;&#xA;if (sapLast &lt; remarkCol)&#xA;{&#xA;    validationRange = sheet.Range[sheet.Cells[BandRow, sapLast + 1], sheet.Cells[BandRow, remarkCol]];&#xA;    validationRange.Merge();&#xA;    validationRange.Value2 = &quot;Validation Status&quot;;&#xA;    validationRange.HorizontalAlignment = -4108; // xlCenter&#xA;    validationRange.VerticalAlignment = -4108;   // xlCenter&#xA;    validationRange.Interior.Color = ColorValidation;&#xA;    Log(&quot;Band row: 'Validation Status' merged over columns &quot; + (sapLast + 1) + &quot; to &quot; + remarkCol + &quot;.&quot;);&#xA;}&#xA;&#xA;// =====================================================================&#xA;// ---- Define the full data range (band + header + data + Remark) ----&#xA;// =====================================================================&#xA;dynamic fullRange = sheet.Range[sheet.Cells[BandRow, 1], sheet.Cells[lastRow, remarkCol]];&#xA;Log(&quot;Full data range: &quot; + fullRange.Address);&#xA;&#xA;// =====================================================================&#xA;// ---- Bold the band row and the header row ----&#xA;// =====================================================================&#xA;dynamic headerRange = sheet.Range[sheet.Cells[BandRow, 1], sheet.Cells[HeaderRow, remarkCol]];&#xA;headerRange.Font.Bold = true;&#xA;Log(&quot;Band row and header row set to bold.&quot;);&#xA;&#xA;// =====================================================================&#xA;// ---- Add borders to all sides of the full data range ----&#xA;// =====================================================================&#xA;// xlEdgeLeft=7, xlEdgeTop=8, xlEdgeBottom=9, xlEdgeRight=10, xlInsideVertical=11, xlInsideHorizontal=12&#xA;// xlContinuous=1, xlThin=2&#xA;int[] borderIndices = new int[] { 7, 8, 9, 10, 11, 12 };&#xA;foreach (int idx in borderIndices)&#xA;{&#xA;    dynamic borderEdge = fullRange.Borders[idx];&#xA;    borderEdge.LineStyle = 1;   // xlContinuous&#xA;    borderEdge.Weight = 2;      // xlThin&#xA;}&#xA;Log(&quot;Borders applied to all sides (outside + inside) of the data range.&quot;);&#xA;&#xA;// ==================================