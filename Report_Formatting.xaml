                <ui:InvokeCode ContinueOnError="{x:Null}" Code="Action&lt;string&gt; Log = (msg) =&gt;&#xD;&#xA;{&#xD;&#xA;    string line = DateTime.Now.ToString(&quot;HH:mm:ss&quot;) + &quot; - &quot; + msg;&#xD;&#xA;    Console.WriteLine(line);&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;Log(&quot;Process started.&quot;);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- CONFIG: which columns belong to &quot;SAP Data&quot;? ----&#xD;&#xA;// ---- Columns 1..SapLastCol  -&gt; &quot;SAP Data&quot; (light blue)           ----&#xD;&#xA;// ---- All columns after that -&gt; &quot;Validation Status&quot; (incl. Remark) ----&#xD;&#xA;// ---- Column numbers: A=1, B=2, C=3 ... L=12 ... X=24             ----&#xD;&#xA;// ---- &gt;&gt;&gt; CHANGE THIS NUMBER to match your sheet &lt;&lt;&lt;              ----&#xD;&#xA;// =====================================================================&#xD;&#xA;const int SapLastCol = 24;   // 24 = column X&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- CONFIG: the 3 title rows added above the table at the end ----&#xD;&#xA;// ---- (added on EVERY sheet of the workbook, all 3 lines BOLD)  ----&#xD;&#xA;// =====================================================================&#xD;&#xA;const string TitleLine1 = &quot;Ajanta Pharma Ltd&quot;;&#xD;&#xA;const string TitleLine2 = &quot;Andheri&quot;;&#xD;&#xA;const string TitleLine3Prefix = &quot;FB-60 Manual Parked Document Verified as on Date:  &quot;;   // + today's date dd-MM-yyyy&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- CONFIG: data type conversion + sorting (done BEFORE all formatting) ----&#xD;&#xA;// =====================================================================&#xD;&#xA;// Columns converted to NUMBER  (header name -&gt; Excel number format)&#xD;&#xA;Dictionary&lt;string, string&gt; numberColumns = new Dictionary&lt;string, string&gt;(StringComparer.OrdinalIgnoreCase)&#xD;&#xA;{&#xD;&#xA;    { &quot;Document Number&quot;, &quot;0&quot; },&#xD;&#xA;    { &quot;Profit Center&quot;,   &quot;0&quot; },&#xD;&#xA;    { &quot;Account&quot;,         &quot;0&quot; },&#xD;&#xA;    { &quot;Amount&quot;,          &quot;0.00&quot; },&#xD;&#xA;    { &quot;G/L Account&quot;,     &quot;0&quot; },&#xD;&#xA;    { &quot;Pending of Days&quot;, &quot;0&quot; },&#xD;&#xA;    { &quot;Days&quot;,            &quot;0&quot; },&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;// Columns converted to SHORT DATE&#xD;&#xA;string[] dateColumns = new string[] { &quot;Document Date&quot;, &quot;Posting Date&quot; };&#xD;&#xA;const string ShortDateFormat = &quot;dd-mm-yyyy&quot;;&#xD;&#xA;&#xD;&#xA;// Sort order: 1st = Posting Date, 2nd = Amount  (1 = ascending, 2 = descending)&#xD;&#xA;const string SortKey1Header = &quot;Posting Date&quot;;&#xD;&#xA;const string SortKey2Header = &quot;Amount&quot;;&#xD;&#xA;const int SortOrder1 = 1;&#xD;&#xA;const int SortOrder2 = 1;&#xD;&#xA;&#xD;&#xA;// Name of the extra sheet that holds the two summary tables&#xD;&#xA;const string SummarySheetName = &quot;Summary&quot;;&#xD;&#xA;&#xD;&#xA;// Text date patterns that are understood when a date column holds text&#xD;&#xA;string[] dateFormats = new string[]&#xD;&#xA;{&#xD;&#xA;    &quot;d.M.yyyy&quot;, &quot;d-M-yyyy&quot;, &quot;d/M/yyyy&quot;, &quot;yyyy-M-d&quot;, &quot;yyyy/M/d&quot;, &quot;d-MMM-yyyy&quot;, &quot;d MMM yyyy&quot;,&#xD;&#xA;    &quot;d.M.yyyy H:mm:ss&quot;, &quot;d-M-yyyy H:mm:ss&quot;, &quot;d/M/yyyy H:mm:ss&quot;, &quot;yyyy-M-d H:mm:ss&quot;&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;// Text -&gt; number. Returns the original value when it is not a number.&#xD;&#xA;// Handles thousand commas, spaces and SAP-style trailing minus (&quot;1,234.00-&quot;).&#xD;&#xA;Func&lt;object, object&gt; ToNumber = (rawVal) =&gt;&#xD;&#xA;{&#xD;&#xA;    if (rawVal == null || rawVal is double) return rawVal;&#xD;&#xA;&#xD;&#xA;    string txt = rawVal.ToString().Replace(&quot;\u00A0&quot;, &quot; &quot;).Trim();&#xD;&#xA;    if (txt.Length == 0) return rawVal;&#xD;&#xA;&#xD;&#xA;    bool isNeg = false;&#xD;&#xA;    if (txt.EndsWith(&quot;-&quot;))&#xD;&#xA;    {&#xD;&#xA;        isNeg = true;&#xD;&#xA;        txt = txt.Substring(0, txt.Length - 1).Trim();&#xD;&#xA;    }&#xD;&#xA;    txt = txt.Replace(&quot;,&quot;, &quot;&quot;);&#xD;&#xA;&#xD;&#xA;    double parsedNum;&#xD;&#xA;    if (double.TryParse(txt, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out parsedNum)&#xD;&#xA;        &amp;&amp; !double.IsNaN(parsedNum) &amp;&amp; !double.IsInfinity(parsedNum))&#xD;&#xA;    {&#xD;&#xA;        return isNeg ? -parsedNum : parsedNum;&#xD;&#xA;    }&#xD;&#xA;    return rawVal;&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;// Text -&gt; date serial number (Excel date). Returns the original value when it is not a date.&#xD;&#xA;Func&lt;object, object&gt; ToDate = (rawVal) =&gt;&#xD;&#xA;{&#xD;&#xA;    if (rawVal == null || rawVal is double) return rawVal;&#xD;&#xA;&#xD;&#xA;    string txt = rawVal.ToString().Replace(&quot;\u00A0&quot;, &quot; &quot;).Trim();&#xD;&#xA;    if (txt.Length == 0) return rawVal;&#xD;&#xA;&#xD;&#xA;    DateTime parsedDate;&#xD;&#xA;    if (DateTime.TryParseExact(txt, dateFormats, System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;                               System.Globalization.DateTimeStyles.None, out parsedDate))&#xD;&#xA;    {&#xD;&#xA;        return parsedDate.ToOADate();&#xD;&#xA;    }&#xD;&#xA;    return rawVal;&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Guard: does the file even exist? ----&#xD;&#xA;// =====================================================================&#xD;&#xA;Action&lt;string&gt; CheckFileExists = (path) =&gt;&#xD;&#xA;{&#xD;&#xA;    Log(&quot;Checking file path: &quot; + path);&#xD;&#xA;&#xD;&#xA;    if (!System.IO.File.Exists(path))&#xD;&#xA;    {&#xD;&#xA;        string dir = System.IO.Path.GetDirectoryName(path);&#xD;&#xA;        string nameOnly = System.IO.Path.GetFileNameWithoutExtension(path);&#xD;&#xA;&#xD;&#xA;        Log(&quot;ERROR: File does not exist at exact path: &quot; + path);&#xD;&#xA;&#xD;&#xA;        if (System.IO.Directory.Exists(dir))&#xD;&#xA;        {&#xD;&#xA;            var matches = System.IO.Directory.GetFiles(dir, nameOnly + &quot;.*&quot;);&#xD;&#xA;            if (matches.Length &gt; 0)&#xD;&#xA;                Log(&quot;HINT: Found a file with the same name but different extension: &quot; + matches[0]);&#xD;&#xA;            else&#xD;&#xA;                Log(&quot;HINT: No file starting with '&quot; + nameOnly + &quot;' found in folder: &quot; + dir);&#xD;&#xA;        }&#xD;&#xA;        else&#xD;&#xA;        {&#xD;&#xA;            Log(&quot;HINT: The folder itself doesn't exist: &quot; + dir);&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        throw new Exception(&quot;File not found: '&quot; + path + &quot;'. Check filename/extension — see log for hints.&quot;);&#xD;&#xA;    }&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;// ---- Guard: fail early if the file is already open elsewhere ----&#xD;&#xA;Action&lt;string&gt; CheckFileLock = (path) =&gt;&#xD;&#xA;{&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        System.IO.FileStream fs = System.IO.File.Open(path, System.IO.FileMode.Open, System.IO.FileAccess.ReadWrite, System.IO.FileShare.None);&#xD;&#xA;        fs.Close();&#xD;&#xA;        Log(&quot;File is accessible and not locked by another process: &quot; + path);&#xD;&#xA;    }&#xD;&#xA;    catch (System.IO.IOException ex)&#xD;&#xA;    {&#xD;&#xA;        Log(&quot;ERROR (&quot; + ex.GetType().Name + &quot;): &quot; + ex.Message + &quot; | Path checked: &quot; + path);&#xD;&#xA;        throw new Exception(&quot;File '&quot; + path + &quot;' is locked: &quot; + ex.Message);&#xD;&#xA;    }&#xD;&#xA;    catch (UnauthorizedAccessException ex)&#xD;&#xA;    {&#xD;&#xA;        Log(&quot;ERROR (UnauthorizedAccessException): &quot; + ex.Message + &quot; | Path checked: &quot; + path);&#xD;&#xA;        throw new Exception(&quot;Access denied to file '&quot; + path + &quot;': &quot; + ex.Message);&#xD;&#xA;    }&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;CheckFileExists(in_FilePath);&#xD;&#xA;CheckFileLock(in_FilePath);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Launch Excel ----&#xD;&#xA;// =====================================================================&#xD;&#xA;dynamic excelApp = Activator.CreateInstance(Type.GetTypeFromProgID(&quot;Excel.Application&quot;));&#xD;&#xA;excelApp.Visible = false;&#xD;&#xA;excelApp.DisplayAlerts = false;&#xD;&#xA;Log(&quot;Excel application launched.&quot;);&#xD;&#xA;&#xD;&#xA;dynamic wb = excelApp.Workbooks.Open(in_FilePath);&#xD;&#xA;Log(&quot;Opened file: &quot; + in_FilePath);&#xD;&#xA;&#xD;&#xA;dynamic sheet = wb.Sheets[1];&#xD;&#xA;Log(&quot;Using sheet: &quot; + sheet.Name);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Detect the layout (fresh file vs. re-run) ----&#xD;&#xA;// ---- Re-run: the 3 title rows from a previous run are removed first, ----&#xD;&#xA;// ---- so everything below sees the same layout as before.          ----&#xD;&#xA;// =====================================================================&#xD;&#xA;string topCellText = (sheet.Cells[1, 1].Value2 != null) ? sheet.Cells[1, 1].Value2.ToString().Trim() : &quot;&quot;;&#xD;&#xA;if (string.Equals(topCellText, TitleLine1, StringComparison.OrdinalIgnoreCase))&#xD;&#xA;{&#xD;&#xA;    sheet.Range[&quot;A1:A3&quot;].EntireRow.Delete();&#xD;&#xA;    Log(&quot;Existing title rows found at the top - removed (they are added again at the end).&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;string a1Text = (sheet.Cells[1, 1].Value2 != null) ? sheet.Cells[1, 1].Value2.ToString().Trim() : &quot;&quot;;&#xD;&#xA;bool bandRowExists = string.Equals(a1Text, &quot;SAP Data&quot;, StringComparison.OrdinalIgnoreCase)&#xD;&#xA;                  || string.Equals(a1Text, &quot;Validation Status&quot;, StringComparison.OrdinalIgnoreCase);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- STEP 0: change data types, sort, build Summary sheet (BEFORE any formatting) ----&#xD;&#xA;// ---- Fresh file : header is in row 1                               ----&#xD;&#xA;// ---- Re-run     : band row exists, header is in row 2              ----&#xD;&#xA;// =====================================================================&#xD;&#xA;int preHeaderRow = bandRowExists ? 2 : 1;&#xD;&#xA;&#xD;&#xA;dynamic preLastRowCell = sheet.Cells[sheet.Rows.Count, 1];&#xD;&#xA;int preLastRow = (int)preLastRowCell.End(-4162).Row; // xlUp&#xD;&#xA;&#xD;&#xA;dynamic preLastColCell = sheet.Cells[preHeaderRow, sheet.Columns.Count];&#xD;&#xA;int preLastCol = (int)preLastColCell.End(-4159).Column; // xlToLeft&#xD;&#xA;&#xD;&#xA;if (preLastRow &gt; preHeaderRow &amp;&amp; preLastCol &gt;= 1)&#xD;&#xA;{&#xD;&#xA;    // header name -&gt; column number&#xD;&#xA;    Dictionary&lt;string, int&gt; preHeaderMap = new Dictionary&lt;string, int&gt;(StringComparer.OrdinalIgnoreCase);&#xD;&#xA;    for (int hc = 1; hc &lt;= preLastCol; hc++)&#xD;&#xA;    {&#xD;&#xA;        object hv = sheet.Cells[preHeaderRow, hc].Value2;&#xD;&#xA;        string ht = (hv != null) ? hv.ToString().Trim() : &quot;&quot;;&#xD;&#xA;        if (ht.Length &gt; 0 &amp;&amp; !preHeaderMap.ContainsKey(ht))&#xD;&#xA;            preHeaderMap[ht] = hc;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // ---- 0a. Number columns ----&#xD;&#xA;    foreach (KeyValuePair&lt;string, string&gt; nc in numberColumns)&#xD;&#xA;    {&#xD;&#xA;        int ncCol;&#xD;&#xA;        if (!preHeaderMap.TryGetValue(nc.Key, out ncCol))&#xD;&#xA;        {&#xD;&#xA;            Log(&quot;WARNING: column '&quot; + nc.Key + &quot;' not found - number conversion skipped.&quot;);&#xD;&#xA;            continue;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        // Set the format FIRST (a text-formatted cell would keep a number as text)&#xD;&#xA;        dynamic ncRange = sheet.Range[sheet.Cells[preHeaderRow + 1, ncCol], sheet.Cells[preLastRow, ncCol]];&#xD;&#xA;        ncRange.NumberFormat = nc.Value;&#xD;&#xA;&#xD;&#xA;        int numConverted = 0;&#xD;&#xA;        for (int pr = preHeaderRow + 1; pr &lt;= preLastRow; pr++)&#xD;&#xA;        {&#xD;&#xA;            dynamic ncCell = sheet.Cells[pr, ncCol];&#xD;&#xA;            object raw = ncCell.Value2;&#xD;&#xA;            object num = ToNumber(raw);&#xD;&#xA;            if (!(raw is double) &amp;&amp; num is double)&#xD;&#xA;            {&#xD;&#xA;                ncCell.Value2 = num;&#xD;&#xA;                numConverted++;&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;        Log(&quot;Number format applied to '&quot; + nc.Key + &quot;' (col &quot; + ncCol + &quot;). Text converted to number: &quot; + numConverted);&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // ---- 0b. Short date columns ----&#xD;&#xA;    foreach (string dcName in dateColumns)&#xD;&#xA;    {&#xD;&#xA;        int dcCol;&#xD;&#xA;        if (!preHeaderMap.TryGetValue(dcName, out dcCol))&#xD;&#xA;        {&#xD;&#xA;            Log(&quot;WARNING: column '&quot; + dcName + &quot;' not found - date conversion skipped.&quot;);&#xD;&#xA;            continue;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        dynamic dcRange = sheet.Range[sheet.Cells[preHeaderRow + 1, dcCol], sheet.Cells[preLastRow, dcCol]];&#xD;&#xA;        dcRange.NumberFormat = ShortDateFormat;&#xD;&#xA;&#xD;&#xA;        int dateConverted = 0;&#xD;&#xA;        for (int dr = preHeaderRow + 1; dr &lt;= preLastRow; dr++)&#xD;&#xA;        {&#xD;&#xA;            dynamic dcCell = sheet.Cells[dr, dcCol];&#xD;&#xA;            object rawDate = dcCell.Value2;&#xD;&#xA;            object dateVal = ToDate(rawDate);&#xD;&#xA;            if (!(rawDate is double) &amp;&amp; dateVal is double)&#xD;&#xA;            {&#xD;&#xA;                dcCell.Value2 = dateVal;&#xD;&#xA;                dateConverted++;&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;        Log(&quot;Short date format applied to '&quot; + dcName + &quot;' (col &quot; + dcCol + &quot;). Text converted to date: &quot; + dateConverted);&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // ---- 0c. Sort: 1st Posting Date, 2nd Amount ----&#xD;&#xA;    int sortCol1;&#xD;&#xA;    int sortCol2;&#xD;&#xA;    bool hasSort1 = preHeaderMap.TryGetValue(SortKey1Header, out sortCol1);&#xD;&#xA;    bool hasSort2 = preHeaderMap.TryGetValue(SortKey2Header, out sortCol2);&#xD;&#xA;&#xD;&#xA;    if (!hasSort1) Log(&quot;WARNING: sort column '&quot; + SortKey1Header + &quot;' not found - it is skipped in the sort.&quot;);&#xD;&#xA;    if (!hasSort2) Log(&quot;WARNING: sort column '&quot; + SortKey2Header + &quot;' not found - it is skipped in the sort.&quot;);&#xD;&#xA;&#xD;&#xA;    if ((hasSort1 || hasSort2) &amp;&amp; preLastRow &gt; preHeaderRow + 1)&#xD;&#xA;    {&#xD;&#xA;        dynamic sortRange = sheet.Range[sheet.Cells[preHeaderRow, 1], sheet.Cells[preLastRow, preLastCol]];&#xD;&#xA;        dynamic sortObj = sheet.Sort;&#xD;&#xA;        sortObj.SortFields.Clear();&#xD;&#xA;&#xD;&#xA;        // SortFields.Add(Key, SortOn: 0 = xlSortOnValues, Order: 1 = xlAscending / 2 = xlDescending)&#xD;&#xA;        if (hasSort1)&#xD;&#xA;            sortObj.SortFields.Add(sheet.Range[sheet.Cells[preHeaderRow + 1, sortCol1], sheet.Cells[preLastRow, sortCol1]], 0, SortOrder1);&#xD;&#xA;        if (hasSort2)&#xD;&#xA;            sortObj.SortFields.Add(sheet.Range[sheet.Cells[preHeaderRow + 1, sortCol2], sheet.Cells[preLastRow, sortCol2]], 0, SortOrder2);&#xD;&#xA;&#xD;&#xA;        sortObj.SetRange(sortRange);&#xD;&#xA;        sortObj.Header = 1;          // xlYes - first row is the header&#xD;&#xA;        sortObj.MatchCase = false;&#xD;&#xA;        sortObj.Orientation = 1;     // xlTopToBottom&#xD;&#xA;        sortObj.Apply();&#xD;&#xA;&#xD;&#xA;        Log(&quot;Sorted by '&quot; + (hasSort1 ? SortKey1Header : &quot;-&quot;) + &quot;' then '&quot; + (hasSort2 ? SortKey2Header : &quot;-&quot;) + &quot;'.&quot;);&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // =================================================================&#xD;&#xA;    // ---- 0d. Build the &quot;Summary&quot; sheet                            ----&#xD;&#xA;    // ---- (after type change + sort, BEFORE any formatting)        ----&#xD;&#xA;    // ---- Table 1: Posting Status -&gt; Ready to Post (&quot;Posted&quot;) / Not Validate, with % ----&#xD;&#xA;    // ---- Table 2: one row per unique Vendor Name                  ----&#xD;&#xA;    // =================================================================&#xD;&#xA;    int sumStatusCol;&#xD;&#xA;    int sumVendorCol;&#xD;&#xA;    int sumAmountCol;&#xD;&#xA;    bool hasSumStatus = preHeaderMap.TryGetValue(&quot;Posting Status&quot;, out sumStatusCol);&#xD;&#xA;    bool hasSumVendor = preHeaderMap.TryGetValue(&quot;Vendor Name&quot;, out sumVendorCol);&#xD;&#xA;    bool hasSumAmount = preHeaderMap.TryGetValue(&quot;Amount&quot;, out sumAmountCol);&#xD;&#xA;&#xD;&#xA;    if (!hasSumStatus)&#xD;&#xA;    {&#xD;&#xA;        Log(&quot;WARNING: column 'Posting Status' not found - Summary sheet skipped.&quot;);&#xD;&#xA;    }&#xD;&#xA;    else&#xD;&#xA;    {&#xD;&#xA;        if (!hasSumVendor) Log(&quot;WARNING: column 'Vendor Name' not found - vendor table will be empty.&quot;);&#xD;&#xA;        if (!hasSumAmount) Log(&quot;WARNING: column 'Amount' not found - vendor values will be 0.&quot;);&#xD;&#xA;&#xD;&#xA;        // ---------- read the data and count ----------&#xD;&#xA;        int sumReady = 0;&#xD;&#xA;        int sumNotValid = 0;&#xD;&#xA;        int sumOther = 0;&#xD;&#xA;&#xD;&#xA;        List&lt;string&gt; sumVendors = new List&lt;string&gt;();   // unique vendors, in order of first appearance&#xD;&#xA;        Dictionary&lt;string, int&gt; sumVendorIdx = new Dictionary&lt;string, int&gt;(StringComparer.OrdinalIgnoreCase);&#xD;&#xA;        List&lt;int&gt; sumDocCnt = new List&lt;int&gt;();&#xD;&#xA;        List&lt;double&gt; sumValue = new List&lt;double&gt;();&#xD;&#xA;        List&lt;int&gt; sumMatched = new List&lt;int&gt;();&#xD;&#xA;        List&lt;int&gt; sumUnmatched = new List&lt;int&gt;();&#xD;&#xA;&#xD;&#xA;        for (int sr = preHeaderRow + 1; sr &lt;= preLastRow; sr++)&#xD;&#xA;        {&#xD;&#xA;            object stRaw = sheet.Cells[sr, sumStatusCol].Value2;&#xD;&#xA;            string stText = (stRaw != null) ? stRaw.ToString().Trim() : &quot;&quot;;&#xD;&#xA;            bool isReady = stText.StartsWith(&quot;Ready to Post&quot;, StringComparison.OrdinalIgnoreCase);&#xD;&#xA;            bool isNotValid = stText.StartsWith(&quot;Not Validate&quot;, StringComparison.OrdinalIgnoreCase);&#xD;&#xA;&#xD;&#xA;            if (isReady) sumReady++;&#xD;&#xA;            else if (isNotValid) sumNotValid++;&#xD;&#xA;            else sumOther++;&#xD;&#xA;&#xD;&#xA;            if (!hasSumVendor) continue;&#xD;&#xA;&#xD;&#xA;            object vnRaw = sheet.Cells[sr, sumVendorCol].Value2;&#xD;&#xA;            string vnText = (vnRaw != null) ? vnRaw.ToString().Trim() : &quot;&quot;;&#xD;&#xA;            if (vnText.Length == 0) continue;&#xD;&#xA;&#xD;&#xA;            int vi;&#xD;&#xA;            if (!sumVendorIdx.TryGetValue(vnText, out vi))&#xD;&#xA;            {&#xD;&#xA;                vi = sumVendors.Count;&#xD;&#xA;                sumVendorIdx[vnText] = vi;&#xD;&#xA;                sumVendors.Add(vnText);&#xD;&#xA;                sumDocCnt.Add(0);&#xD;&#xA;                sumValue.Add(0.0);&#xD;&#xA;                sumMatched.Add(0);&#xD;&#xA;                sumUnmatched.Add(0);&#xD;&#xA;            }&#xD;&#xA;&#xD;&#xA;            sumDocCnt[vi] = sumDocCnt[vi] + 1;&#xD;&#xA;            if (isReady) sumMatched[vi] = sumMatched[vi] + 1;&#xD;&#xA;            if (isNotValid) sumUnmatched[vi] = sumUnmatched[vi] + 1;&#xD;&#xA;&#xD;&#xA;            if (hasSumAmount)&#xD;&#xA;            {&#xD;&#xA;                object amRaw = sheet.Cells[sr, sumAmountCol].Value2;&#xD;&#xA;                object amNum = ToNumber(amRaw);&#xD;&#xA;                if (amNum is double) sumValue[vi] = sumValue[vi] + (double)amNum;&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        int sumTotal = sumReady + sumNotValid;   // Total = Ready to Post + Not Validate&#xD;&#xA;        double readyPct = (sumTotal == 0) ? 0.0 : (double)sumReady / sumTotal;&#xD;&#xA;        double notValidPct = (sumTotal == 0) ? 0.0 : (double)sumNotValid / sumTotal;&#xD;&#xA;        double totalPct = (sumTotal == 0) ? 0.0 : 1.0;&#xD;&#xA;&#xD;&#xA;        Log(&quot;Summary counts - Ready to Post: &quot; + sumReady + &quot;, Not Validate: &quot; + sumNotValid&#xD;&#xA;            + &quot;, other/blank status (not counted): &quot; + sumOther + &quot;, unique vendors: &quot; + sumVendors.Count);&#xD;&#xA;&#xD;&#xA;        // ---------- remove an old Summary sheet (re-run), then add a fresh one after the data sheet ----------&#xD;&#xA;        int sheetCountNow = (int)wb.Sheets.Count;&#xD;&#xA;        for (int si = sheetCountNow; si &gt;= 1; si--)&#xD;&#xA;        {&#xD;&#xA;            dynamic wsCheck = wb.Sheets[si];&#xD;&#xA;            if (string.Equals((string)wsCheck.Name, SummarySheetName, StringComparison.OrdinalIgnoreCase))&#xD;&#xA;            {&#xD;&#xA;                wsCheck.Delete();&#xD;&#xA;                Log(&quot;Old '&quot; + SummarySheetName + &quot;' sheet removed (it is rebuilt).&quot;);&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        dynamic sumSheet = wb.Sheets.Add(Type.Missing, wb.Sheets[wb.Sheets.Count]);&#xD;&#xA;        sumSheet.Name = SummarySheetName;&#xD;&#xA;&#xD;&#xA;        // ---------- colors (Excel Color = R + G*256 + B*65536) ----------&#xD;&#xA;        int sumNavy = 6567967;      // RGB(31, 56, 100)  - dark blue header fill / &quot;Checked By Vendor Report&quot; text&#xD;&#xA;        int sumWhite = 16777215;    // RGB(255, 255, 255) - header text&#xD;&#xA;        int sumGreenText = 5287936; // RGB(0, 176, 80)   - &quot;Ready to Post&quot;&#xD;&#xA;        int sumRedText = 192;       // RGB(192, 0, 0)    - &quot;Not Validate&quot;&#xD;&#xA;&#xD;&#xA;        // header style: navy fill, white bold text, centered, wrapped&#xD;&#xA;        Action&lt;dynamic&gt; StyleSummaryHeader = (hdr) =&gt;&#xD;&#xA;        {&#xD;&#xA;            hdr.Interior.Color = sumNavy;&#xD;&#xA;            hdr.Font.Color = sumWhite;&#xD;&#xA;            hdr.Font.Bold = true;&#xD;&#xA;            hdr.HorizontalAlignment = -4108; // xlCenter&#xD;&#xA;            hdr.VerticalAlignment = -4108;   // xlCenter&#xD;&#xA;            hdr.WrapText = true;&#xD;&#xA;        };&#xD;&#xA;&#xD;&#xA;        // thin borders on every edge and inside line of a range&#xD;&#xA;        Action&lt;dynamic&gt; AddSummaryBorders = (brdRange) =&gt;&#xD;&#xA;        {&#xD;&#xA;            foreach (int bi in new int[] { 7, 8, 9, 10, 11, 12 })&#xD;&#xA;            {&#xD;&#xA;                dynamic brdEdge = brdRange.Borders[bi];&#xD;&#xA;                brdEdge.LineStyle = 1;  // xlContinuous&#xD;&#xA;                brdEdge.Weight = 2;     // xlThin&#xD;&#xA;            }&#xD;&#xA;        };&#xD;&#xA;&#xD;&#xA;        // column widths (Vendor / Verdict column is wide, like the template)&#xD;&#xA;        sumSheet.Range[&quot;A1&quot;].EntireColumn.ColumnWidth = 60;&#xD;&#xA;        sumSheet.Range[&quot;B1&quot;].EntireColumn.ColumnWidth = 20;&#xD;&#xA;        sumSheet.Range[&quot;C1&quot;].EntireColumn.ColumnWidth = 16;&#xD;&#xA;        sumSheet.Range[&quot;D1&quot;].EntireColumn.ColumnWidth = 16;&#xD;&#xA;        sumSheet.Range[&quot;E1&quot;].EntireColumn.ColumnWidth = 16;&#xD;&#xA;&#xD;&#xA;        // ---------- title ----------&#xD;&#xA;        sumSheet.Cells[1, 1].Value2 = &quot;Invoice Verification \u2013 Summary&quot;;&#xD;&#xA;        sumSheet.Cells[1, 1].Font.Bold = true;&#xD;&#xA;&#xD;&#xA;        // ---------- TABLE 1 (rows 3-6): Verdict | Documents Count | % ----------&#xD;&#xA;        sumSheet.Cells[3, 1].Value2 = &quot;Verdict&quot;;&#xD;&#xA;        sumSheet.Cells[3, 2].Value2 = &quot;Documents Count&quot;;&#xD;&#xA;        sumSheet.Cells[3, 3].Value2 = &quot;%&quot;;&#xD;&#xA;&#xD;&#xA;        sumSheet.Cells[4, 1].Value2 = &quot;Ready to Post&quot;;&#xD;&#xA;        sumSheet.Cells[4, 2].Value2 = sumReady;&#xD;&#xA;        sumSheet.Cells[4, 3].Value2 = readyPct;&#xD;&#xA;&#xD;&#xA;        sumSheet.Cells[5, 1].Value2 = &quot;Not Validate&quot;;&#xD;&#xA;        sumSheet.Cells[5, 2].Value2 = sumNotValid;&#xD;&#xA;        sumSheet.Cells[5, 3].Value2 = notValidPct;&#xD;&#xA;&#xD;&#xA;        sumSheet.Cells[6, 1].Value2 = &quot;Total&quot;;&#xD;&#xA;        sumSheet.Cells[6, 2].Value2 = sumTotal;&#xD;&#xA;        sumSheet.Cells[6, 3].Value2 = totalPct;&#xD;&#xA;&#xD;&#xA;        dynamic t1Header = sumSheet.Range[sumSheet.Cells[3, 1], sumSheet.Cells[3, 3]];&#xD;&#xA;        StyleSummaryHeader(t1Header);&#xD;&#xA;        t1Header.EntireRow.RowHeight = 30;&#xD;&#xA;&#xD;&#xA;        sumSheet.Cells[4, 1].Font.Color = sumGreenText;&#xD;&#xA;        sumSheet.Cells[4, 1].Font.Bold = true;&#xD;&#xA;        sumSheet.Cells[5, 1].Font.Color = sumRedText;&#xD;&#xA;        sumSheet.Cells[5, 1].Font.Bold = true;&#xD;&#xA;        dynamic t1TotalRow = sumSheet.Range[sumSheet.Cells[6, 1], sumSheet.Cells[6, 3]];&#xD;&#xA;        t1TotalRow.Font.Bold = true;&#xD;&#xA;&#xD;&#xA;        sumSheet.Range[sumSheet.Cells[4, 2], sumSheet.Cells[6, 2]].NumberFormat = &quot;0&quot;;&#xD;&#xA;        sumSheet.Range[sumSheet.Cells[4, 3], sumSheet.Cells[6, 3]].NumberFormat = &quot;0.0%;-0.0%;\&quot;-\&quot;&quot;;&#xD;&#xA;&#xD;&#xA;        dynamic t1All = sumSheet.Range[sumSheet.Cells[3, 1], sumSheet.Cells[6, 3]];&#xD;&#xA;        AddSummaryBorders(t1All);&#xD;&#xA;&#xD;&#xA;        // ---------- TABLE 2 (header row 9, data from row 10) ----------&#xD;&#xA;        const int T2Header = 9;&#xD;&#xA;        const int T2First = 10;&#xD;&#xA;&#xD;&#xA;        sumSheet.Cells[8, 1].Value2 = &quot;Checked By Vendor Report&quot;;&#xD;&#xA;        sumSheet.Cells[8, 1].Font.Bold = true;&#xD;&#xA;        sumSheet.Cells[8, 1].Font.Color = sumNavy;&#xD;&#xA;&#xD;&#xA;        string[] t2Heads = new string[] { &quot;Vendor&quot;, &quot;Doc counts&quot;, &quot;Value (INR)&quot;, &quot;Matched doc count&quot;, &quot;Unmatched doc count&quot; };&#xD;&#xA;        for (int hi = 0; hi &lt; t2Heads.Length; hi++)&#xD;&#xA;            sumSheet.Cells[T2Header, hi + 1].Value2 = t2Heads[hi];&#xD;&#xA;&#xD;&#xA;        for (int vr = 0; vr &lt; sumVendors.Count; vr++)&#xD;&#xA;        {&#xD;&#xA;            int xr = T2First + vr;&#xD;&#xA;            sumSheet.Cells[xr, 1].Value2 = sumVendors[vr];&#xD;&#xA;            sumSheet.Cells[xr, 2].Value2 = sumDocCnt[vr];&#xD;&#xA;            sumSheet.Cells[xr, 3].Value2 = Math.Round(sumValue[vr], 2);&#xD;&#xA;            sumSheet.Cells[xr, 4].Value2 = sumMatched[vr];&#xD;&#xA;            sumSheet.Cells[xr, 5].Value2 = sumUnmatched[vr];&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        dynamic t2Header = sumSheet.Range[sumSheet.Cells[T2Header, 1], sumSheet.Cells[T2Header, 5]];&#xD;&#xA;        StyleSummaryHeader(t2Header);&#xD;&#xA;        t2Header.EntireRow.RowHeight = 32;&#xD;&#xA;&#xD;&#xA;        int t2Last = T2Header + sumVendors.Count;   // last row of table 2 (= header row when there are no vendors)&#xD;&#xA;        if (sumVendors.Count &gt; 0)&#xD;&#xA;        {&#xD;&#xA;            sumSheet.Range[sumSheet.Cells[T2First, 2], sumSheet.Cells[t2Last, 2]].NumberFormat = &quot;0&quot;;&#xD;&#xA;            sumSheet.Range[sumSheet.Cells[T2First, 3], sumSheet.Cells[t2Last, 3]].NumberFormat = &quot;0.00&quot;;&#xD;&#xA;            sumSheet.Range[sumSheet.Cells[T2First, 4], sumSheet.Cells[t2Last, 5]].NumberFormat = &quot;0&quot;;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        dynamic t2All = sumSheet.Range[sumSheet.Cells[T2Header, 1], sumSheet.Cells[t2Last, 5]];&#xD;&#xA;        AddSummaryBorders(t2All);&#xD;&#xA;&#xD;&#xA;        // hide gridlines on the Summary sheet (cosmetic - ignored if Excel refuses)&#xD;&#xA;        try&#xD;&#xA;        {&#xD;&#xA;            sumSheet.Activate();&#xD;&#xA;            excelApp.ActiveWindow.DisplayGridlines = false;&#xD;&#xA;        }&#xD;&#xA;        catch { /* not critical */ }&#xD;&#xA;&#xD;&#xA;        Log(&quot;'&quot; + SummarySheetName + &quot;' sheet created: 3 rows in table 1, &quot; + sumVendors.Count + &quot; vendor rows in table 2.&quot;);&#xD;&#xA;&#xD;&#xA;        System.Runtime.InteropServices.Marshal.ReleaseComObject(sumSheet);&#xD;&#xA;&#xD;&#xA;        // go back to the data sheet so the file opens on it&#xD;&#xA;        sheet.Activate();&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;else&#xD;&#xA;{&#xD;&#xA;    Log(&quot;Step 0 skipped: no data rows found for type conversion / sorting.&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Make room for the &quot;SAP Data / Validation Status&quot; band row (row 1) ----&#xD;&#xA;// ---- First run : insert a new row at the top, header moves to row 2 ----&#xD;&#xA;// ---- Re-run    : band row already exists, just un-merge and reuse it ----&#xD;&#xA;// =====================================================================&#xD;&#xA;dynamic bandRowBeforeInsert = sheet.Range[sheet.Cells[1, 1], sheet.Cells[1, 1]].EntireRow;&#xD;&#xA;&#xD;&#xA;if (bandRowExists)&#xD;&#xA;{&#xD;&#xA;    bandRowBeforeInsert.UnMerge();&#xD;&#xA;    Log(&quot;Existing band row found in row 1 - it will be rebuilt.&quot;);&#xD;&#xA;}&#xD;&#xA;else&#xD;&#xA;{&#xD;&#xA;    bandRowBeforeInsert.Insert(); // shifts everything down by one row&#xD;&#xA;    Log(&quot;New band row inserted at row 1.&quot;);&#xD;&#xA;}&#xD;&#xA;// IMPORTANT: after Insert(), the old range object follows the moved cells (it now&#xD;&#xA;// points at the header row, which is row 2). Take a FRESH reference to row 1&#xD;&#xA;// before clearing, otherwise the header row would be wiped.&#xD;&#xA;dynamic bandRowEntire = sheet.Range[sheet.Cells[1, 1], sheet.Cells[1, 1]].EntireRow;&#xD;&#xA;bandRowEntire.ClearContents();&#xD;&#xA;bandRowEntire.ClearFormats();&#xD;&#xA;&#xD;&#xA;const int BandRow   = 1;   // &quot;SAP Data&quot; / &quot;Validation Status&quot;  (moves to row 4 at the very end)&#xD;&#xA;const int HeaderRow = 2;   // column headers                    (moves to row 5 at the very end)&#xD;&#xA;const int FirstDataRow = 3;&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Find used range (last row / last column) ----&#xD;&#xA;// =====================================================================&#xD;&#xA;dynamic lastCellRow = sheet.Cells[sheet.Rows.Count, 1];&#xD;&#xA;int lastRow = (int)lastCellRow.End(-4162).Row; // xlUp&#xD;&#xA;&#xD;&#xA;dynamic lastCellCol = sheet.Cells[HeaderRow, sheet.Columns.Count];&#xD;&#xA;int lastCol = (int)lastCellCol.End(-4159).Column; // xlToLeft&#xD;&#xA;&#xD;&#xA;Log(&quot;Sheet has &quot; + lastRow + &quot; rows (incl. band + header) and &quot; + lastCol + &quot; columns.&quot;);&#xD;&#xA;&#xD;&#xA;if (lastRow &lt; FirstDataRow || lastCol &lt; 1)&#xD;&#xA;    throw new Exception(&quot;Sheet has no data rows — nothing to format.&quot;);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Decide where the &quot;Remark&quot; column goes ----&#xD;&#xA;// ---- If the file was already processed (last header is &quot;Remark&quot;), ----&#xD;&#xA;// ---- reuse that column instead of adding a second one.           ----&#xD;&#xA;// =====================================================================&#xD;&#xA;const string RemarkHeader = &quot;Remark&quot;;&#xD;&#xA;&#xD;&#xA;string lastHeaderText = (sheet.Cells[HeaderRow, lastCol].Value2 != null) ? sheet.Cells[HeaderRow, lastCol].Value2.ToString().Trim() : &quot;&quot;;&#xD;&#xA;&#xD;&#xA;int dataLastCol;   // last column that holds real data (excludes Remark)&#xD;&#xA;int remarkCol;     // column where Remark is written&#xD;&#xA;&#xD;&#xA;if (string.Equals(lastHeaderText, RemarkHeader, StringComparison.OrdinalIgnoreCase))&#xD;&#xA;{&#xD;&#xA;    remarkCol = lastCol;&#xD;&#xA;    dataLastCol = lastCol - 1;&#xD;&#xA;    Log(&quot;Existing 'Remark' column found at col &quot; + remarkCol + &quot; - it will be overwritten.&quot;);&#xD;&#xA;}&#xD;&#xA;else&#xD;&#xA;{&#xD;&#xA;    dataLastCol = lastCol;&#xD;&#xA;    remarkCol = lastCol + 1;&#xD;&#xA;    Log(&quot;'Remark' column will be added at col &quot; + remarkCol + &quot;.&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Red / Green status highlighting based on column header ----&#xD;&#xA;// ---- (negative keyword -&gt; Red, everything else -&gt; Green)        ----&#xD;&#xA;// =====================================================================&#xD;&#xA;// Excel Color values are computed as R + (G*256) + (B*65536)&#xD;&#xA;// Faint/pastel shades (Excel's standard &quot;Bad&quot;/&quot;Good&quot; conditional-format colors)&#xD;&#xA;int ColorRed   = 13551615; // RGB(255, 199, 206) -- faint red&#xD;&#xA;int ColorGreen = 13561798; // RGB(198, 239, 206) -- faint green&#xD;&#xA;int ColorLightBlue = 15652797; // RGB(189, 215, 238) -- light blue for &quot;SAP Data&quot;&#xD;&#xA;int ColorValidation = 10086143; // RGB(255, 230, 153) -- light gold for &quot;Validation Status&quot;&#xD;&#xA;&#xD;&#xA;// Negative keyword(s) per column header. A cell is treated as NEGATIVE (red)&#xD;&#xA;// when its text STARTS WITH any listed keyword (case-insensitive), e.g.&#xD;&#xA;//   &quot;Unmatched&quot;&#xD;&#xA;//   &quot;UnmatchedTrinity Synergy 154, ...||Trinity Packaging Co Pvt Ltd.&quot;&#xD;&#xA;// Anything else that is non-blank is treated as positive (green).&#xD;&#xA;Dictionary&lt;string, string[]&gt; negativeValuesByHeader = new Dictionary&lt;string, string[]&gt;(StringComparer.OrdinalIgnoreCase)&#xD;&#xA;{&#xD;&#xA;    { &quot;Posting Status&quot;,                      new [] { &quot;Not Validate&quot; } },&#xD;&#xA;    { &quot;Email attachment Status&quot;,             new [] { &quot;Email Not attached&quot; } },&#xD;&#xA;    { &quot;Invoice attachment Status&quot;,           new [] { &quot;Invoice not attached&quot;, &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Vendor Name Status&quot;,                  new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Vendor Address&quot;,                      new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Ajanta GSTIN&quot;,                        new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Invoice Number/GSTN Bill No.&quot;,        new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Invoice Date&quot;,                        new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Currency&quot;,                            new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Bus Place/Sectn.&quot;,                    new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Bank Details&quot;,                        new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Invoice Basic Value&quot;,                 new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;GST Value&quot;,                           new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Tax Code Status&quot;,                     new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Gross Invoice Value&quot;,                 new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;TDS Code Status&quot;,                     new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Payment Block Status&quot;,                new [] { &quot;Block&quot; } },&#xD;&#xA;    { &quot;Document Number Status&quot;,              new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Document Number Approval&quot;,            new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Delay Bill submission Status&quot;,        new [] { &quot;Delay&quot; } },&#xD;&#xA;    { &quot;Text (Document Header)&quot;,              new [] { &quot;Text Not Available&quot; } },&#xD;&#xA;    { &quot;Text GL&quot;,                             new [] { &quot;Text Not Available&quot; } },&#xD;&#xA;    { &quot;Payment TDS (WHT) Status&quot;,            new [] { &quot;Not Selected&quot; } },&#xD;&#xA;    { &quot;BL Copy Status&quot;,                      new [] { &quot;Not Attached&quot; } },&#xD;&#xA;    { &quot;BL Number &amp; Shipper Name&quot;,            new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Vendor GSTIN&quot;,                        new [] { &quot;Unmatched&quot; } },&#xD;&#xA;    { &quot;Ajanta Address&quot;,                      new [] { &quot;Unmatched&quot; } },&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;// Columns that should simply be filled green for every populated cell,&#xD;&#xA;// with no red/negative condition at all.&#xD;&#xA;HashSet&lt;string&gt; alwaysGreenHeaders = new HashSet&lt;string&gt;(StringComparer.OrdinalIgnoreCase)&#xD;&#xA;{&#xD;&#xA;    &quot;Profit Center Status&quot;,&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;// Columns that are still colored red/green (and shortened) but must NOT be&#xD;&#xA;// written into the Remark column. Add more header names here if needed.&#xD;&#xA;HashSet&lt;string&gt; excludeFromRemark = new HashSet&lt;string&gt;(StringComparer.OrdinalIgnoreCase)&#xD;&#xA;{&#xD;&#xA;    &quot;Posting Status&quot;,&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;// One list per row: collects one entry per red cell in that row.&#xD;&#xA;// Tuple = (column header, matched keyword e.g. &quot;Unmatched&quot;, detail text after the keyword)&#xD;&#xA;List&lt;Tuple&lt;string, string, string&gt;&gt;[] rowRemarks = new List&lt;Tuple&lt;string, string, string&gt;&gt;[lastRow + 1];&#xD;&#xA;for (int r = FirstDataRow; r &lt;= lastRow; r++)&#xD;&#xA;    rowRemarks[r] = new List&lt;Tuple&lt;string, string, string&gt;&gt;();&#xD;&#xA;&#xD;&#xA;// Remembers every red cell so we can shorten its text AFTER the Remark column is written.&#xD;&#xA;// Tuple = (row, col, shortText)&#xD;&#xA;List&lt;Tuple&lt;int, int, string&gt;&gt; redCellsToShorten = new List&lt;Tuple&lt;int, int, string&gt;&gt;();&#xD;&#xA;&#xD;&#xA;for (int col = 1; col &lt;= dataLastCol; col++)&#xD;&#xA;{&#xD;&#xA;    dynamic headerCell = sheet.Cells[HeaderRow, col];&#xD;&#xA;    string headerText = (headerCell.Value2 != null) ? headerCell.Value2.ToString().Trim() : &quot;&quot;;&#xD;&#xA;&#xD;&#xA;    string[] negativeValues;&#xD;&#xA;    bool isKnownStatusColumn = negativeValuesByHeader.TryGetValue(headerText, out negativeValues);&#xD;&#xA;    bool isAlwaysGreenColumn = alwaysGreenHeaders.Contains(headerText);&#xD;&#xA;&#xD;&#xA;    if (!isKnownStatusColumn &amp;&amp; !isAlwaysGreenColumn)&#xD;&#xA;    {&#xD;&#xA;        // Column header not in the known status list — skip coloring it.&#xD;&#xA;        continue;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    for (int row = FirstDataRow; row &lt;= lastRow; row++)&#xD;&#xA;    {&#xD;&#xA;        dynamic dataCell = sheet.Cells[row, col];&#xD;&#xA;        string cellText = (dataCell.Value2 != null) ? dataCell.Value2.ToString().Trim() : &quot;&quot;;&#xD;&#xA;&#xD;&#xA;        if (cellText.Length == 0)&#xD;&#xA;            continue; // leave blanks unformatted&#xD;&#xA;&#xD;&#xA;        if (isAlwaysGreenColumn)&#xD;&#xA;        {&#xD;&#xA;            dataCell.Interior.Color = ColorGreen;&#xD;&#xA;            continue;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        bool isNegative = false;&#xD;&#xA;        string matchedKeyword = &quot;&quot;;&#xD;&#xA;&#xD;&#xA;        foreach (string negVal in negativeValues)&#xD;&#xA;        {&#xD;&#xA;            // StartsWith: catches &quot;Unmatched&quot; AND &quot;UnmatchedTrinity Synergy 154, ...&quot;&#xD;&#xA;            if (cellText.StartsWith(negVal, StringComparison.OrdinalIgnoreCase))&#xD;&#xA;            {&#xD;&#xA;                isNegative = true;&#xD;&#xA;                // keep the text exactly as it appears in the cell (original casing)&#xD;&#xA;                matchedKeyword = cellText.Substring(0, negVal.Length);&#xD;&#xA;                break;&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        dataCell.Interior.Color = isNegative ? ColorRed : ColorGreen;&#xD;&#xA;&#xD;&#xA;        if (isNegative)&#xD;&#xA;        {&#xD;&#xA;            // Everything after the keyword = the SAP vs IDP detail (may be empty)&#xD;&#xA;            string detail = cellText.Substring(matchedKeyword.Length).Trim();&#xD;&#xA;&#xD;&#xA;            // Excluded columns (e.g. Posting Status) do not go into the Remark column&#xD;&#xA;            if (!excludeFromRemark.Contains(headerText))&#xD;&#xA;                rowRemarks[row].Add(Tuple.Create(headerText, matchedKeyword, detail));&#xD;&#xA;&#xD;&#xA;            // Short text will replace the cell value after Remark is written&#xD;&#xA;            redCellsToShorten.Add(Tuple.Create(row, col, matchedKeyword));&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    Log(&quot;Applied highlighting to column '&quot; + headerText + &quot;' (col &quot; + col + &quot;).&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Write the &quot;Remark&quot; column ----&#xD;&#xA;// ---- One block per red cell, blank line between blocks:          ----&#xD;&#xA;// ----                                                             ----&#xD;&#xA;// ----   Vendor Name Mismatch:        (bold)                       ----&#xD;&#xA;// ----   SAP: Trinity Synergy                                      ----&#xD;&#xA;// ----   Invoice: Trinity Packaging Co Pvt Ltd.                    ----&#xD;&#xA;// ----                                                             ----&#xD;&#xA;// ---- Detail text is split at the first &quot;||&quot;, &quot;VSIDPData&quot; or &quot; VS &quot; ----&#xD;&#xA;// ---- Left part = SAP value, right part = Invoice (IDP) value.    ----&#xD;&#xA;// ---- If a red cell has no detail (e.g. &quot;Unmatched&quot; only) the block is: ----&#xD;&#xA;// ----   Approved By status: Unmatched   (header part bold)        ----&#xD;&#xA;// =====================================================================&#xD;&#xA;System.Text.RegularExpressions.Regex sepRegex =&#xD;&#xA;    new System.Text.RegularExpressions.Regex(@&quot;\|\||VS\s*IDP\s*Data\s*:?|\sVS\s&quot;);&#xD;&#xA;&#xD;&#xA;sheet.Cells[HeaderRow, remarkCol].Value2 = RemarkHeader;&#xD;&#xA;&#xD;&#xA;const int RemarkHeadingNavy = 6567967;   // RGB(31, 56, 100) - navy blue for the bold Remark headings&#xD;&#xA;&#xD;&#xA;int rowsWithRemark = 0;&#xD;&#xA;for (int row = FirstDataRow; row &lt;= lastRow; row++)&#xD;&#xA;{&#xD;&#xA;    dynamic remarkCell = sheet.Cells[row, remarkCol];&#xD;&#xA;    remarkCell.Font.Bold = false; // reset any old bold from a previous run&#xD;&#xA;    remarkCell.Font.Color = 0;    // reset any old heading color (black) from a previous run&#xD;&#xA;    List&lt;Tuple&lt;string, string, string&gt;&gt; points = rowRemarks[row];&#xD;&#xA;&#xD;&#xA;    if (points.Count == 0)&#xD;&#xA;    {&#xD;&#xA;        remarkCell.Value2 = null; // clear any old remark (useful on re-runs)&#xD;&#xA;        continue;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    System.Text.StringBuilder sb = new System.Text.StringBuilder();&#xD;&#xA;    List&lt;int[]&gt; boldRanges = new List&lt;int[]&gt;(); // (start 1-based, length)&#xD;&#xA;&#xD;&#xA;    foreach (Tuple&lt;string, string, string&gt; p in points)&#xD;&#xA;    {&#xD;&#xA;        string header  = p.Item1;&#xD;&#xA;        string keyword = p.Item2;&#xD;&#xA;        string detail  = p.Item3;&#xD;&#xA;&#xD;&#xA;        if (sb.Length &gt; 0)&#xD;&#xA;            sb.Append(&quot;\n\n&quot;);&#xD;&#xA;&#xD;&#xA;        if (detail.Length == 0)&#xD;&#xA;        {&#xD;&#xA;            // No SAP/IDP detail - just &quot;Header: Status&quot;&#xD;&#xA;            string heading = header + &quot;:&quot;;&#xD;&#xA;            boldRanges.Add(new int[] { sb.Length + 1, heading.Length });&#xD;&#xA;            sb.Append(heading).Append(&quot; &quot;).Append(keyword);&#xD;&#xA;            continue;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        // Heading name: drop a trailing &quot; Status&quot; so &quot;Vendor Name Status&quot; -&gt; &quot;Vendor Name Mismatch:&quot;&#xD;&#xA;        string baseName = header;&#xD;&#xA;        if (baseName.EndsWith(&quot; Status&quot;, StringComparison.OrdinalIgnoreCase))&#xD;&#xA;            baseName = baseName.Substring(0, baseName.Length - 7).Trim();&#xD;&#xA;&#xD;&#xA;        string mismatchHeading = baseName + &quot; Mismatch:&quot;;&#xD;&#xA;        boldRanges.Add(new int[] { sb.Length + 1, mismatchHeading.Length });&#xD;&#xA;        sb.Append(mismatchHeading);&#xD;&#xA;&#xD;&#xA;        System.Text.RegularExpressions.Match m = sepRegex.Match(detail);&#xD;&#xA;        if (m.Success)&#xD;&#xA;        {&#xD;&#xA;            string sapText = detail.Substring(0, m.Index);&#xD;&#xA;            string idpText = detail.Substring(m.Index + m.Length);&#xD;&#xA;&#xD;&#xA;            // remove a leading &quot;SAPData:&quot; / &quot;IDPData:&quot; label if present&#xD;&#xA;            sapText = System.Text.RegularExpressions.Regex.Replace(sapText, @&quot;^\s*SAP\s*Data\s*:?\s*&quot;, &quot;&quot;,&#xD;&#xA;                          System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim().TrimEnd(',', ' ');&#xD;&#xA;            idpText = System.Text.RegularExpressions.Regex.Replace(idpText, @&quot;^\s*IDP\s*Data\s*:?\s*&quot;, &quot;&quot;,&#xD;&#xA;                          System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();&#xD;&#xA;&#xD;&#xA;            sb.Append(&quot;\nSAP: &quot;).Append(sapText);&#xD;&#xA;            sb.Append(&quot;\nInvoice: &quot;).Append(idpText);&#xD;&#xA;        }&#xD;&#xA;        else&#xD;&#xA;        {&#xD;&#xA;            // detail exists but no separator found - show it as it is&#xD;&#xA;            sb.Append(&quot;\nDetails: &quot;).Append(detail);&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    remarkCell.Value2 = sb.ToString();&#xD;&#xA;&#xD;&#xA;    // Bold the heading parts. Wrapped in try/catch because Excel can refuse&#xD;&#xA;    // character-level formatting on very long cell text (beyond ~255 chars).&#xD;&#xA;    foreach (int[] br in boldRanges)&#xD;&#xA;    {&#xD;&#xA;        try&#xD;&#xA;        {&#xD;&#xA;            remarkCell.Characters[br[0], br[1]].Font.Bold = true;&#xD;&#xA;            remarkCell.Characters[br[0], br[1]].Font.Color = RemarkHeadingNavy;   // navy blue heading&#xD;&#xA;        }&#xD;&#xA;        catch { /* skip bold/color for this heading, text is still correct */ }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    rowsWithRemark++;&#xD;&#xA;}&#xD;&#xA;Log(&quot;Remark column written. Rows with at least one remark: &quot; + rowsWithRemark);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Remark is done. Now replace each red cell's long text with only ----&#xD;&#xA;// ---- the reason keyword (e.g. &quot;Unmatched&quot;). Red color stays.        ----&#xD;&#xA;// =====================================================================&#xD;&#xA;foreach (Tuple&lt;int, int, string&gt; item in redCellsToShorten)&#xD;&#xA;{&#xD;&#xA;    sheet.Cells[item.Item1, item.Item2].Value2 = item.Item3;&#xD;&#xA;}&#xD;&#xA;Log(&quot;Red cells shortened to keyword only. Count: &quot; + redCellsToShorten.Count);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Build the band row (ROW 1 ONLY): merged + centered           ----&#xD;&#xA;// ---- A..X = &quot;SAP Data&quot; (light blue), rest = &quot;Validation Status&quot; (light gold) ----&#xD;&#xA;// =====================================================================&#xD;&#xA;int sapLast = Math.Min(SapLastCol, remarkCol);&#xD;&#xA;&#xD;&#xA;dynamic sapRange = sheet.Range[sheet.Cells[BandRow, 1], sheet.Cells[BandRow, sapLast]];&#xD;&#xA;sapRange.Merge();&#xD;&#xA;sapRange.Value2 = &quot;SAP Data&quot;;&#xD;&#xA;sapRange.HorizontalAlignment = -4108; // xlCenter&#xD;&#xA;sapRange.VerticalAlignment = -4108;   // xlCenter&#xD;&#xA;sapRange.Interior.Color = ColorLightBlue;&#xD;&#xA;Log(&quot;Band row: 'SAP Data' merged over columns 1 to &quot; + sapLast + &quot; (light blue).&quot;);&#xD;&#xA;&#xD;&#xA;dynamic validationRange = null;&#xD;&#xA;if (sapLast &lt; remarkCol)&#xD;&#xA;{&#xD;&#xA;    validationRange = sheet.Range[sheet.Cells[BandRow, sapLast + 1], sheet.Cells[BandRow, remarkCol]];&#xD;&#xA;    validationRange.Merge();&#xD;&#xA;    validationRange.Value2 = &quot;Validation Status&quot;;&#xD;&#xA;    validationRange.HorizontalAlignment = -4108; // xlCenter&#xD;&#xA;    validationRange.VerticalAlignment = -4108;   // xlCenter&#xD;&#xA;    validationRange.Interior.Color = ColorValidation;&#xD;&#xA;    Log(&quot;Band row: 'Validation Status' merged over columns &quot; + (sapLast + 1) + &quot; to &quot; + remarkCol + &quot;.&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Define the full data range (band + header + data + Remark) ----&#xD;&#xA;// =====================================================================&#xD;&#xA;dynamic fullRange = sheet.Range[sheet.Cells[BandRow, 1], sheet.Cells[lastRow, remarkCol]];&#xD;&#xA;Log(&quot;Full data range: &quot; + fullRange.Address);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Bold the band row and the header row ----&#xD;&#xA;// =====================================================================&#xD;&#xA;dynamic headerRange = sheet.Range[sheet.Cells[BandRow, 1], sheet.Cells[HeaderRow, remarkCol]];&#xD;&#xA;headerRange.Font.Bold = true;&#xD;&#xA;Log(&quot;Band row and header row set to bold.&quot;);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Add borders to all sides of the full data range ----&#xD;&#xA;// =====================================================================&#xD;&#xA;// xlEdgeLeft=7, xlEdgeTop=8, xlEdgeBottom=9, xlEdgeRight=10, xlInsideVertical=11, xlInsideHorizontal=12&#xD;&#xA;// xlContinuous=1, xlThin=2&#xD;&#xA;int[] borderIndices = new int[] { 7, 8, 9, 10, 11, 12 };&#xD;&#xA;foreach (int idx in borderIndices)&#xD;&#xA;{&#xD;&#xA;    dynamic borderEdge = fullRange.Borders[idx];&#xD;&#xA;    borderEdge.LineStyle = 1;   // xlContinuous&#xD;&#xA;    borderEdge.Weight = 2;      // xlThin&#xD;&#xA;}&#xD;&#xA;Log(&quot;Borders applied to all sides (outside + inside) of the data range.&quot;);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- Autofit column widths (merged band cells are ignored by Excel) ----&#xD;&#xA;// =====================================================================&#xD;&#xA;dynamic allUsedColumns = sheet.Range[sheet.Cells[HeaderRow, 1], sheet.Cells[lastRow, remarkCol]].EntireColumn;&#xD;&#xA;allUsedColumns.AutoFit();&#xD;&#xA;Log(&quot;Column widths auto-fitted for columns 1 to &quot; + remarkCol + &quot;.&quot;);&#xD;&#xA;&#xD;&#xA;// Remark column: fixed width, wrap text so each line shows on its own line&#xD;&#xA;dynamic remarkDataRange = sheet.Range[sheet.Cells[FirstDataRow, remarkCol], sheet.Cells[lastRow, remarkCol]];&#xD;&#xA;remarkDataRange.EntireColumn.ColumnWidth = 80;&#xD;&#xA;remarkDataRange.WrapText = true;&#xD;&#xA;remarkDataRange.VerticalAlignment = -4160; // xlTop&#xD;&#xA;remarkDataRange.EntireRow.AutoFit();&#xD;&#xA;Log(&quot;Remark column formatted (width 80, wrap text).&quot;);&#xD;&#xA;&#xD;&#xA;// =====================================================================&#xD;&#xA;// ---- LAST STEP: add the 3 title rows ABOVE the table on EVERY sheet ----&#xD;&#xA;// ---- Done after the autofit, so these long lines do not widen column A. ----&#xD;&#xA;// ---- Row 1 : Ajanta Pharma Ltd                                    ----&#xD;&#xA;// ---- Row 2 : Andheri                                              ----&#xD;&#xA;// ---- Row 3 : FB-60 Manual Parked Document Verified as on Date: dd-MM-yyyy ----&#xD;&#xA;// ---- All 3 rows are BOLD.                                         ----&#xD;&#xA;// =====================================================================&#xD;&#xA;string processDate = DateTime.Now.ToString(&quot;dd-MM-yyyy&quot;, System.Globalization.CultureInfo.InvariantCulture);&#xD;&#xA;&#xD;&#xA;Action&lt;dynamic&gt; AddTitleRows = (ws) =&gt;&#xD;&#xA;{&#xD;&#xA;    // Re-run safety: if this sheet already starts with the title (e.g. an old sheet&#xD;&#xA;    // that was not rebuilt), remove the old 3 title rows first so they are not doubled.&#xD;&#xA;    object existingTop = ws.Cells[1, 1].Value2;&#xD;&#xA;    string existingTopText = (existingTop != null) ? existingTop.ToString().Trim() : &quot;&quot;;&#xD;&#xA;    if (string.Equals(existingTopText, TitleLine1, StringComparison.OrdinalIgnoreCase))&#xD;&#xA;    {&#xD;&#xA;        ws.Range[&quot;A1:A3&quot;].EntireRow.Delete();&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // Push everything down by 3 rows&#xD;&#xA;    dynamic insRows = ws.Range[&quot;A1:A3&quot;].EntireRow;&#xD;&#xA;    insRows.Insert();&#xD;&#xA;&#xD;&#xA;    // Fresh reference (the old object follows the moved cells) and wipe the&#xD;&#xA;    // formatting the new rows copied from the row below them.&#xD;&#xA;    dynamic tRows = ws.Range[&quot;A1:A3&quot;].EntireRow;&#xD;&#xA;    tRows.ClearContents();&#xD;&#xA;    tRows.ClearFormats();&#xD;&#xA;    tRows.RowHeight = ws.StandardHeight;   // in case the copied row height was tall&#xD;&#xA;&#xD;&#xA;    ws.Cells[1, 1].Value2 = TitleLine1;&#xD;&#xA;    ws.Cells[2, 1].Value2 = TitleLine2;&#xD;&#xA;    ws.Cells[3, 1].Value2 = TitleLine3Prefix + processDate;&#xD;&#xA;&#xD;&#