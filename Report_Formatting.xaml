                      <ui:InvokeCode ContinueOnError="{x:Null}" Code="Action&lt;string&gt; Log = (msg) =&gt;&#xA;{&#xA;    string line = DateTime.Now.ToString(&quot;HH:mm:ss&quot;) + &quot; - &quot; + msg;&#xA;    Console.WriteLine(line);&#xA;};&#xA;&#xA;Log(&quot;Process started.&quot;);&#xA;&#xA;// =====================================================================&#xA;// ---- CONFIG: which columns belong to &quot;SAP Data&quot;? ----&#xA;// ---- Columns 1..SapLastCol  -&gt; &quot;SAP Data&quot; (light blue)           ----&#xA;// ---- All columns after that -&gt; &quot;Validation Status&quot; (incl. Remark) ----&#xA;// ---- Column numbers: A=1, B=2, C=3 ... L=12 ... X=24             ----&#xA;// ---- &gt;&gt;&gt; CHANGE THIS NUMBER to match your sheet &lt;&lt;&lt;              ----&#xA;// =====================================================================&#xA;const int SapLastCol = 24;   // 24 = column X&#xA;&#xA;// =====================================================================&#xA;// ---- Guard: does the file even exist? ----&#xA;// =====================================================================&#xA;Action&lt;string&gt; CheckFileExists = (path) =&gt;&#xA;{&#xA;    Log(&quot;Checking file path: &quot; + path);&#xA;&#xA;    if (!System.IO.File.Exists(path))&#xA;    {&#xA;        string dir = System.IO.Path.GetDirectoryName(path);&#xA;        string nameOnly = System.IO.Path.GetFileNameWithoutExtension(path);&#xA;&#xA;        Log(&quot;ERROR: File does not exist at exact path: &quot; + path);&#xA;&#xA;        if (System.IO.Directory.Exists(dir))&#xA;        {&#xA;            var matches = System.IO.Directory.GetFiles(dir, nameOnly + &quot;.*&quot;);&#xA;            if (matches.Length &gt; 0)&#xA;                Log(&quot;HINT: Found a file with the same name but different extension: &quot; + matches[0]);&#xA;            else&#xA;                Log(&quot;HINT: No file starting with '&quot; + nameOnly + &quot;' found in folder: &quot; + dir);&#xA;        }&#xA;        else&#xA;        {&#xA;            Log(&quot;HINT: The folder itself doesn't exist: &quot; + dir);&#xA;        }&#xA;&#xA;        throw new Exception(&quot;File not found: '&quot; + path + &quot;'. Check filename/extension — see log for hints.&quot;);&#xA;    }&#xA;};&#xA;&#xA;// ---- Guard: fail early if the file is already open elsewhere ----&#xA;Action&lt;string&gt; CheckFileLock = (path) =&gt;&#xA;{&#xA;    try&#xA;    {&#xA;        System.IO.FileStream fs = System.IO.File.Open(path, System.IO.FileMode.Open, System.IO.FileAccess.ReadWrite, System.IO.FileShare.None);&#xA;        fs.Close();&#xA;        Log(&quot;File is accessible and not locked by another process: &quot; + path);&#xA;    }&#xA;    catch (System.IO.IOException ex)&#xA;    {&#xA;        Log(&quot;ERROR (&quot; + ex.GetType().Name + &quot;): &quot; + ex.Message + &quot; | Path checked: &quot; + path);&#xA;        throw new Exception(&quot;File '&quot; + path + &quot;' is locked: &quot; + ex.Message);&#xA;    }&#xA;    catch (UnauthorizedAccessException ex)&#xA;    {&#xA;        Log(&quot;ERROR (UnauthorizedAccessException): &quot; + ex.Message + &quot; | Path checked: &quot; + path);&#xA;        throw new Exception(&quot;Access denied to file '&quot; + path + &quot;': &quot; + ex.Message);&#xA;    }&#xA;};&#xA;&#xA;CheckFileExists(in_FilePath);&#xA;CheckFileLock(in_FilePath);&#xA;&#xA;// =====================================================================&#xA;// ---- Launch Excel ----&#xA;// =====================================================================&#xA;dynamic excelApp = Activator.CreateInstance(Type.GetTypeFromProgID(&quot;Excel.Application&quot;));&#xA;excelApp.Visible = false;&#xA;excelApp.DisplayAlerts = false;&#xA;Log(&quot;Excel application launched.&quot;);&#xA;&#xA;dynamic wb = excelApp.Workbooks.Open(in_FilePath);&#xA;Log(&quot;Opened file: &quot; + in_FilePath);&#xA;&#xA;dynamic sheet = wb.Sheets[1];&#xA;Log(&quot;Using sheet: &quot; + sheet.Name);&#xA;&#xA;// =====================================================================&#xA;// ---- Make room for the &quot;SAP Data / Validation Status&quot; band row (row 1) ----&#xA;// ---- First run : insert a new row at the top, header moves to row 2 ----&#xA;// ---- Re-run    : band row already exists, just un-merge and reuse it ----&#xA;// =====================================================================&#xA;string a1Text = (sheet.Cells[1, 1].Value2 != null) ? sheet.Cells[1, 1].Value2.ToString().Trim() : &quot;&quot;;&#xA;bool bandRowExists = string.Equals(a1Text, &quot;SAP Data&quot;, StringComparison.OrdinalIgnoreCase)&#xA;                  || string.Equals(a1Text, &quot;Validation Status&quot;, StringComparison.OrdinalIgnoreCase);&#xA;&#xA;dynamic bandRowBeforeInsert = sheet.Range[sheet.Cells[1, 1], sheet.Cells[1, 1]].EntireRow;&#xA;&#xA;if (bandRowExists)&#xA;{&#xA;    bandRowBeforeInsert.UnMerge();&#xA;    Log(&quot;Existing band row found in row 1 - it will be rebuilt.&quot;);&#xA;}&#xA;else&#xA;{&#xA;    bandRowBeforeInsert.Insert(); // shifts everything down by one row&#xA;    Log(&quot;New band row inserted at row 1.&quot;);&#xA;}&#xA;// IMPORTANT: after Insert(), the old range object follows the moved cells (it now&#xA;// points at the header row, which is row 2). Take a FRESH reference to row 1&#xA;// before clearing, otherwise the header row would be wiped.&#xA;dynamic bandRowEntire = sheet.Range[sheet.Cells[1, 1], sheet.Cells[1, 1]].EntireRow;&#xA;bandRowEntire.ClearContents();&#xA;bandRowEntire.ClearFormats();&#xA;&#xA;const int BandRow   = 1;   // &quot;SAP Data&quot; / &quot;Validation Status&quot;&#xA;const int HeaderRow = 2;   // column headers&#xA;const int FirstDataRow = 3;&#xA;&#xA;// =====================================================================&#xA;// ---- Find used range (last row / last column) ----&#xA;// =====================================================================&#xA;dynamic lastCellRow = sheet.Cells[sheet.Rows.Count, 1];&#xA;int lastRow = (int)lastCellRow.End(-4162).Row; // xlUp&#xA;&#xA;dynamic lastCellCol = sheet.Cells[HeaderRow, sheet.Columns.Count];&#xA;int lastCol = (int)lastCellCol.End(-4159).Column; // xlToLeft&#xA;&#xA;Log(&quot;Sheet has &quot; + lastRow + &quot; rows (incl. band + header) and &quot; + lastCol + &quot; columns.&quot;);&#xA;&#xA;if (lastRow &lt; FirstDataRow || lastCol &lt; 1)&#xA;    throw new Exception(&quot;Sheet has no data rows — nothing to format.&quot;);&#xA;&#xA;// =====================================================================&#xA;// ---- Decide where the &quot;Remark&quot; column goes ----&#xA;// ---- If the file was already processed (last header is &quot;Remark&quot;), ----&#xA;// ---- reuse that column instead of adding a second one.           ----&#xA;// =====================================================================&#xA;const string RemarkHeader = &quot;Remark&quot;;&#xA;&#xA;string lastHeaderText = (sheet.Cells[HeaderRow, lastCol].Value2 != null) ? sheet.Cells[HeaderRow, lastCol].Value2.ToString().Trim() : &quot;&quot;;&#xA;&#xA;int dataLastCol;   // last column that holds real data (excludes Remark)&#xA;int remarkCol;     // column where Remark is written&#xA;&#xA;if (string.Equals(lastHeaderText, RemarkHeader, StringComparison.OrdinalIgnoreCase))&#xA;{&#xA;    remarkCol = lastCol;&#xA;    dataLastCol = lastCol - 1;&#xA;    Log(&quot;Existing 'Remark' column found at col &quot; + remarkCol + &quot; - it will be overwritten.&quot;);&#xA;}&#xA;else&#xA;{&#xA;    dataLastCol = lastCol;&#xA;    remarkCol = lastCol + 1;&#xA;    Log(&quot;'Remark' column will be added at col &quot; + remarkCol + &quot;.&quot;);&#xA;}&#xA;&#xA;// =====================================================================&#xA;// ---- Red / Green status highlighting based on column header ----&#xA;// ---- (negative keyword -&gt; Red, everything else -&gt; Green)        ----&#xA;// =====================================================================&#xA;// Excel Color values are computed as R + (G*256) + (B*65536)&#xA;// Faint/pastel shades (Excel's standard &quot;Bad&quot;/&quot;Good&quot; conditional-format colors)&#xA;int ColorRed   = 13551615; // RGB(255, 199, 206) -- faint red&#xA;int ColorGreen = 13561798; // RGB(198, 239, 206) -- faint green&#xA;int ColorLightBlue = 15652797; // RGB(189, 215, 238) -- light blue for &quot;SAP Data&quot;&#xA;int ColorValidation = 10086143; // RGB(255, 230, 153) -- light gold for &quot;Validation Status&quot;&#xA;&#xA;// Negative keyword(s) per column header. A cell is treated as NEGATIVE (red)&#xA;// when its text STARTS WITH any listed keyword (case-insensitive), e.g.&#xA;//   &quot;Unmatched&quot;&#xA;//   &quot;UnmatchedTrinity Synergy 154, ...||Trinity Packaging Co Pvt Ltd.&quot;&#xA;// Anything else that is non-blank is treated as positive (green).&#xA;Dictionary&lt;string, string[]&gt; negativeValuesByHeader = new Dictionary&lt;string, string[]&gt;(StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    { &quot;Posting Status&quot;,                      new [] { &quot;Not Posted&quot; } },&#xA;    { &quot;Email attachment Status&quot;,             new [] { &quot;Email Not attached&quot; } },&#xA;    { &quot;Invoice attachment Status&quot;,           new [] { &quot;Invoice not attached&quot;, &quot;Unmatched&quot; } },&#xA;    { &quot;Vendor Name Status&quot;,                  new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Vendor Address&quot;,                      new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Ajanta GSTIN&quot;,                        new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Invoice Number/GSTN Bill No.&quot;,        new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Invoice Date&quot;,                        new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Currency&quot;,                            new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Bus Place/Sectn.&quot;,                    new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Bank Details&quot;,                        new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Net Amount&quot;,                          new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Tax Amount CGST+SGST/IGST&quot;,           new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Invoice Amount&quot;,                      new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;TDS Code Status&quot;,                     new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Payment Block Status&quot;,                new [] { &quot;Block&quot; } },&#xA;    { &quot;Document Number Status&quot;,              new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Approved By status&quot;,                  new [] { &quot;Unmatched&quot; } },&#xA;    { &quot;Delay Bill submission Status&quot;,        new [] { &quot;Delay&quot; } },&#xA;    { &quot;Text (Document Header)&quot;,              new [] { &quot;Text Not Available&quot; } },&#xA;    { &quot;Text GL&quot;,                             new [] { &quot;Text Not Available&quot; } },&#xA;    { &quot;Payment TDS (WHT) Status&quot;,            new [] { &quot;Not Selected&quot; } },&#xA;    { &quot;BL Copy Status&quot;,                      new [] { &quot;Not Attached&quot; } },&#xA;    { &quot;BL Number &amp; Shipper Name&quot;,            new [] { &quot;Unmatched&quot; } },&#xA;};&#xA;&#xA;// Columns that should simply be filled green for every populated cell,&#xA;// with no red/negative condition at all.&#xA;HashSet&lt;string&gt; alwaysGreenHeaders = new HashSet&lt;string&gt;(StringComparer.OrdinalIgnoreCase)&#xA;{&#xA;    &quot;Profit Center Status&quot;,&#xA;};&#xA;&#xA;// One list per row: collects &quot;ColumnName: value&quot; for every red cell in that row.&#xA;List&lt;string&gt;[] rowRemarks = new List&lt;string&gt;[lastRow + 1];&#xA;for (int r = FirstDataRow; r &lt;= lastRow; r++)&#xA;    rowRemarks[r] = new List&lt;string&gt;();&#xA;&#xA;for (int col = 1; col &lt;= dataLastCol; col++)&#xA;{&#xA;    dynamic headerCell = sheet.Cells[HeaderRow, col];&#xA;    string headerText = (headerCell.Value2 != null) ? headerCell.Value2.ToString().Trim() : &quot;&quot;;&#xA;&#xA;    string[] negativeValues;&#xA;    bool isKnownStatusColumn = negativeValuesByHeader.TryGetValue(headerText, out negativeValues);&#xA;    bool isAlwaysGreenColumn = alwaysGreenHeaders.Contains(headerText);&#xA;&#xA;    if (!isKnownStatusColumn &amp;&amp; !isAlwaysGreenColumn)&#xA;    {&#xA;        // Column header not in the known status list — skip coloring it.&#xA;        continue;&#xA;    }&#xA;&#xA;    for (int row = FirstDataRow; row &lt;= lastRow; row++)&#xA;    {&#xA;        dynamic dataCell = sheet.Cells[row, col];&#xA;        string cellText = (dataCell.Value2 != null) ? dataCell.Value2.ToString().Trim() : &quot;&quot;;&#xA;&#xA;        if (cellText.Length == 0)&#xA;            continue; // leave blanks unformatted&#xA;&#xA;        if (isAlwaysGreenColumn)&#xA;        {&#xA;            dataCell.Interior.Color = ColorGreen;&#xA;            continue;&#xA;        }&#xA;&#xA;        bool isNegative = false;&#xA;        foreach (string negVal in negativeValues)&#xA;        {&#xA;            // StartsWith: catches &quot;Unmatched&quot; AND &quot;UnmatchedTrinity Synergy 154, ...&quot;&#xA;            if (cellText.StartsWith(negVal, StringComparison.OrdinalIgnoreCase))&#xA;            {&#xA;                isNegative = true;&#xA;                break;&#xA;            }&#xA;        }&#xA;&#xA;        dataCell.Interior.Color = isNegative ? ColorRed : ColorGreen;&#xA;&#xA;        // Remember this red cell for the Remark column&#xA;        if (isNegative)&#xA;            rowRemarks[row].Add(headerText + &quot;: &quot; + cellText);&#xA;    }&#xA;&#xA;    Log(&quot;Applied highlighting to column '&quot; + headerText + &quot;' (col &quot; + col + &quot;).&quot;);&#xA;}&#xA;&#xA;// =====================================================================&#xA;// ---- Write the &quot;Remark&quot; column ----&#xA;// ---- Format (one numbered point per red cell, one per line):     ----&#xA;// ----   1. Vendor Name Status: Unmatched                          ----&#xA;// ----   2. Invoice attachment Status: Invoice not attached        ----&#xA;// =====================================================================&#xA;sheet.Cells[HeaderRow, remarkCol].Value2 = RemarkHeader;&#xA;&#xA;int rowsWithRemark = 0;&#xA;for (int row = FirstDataRow; row &lt;= lastRow; row++)&#xA;{&#xA;    dynamic remarkCell = sheet.Cells[row, remarkCol];&#xA;    List&lt;string&gt; points = rowRemarks[row];&#xA;&#xA;    if (points.Count == 0)&#xA;    {&#xA;        remarkCell.Value2 = null; // clear any old remark (useful on re-runs)&#xA;        continue;&#xA;    }&#xA;&#xA;    List&lt;string&gt; numbered = new List&lt;string&gt;();&#xA;    for (int i = 0; i &lt; points.Count; i++)&#xA;        numbered.Add((i + 1) + &quot;. &quot; + points[i]);&#xA;&#xA;    remarkCell.Value2 = string.Join(&quot;\n&quot;, numbered);&#xA;    rowsWithRemark++;&#xA;}&#xA;Log(&quot;Remark column written. Rows with at least one red cell: &quot; + rowsWithRemark);&#xA;&#xA;// =====================================================================&#xA;// ---- Build the band row (ROW 1 ONLY): merged + centered           ----&#xA;// ---- A..X = &quot;SAP Data&quot; (light blue), rest = &quot;Validation Status&quot; (light gold) ----&#xA;// =====================================================================&#xA;int sapLast = Math.Min(SapLastCol, remarkCol);&#xA;&#xA;dynamic sapRange = sheet.Range[sheet.Cells[BandRow, 1], sheet.Cells[BandRow, sapLast]];&#xA;sapRange.Merge();&#xA;sapRange.Value2 = &quot;SAP Data&quot;;&#xA;sapRange.HorizontalAlignment = -4108; // xlCenter&#xA;sapRange.VerticalAlignment = -4108;   // xlCenter&#xA;sapRange.Interior.Color = ColorLightBlue;&#xA;Log(&quot;Band row: 'SAP Data' merged over columns 1 to &quot; + sapLast + &quot; (light blue).&quot;);&#xA;&#xA;dynamic validationRange = null;&#xA;if (sapLast &lt; remarkCol)&#xA;{&#xA;    validationRange = sheet.Range[sheet.Cells[BandRow, sapLast + 1], sheet.Cells[BandRow, remarkCol]];&#xA;    validationRange.Merge();&#xA;    validationRange.Value2 = &quot;Validation Status&quot;;&#xA;    validationRange.HorizontalAlignment = -4108; // xlCenter&#xA;    validationRange.VerticalAlignment = -4108;   // xlCenter&#xA;    validationRange.Interior.Color = ColorValidation;&#xA;    Log(&quot;Band row: 'Validation Status' merged over columns &quot; + (sapLast + 1) + &quot; to &quot; + remarkCol + &quot;.&quot;);&#xA;}&#xA;&#xA;// =====================================================================&#xA;// ---- Define the full data range (band + header + data + Remark) ----&#xA;// =====================================================================&#xA;dynamic fullRange = sheet.Range[sheet.Cells[BandRow, 1], sheet.Cells[lastRow, remarkCol]];&#xA;Log(&quot;Full data range: &quot; + fullRange.Address);&#xA;&#xA;// =====================================================================&#xA;// ---- Bold the band row and the header row ----&#xA;// =====================================================================&#xA;dynamic headerRange = sheet.Range[sheet.Cells[BandRow, 1], sheet.Cells[HeaderRow, remarkCol]];&#xA;headerRange.Font.Bold = true;&#xA;Log(&quot;Band row and header row set to bold.&quot;);&#xA;&#xA;// =====================================================================&#xA;// ---- Add borders to all sides of the full data range ----&#xA;// =====================================================================&#xA;// xlEdgeLeft=7, xlEdgeTop=8, xlEdgeBottom=9, xlEdgeRight=10, xlInsideVertical=11, xlInsideHorizontal=12&#xA;// xlContinuous=1, xlThin=2&#xA;int[] borderIndices = new int[] { 7, 8, 9, 10, 11, 12 };&#xA;foreach (int idx in borderIndices)&#xA;{&#xA;    dynamic borderEdge = fullRange.Borders[idx];&#xA;    borderEdge.LineStyle = 1;   // xlContinuous&#xA;    borderEdge.Weight = 2;      // xlThin&#xA;}&#xA;Log(&quot;Borders applied to all sides (outside + inside) of the data range.&quot;);&#xA;&#xA;// =====================================================================&#xA;// ---- Autofit column widths (merged band cells are ignored by Excel) ----&#xA;// =====================================================================&#xA;dynamic allUsedColumns = sheet.Range[sheet.Cells[HeaderRow, 1], sheet.Cells[lastRow, remarkCol]].EntireColumn;&#xA;allUsedColumns.AutoFit();&#xA;Log(&quot;Column widths auto-fitted for columns 1 to &quot; + remarkCol + &quot;.&quot;);&#xA;&#xA;// Remark column: fixed width, wrap text so each numbered point shows on its own line&#xA;dynamic remarkDataRange = sheet.Range[sheet.Cells[FirstDataRow, remarkCol], sheet.Cells[lastRow, remarkCol]];&#xA;remarkDataRange.EntireColumn.ColumnWidth = 80;&#xA;remarkDataRange.WrapText = true;&#xA;remarkDataRange.VerticalAlignment = -4160; // xlTop&#xA;remarkDataRange.EntireRow.AutoFit();&#xA;Log(&quot;Remark column formatted (width 80, wrap text).&quot;);&#xA;&#xA;// =====================================================================&#xA;// ---- Save file ----&#xA;// =====================================================================&#xA;try&#xA;{&#xA;    wb.Save();&#xA;    Log(&quot;File saved: &quot; + in_FilePath);&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    Log(&quot;ERROR during Save: &quot; + ex.Message);&#xA;    if (ex.InnerException != null)&#xA;        Log(&quot;Inner exception: &quot; + ex.InnerException.Message);&#xA;    throw;&#xA;}&#xA;&#xA;// =====================================================================&#xA;// ---- Cleanup ----&#xA;// =====================================================================&#xA;wb.Close(false);&#xA;excelApp.Quit();&#xA;Log(&quot;Workbook closed, Excel quit.&quot;);&#xA;&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(remarkDataRange);&#xA;if (validationRange != null) System.Runtime.InteropServices.Marshal.ReleaseComObject(validationRange);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(sapRange);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(bandRowEntire);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(bandRowBeforeInsert);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(headerRange);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(fullRange);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(allUsedColumns);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(sheet);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(wb);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(excelApp);&#xA;&#xA;Log(&quot;Process completed successfully.&quot;);" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="416,188" sap2010:WorkflowViewState.IdRef="InvokeCode_2" Language="CSharp">
                        <ui:InvokeCode.Arguments>
                          <InArgument x:TypeArguments="x:String" x:Key="in_FilePath">[in_OutputFilePath]</InArgument>
                        </ui:InvokeCode.Arguments>
                      </ui:InvokeCode>
                    </Sequence>
                  </ui:CommentOut.Body>
                  <sap:WorkflowViewStateService.ViewState>
                    <scg:Dictionary x:TypeArguments="x:String, x:Object">
                      <x:Boolean x:Key="IsExpanded">False</x:Boolean>
                      <x:Boolean x:Key="IsPinned">False</x:Boolean>
                    </scg:Dictionary>
                  </sap:WorkflowViewStateService.ViewState>
