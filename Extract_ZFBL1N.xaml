lse&#xA;{&#xA;    Log(&quot;No data rows found — out_ColumnText will be empty.&quot;);&#xA;}&#xA;&#xA;// ---- Flag: true if there is real text, false if null/empty/whitespace ----&#xA;out_HasText = !string.IsNullOrWhiteSpace(out_ColumnText);&#xA;Log(&quot;out_HasText = &quot; + out_HasText);&#xA;&#xA;// ---- Cleanup ----&#xA;wb.Close(false);&#xA;excelApp.Quit();&#xA;Log(&quot;Workbook closed, Excel quit.&quot;);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(mainSheet);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(wb);&#xA;System.Runtime.InteropServices.Marshal.ReleaseComObject(excelApp);&#xA;Log(&quot;Process completed successfully.&quot;);" DisplayName="Code to Copy the Vendor code " sap:VirtualizedContainerService.HintSize="452,197" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp">
