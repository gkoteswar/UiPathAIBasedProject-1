                    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Action&lt;string&gt; Log = (msg) =&gt;&#xA;{&#xA;    string line = DateTime.Now.ToString(&quot;HH:mm:ss&quot;) + &quot; - &quot; + msg;&#xA;    Console.WriteLine(line);&#xA;};&#xA;&#xA;Log(&quot;Process started.&quot;);&#xA;out_RowCount = 0;&#xA;out_HasText = false;&#xA;&#xA;// ---- Guard: fail early if the file is already open elsewhere ----&#xA;Log(&quot;Checking file path: &quot; + in_FilePath);&#xA;&#xA;if (!System.IO.File.Exists(in_FilePath))&#xA;{&#xA;    Log(&quot;ERROR: File does not exist at path: &quot; + in_FilePath);&#xA;    throw new Exception(&quot;File not found: '&quot; + in_FilePath + &quot;'. Check that the path is correct and the file hasn't been moved or renamed.&quot;);&#xA;}&#xA;&#xA;try&#xA;{&#xA;    System.IO.FileStream fs = System.IO.File.Open(in_FilePath, System.IO.FileMode.Open, System.IO.FileAccess.ReadWrite, System.IO.FileShare.None);&#xA;    fs.Close();&#xA;    Log(&quot;File is accessible and not locked by another process.&quot;);&#xA;}&#xA;catch (System.IO.IOException ex)&#xA;{&#xA;    Log(&quot;ERROR (&quot; + ex.GetType().Name + &quot;): &quot; + ex.Message + &quot; | Path checked: &quot; + in_FilePath);&#xA;    throw new Exception(&quot;File '&quot; + in_FilePath + &quot;' check failed: &quot; + ex.Message);&#xA;}&#xA;catch (UnauthorizedAccessException ex)&#xA;{&#xA;    Log(&quot;ERROR (UnauthorizedAccessException): &quot; + ex.Message + &quot; | Path checked: &quot; + in_FilePath);&#xA;    throw new Exception(&quot;Access denied to file '&quot; + in_FilePath + &quot;': &quot; + ex.Message);&#xA;}&#xA;&#xA;dynamic excelApp = Activator.CreateInstance(Type.GetTypeFromProgID(&quot;Excel.Application&quot;));&#xA;excelApp.Visible = false;&#xA;excelApp.DisplayAlerts = false;&#xA;Log(&quot;Excel application launched.&quot;);&#xA;&#xA;dynamic wb = excelApp.Workbooks.Open(in_FilePath);&#xA;Log(&quot;Opened file: &quot; + in_FilePath);&#xA;&#xA;dynamic mainSheet = null;&#xA;if (string.IsNullOrWhiteSpace(in_SheetName))&#xA;{&#xA;    mainSheet = wb.Sheets[1];&#xA;    Log(&quot;No sheet name provided — using first sheet: &quot; + mainSheet.Name);&#xA;}&#xA;else&#xA;{&#xA;    foreach (dynamic sh in wb.Sheets)&#xA;    {&#xA;        if (string.Equals((string)sh.Name, in_SheetName.Trim(), StringComparison.OrdinalIgnoreCase))&#xA;        {&#xA;            mainSheet = sh;&#xA;            break;&#xA;        }&#xA;    }&#xA;    if (mainSheet == null)&#xA;    {&#xA;        Log(&quot;ERROR: Sheet '&quot; + in_SheetName + &quot;' not found.&quot;);&#xA;        throw new Exception(&quot;Sheet '&quot; + in_SheetName + &quot;' not found in workbook.&quot;);&#xA;    }&#xA;    Log(&quot;Using sheet: &quot; + mainSheet.Name);&#xA;}&#xA;&#xA;// ---- Read sheet structure ----&#xA;dynamic lastCell = mainSheet.Cells[mainSheet.Rows.Count, 1];&#xA;int lastRow = (int)lastCell.End(-4162).Row;&#xA;dynamic lastColCell = mainSheet.Cells[1, mainSheet.Columns.Count];&#xA;int lastCol = (int)lastColCell.End(-4159).Column;&#xA;Log(&quot;Sheet: &quot; + lastRow + &quot; rows, &quot; + lastCol + &quot; columns.&quot;);&#xA;&#xA;// ---- Find target column by header name ----&#xA;dynamic headerRange = mainSheet.Range[mainSheet.Cells[1, 1], mainSheet.Cells[1, lastCol]];&#xA;object[,] headers = headerRange.Value2;&#xA;int targetCol = -1;&#xA;for (int c = 1; c &lt;= lastCol; c++)&#xA;{&#xA;    string header = headers[1, c] != null ? headers[1, c].ToString().Trim() : &quot;&quot;;&#xA;    if (string.Equals(header, in_ColumnName, StringComparison.OrdinalIgnoreCase))&#xA;        targetCol = c;&#xA;}&#xA;if (targetCol == -1)&#xA;{&#xA;    Log(&quot;ERROR: Column '&quot; + in_ColumnName + &quot;' not found.&quot;);&#xA;    throw new Exception(&quot;Column '&quot; + in_ColumnName + &quot;' not found in sheet.&quot;);&#xA;}&#xA;Log(&quot;Found column '&quot; + in_ColumnName + &quot;' at position &quot; + targetCol + &quot;.&quot;);&#xA;&#xA;// ---- Row count (data rows only, excluding